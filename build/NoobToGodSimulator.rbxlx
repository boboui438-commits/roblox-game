-- ============================================================
-- CONSTRUCTION D'UN MONDE
-- ============================================================
local function buildWorld(index: number): any
	local world = GameConfig.Worlds[index]
	local center = Vector3.new(0, 0, index * WorldFactory.WORLD_SPACING)
	local size = WorldFactory.WORLD_PLATFORM_SIZE

	local folder = Instance.new("Folder")
	folder.Name = "World" .. tostring(index)

	-- Plateforme
	local platform = part(folder, {
		Name = "Platform",
		Size = Vector3.new(size, 4, size),
		Position = center + Vector3.new(0, -2, 0),
		Color = world.FloorColor,
		Material = world.FloorMaterial,
	})
	platform:SetAttribute("Permanent", true)
	platform:SetAttribute("WorldIndex", index)

	-- Bordure lumineuse + murs invisibles (anti-chute)
	neon(folder, {
		Name = "Rim",
		Size = Vector3.new(size + 8, 1, size + 8),
		Position = center + Vector3.new(0, 0.2, 0),
		Color = world.DecorColor,
		Transparency = 0.6,
	})

	local wallHeight = 90
	for _, offset in ipairs({
		{ Vector3.new(0, wallHeight / 2, -size / 2), Vector3.new(size, wallHeight, 2) },
		{ Vector3.new(0, wallHeight / 2, size / 2), Vector3.new(size, wallHeight, 2) },
		{ Vector3.new(-size / 2, wallHeight / 2, 0), Vector3.new(2, wallHeight, size) },
		{ Vector3.new(size / 2, wallHeight / 2, 0), Vector3.new(2, wallHeight, size) },
	}) do
		part(folder, {
			Name = "InvisibleWall",
			Size = offset[2],
			Position = center + offset[1],
			Transparency = 1,
			CanCollide = true,
			CastShadow = false,
			Material = Enum.Material.SmoothPlastic,
		})
	end

	-- Zone d'arrivée + portail de retour
	local spawnPosition = center + Vector3.new(0, 6, size / 2 - 70)
	local returnPad = neon(folder, {
		Name = "ReturnPad",
		Size = Vector3.new(36, 1, 36),
		Position = spawnPosition - Vector3.new(0, 5.5, 0),
		Color = Color3.fromRGB(255, 120, 190),
		Transparency = 0.2,
	})
	returnPad:SetAttribute("ReturnPad", true)
	label(returnPad, "← LOBBY", Color3.fromRGB(255, 255, 255), Vector2.new(240, 60))

	local returnModel = Instance.new("Model")
	returnModel.Name = "ReturnPortal"
	returnModel.Parent = folder
	local returnField = neon(returnModel, {
		Name = "Field",
		Size = Vector3.new(20, 26, 1),
		Position = spawnPosition + Vector3.new(0, 10, 26),
		Color = Color3.fromRGB(255, 120, 190),
		Transparency = 0.5,
	})
	returnField:SetAttribute("Animated", "portal")
	returnField:SetAttribute("ReturnPortal", true)
	label(returnField, "RETOUR AU LOBBY", Color3.fromRGB(255, 255, 255), Vector2.new(280, 60))

	-- Piédestal de l'œuf du monde
	local eggId = world.Egg
	if eggId and GameConfig.Eggs[eggId] then
		local eggModel = Instance.new("Model")
		eggModel.Name = "EggPedestal_" .. eggId
		eggModel:SetAttribute("EggId", eggId)
		eggModel.Parent = folder

		local eggPosition = center + Vector3.new(0, 0, -60)
		part(eggModel, {
			Name = "Base",
			Size = Vector3.new(20, 2, 20),
			Position = eggPosition + Vector3.new(0, 1, 0),
			Color = Color3.fromRGB(255, 255, 255),
			Material = Enum.Material.Marble,
		})
		local eggPart = neon(eggModel, {
			Name = "Egg",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(11, 14, 11),
			Position = eggPosition + Vector3.new(0, 10, 0),
			Color = GameConfig.Eggs[eggId].Color,
			Transparency = 0.1,
		})
		eggPart:SetAttribute("Animated", "float")

		local eggLight = Instance.new("PointLight")
		eggLight.Brightness = 3
		eggLight.Range = 40
		eggLight.Color = GameConfig.Eggs[eggId].Color
		eggLight.Parent = eggPart

		label(eggPart, GameConfig.Eggs[eggId].Emoji .. " " .. string.upper(GameConfig.Eggs[eggId].Name), Color3.fromRGB(255, 255, 255), Vector2.new(340, 70))
	end

	-- Décor spécifique au monde
	local decorBuilder = decorBuilders[index]
	if decorBuilder then
		local ok, err = pcall(decorBuilder, folder, center, world)
		if not ok then
			warn("[WorldFactory] décor du monde " .. index .. " : " .. tostring(err))
		end
	end

	folder.Parent = Workspace

	local info = {
		Index = index,
		Folder = folder,
		Center = center,
		Platform = platform,
		SpawnPosition = spawnPosition,
		ReturnPortalPosition = returnField.Position,
		-- Zone de spawn des objets à absorber
		SpawnArea = {
			MinX = center.X - 300,
			MaxX = center.X + 300,
			MinZ = center.Z - 300,
			MaxZ = center.Z + 300,
			MinY = 4,
			MaxY = 42,
		},
	}
	worldInfos[index] = info
	return info
end

-- ============================================================
-- API PUBLIQUE
-- ============================================================
function WorldFactory.getWorldInfo(index: number)
	return worldInfos[index]
end

function WorldFactory.getWorldPosition(index: number): Vector3
	local info = worldInfos[index]
	return info and info.SpawnPosition or WorldFactory.LOBBY_SPAWN
end

function WorldFactory.getLobbySpawn(): Vector3
	return WorldFactory.LOBBY_SPAWN
end

function WorldFactory.getLobby()
	return Workspace:FindFirstChild("Lobby")
end

--- Construit tout. Idempotent : si la map existe déjà, on la reconstruit.
function WorldFactory.buildAll()
	local existingLobby = Workspace:FindFirstChild("Lobby")
	if existingLobby then
		existingLobby:Destroy()
	end
	local existingWorlds = Workspace:FindFirstChild("Worlds")
	if existingWorlds then
		existingWorlds:Destroy()
	end
	-- nettoyage des collectibles d'une session précédente (Studio)
	local existingCollectibles = Workspace:FindFirstChild("Collectibles")
	if existingCollectibles then
		existingCollectibles:Destroy()
	end
	-- Filet de sécurité placé dans le .rbxlx : inutile une fois la map générée
	local fallback = Workspace:FindFirstChild("Fallback")
	if fallback then
		fallback:Destroy()
	end

	local startClock = os.clock()

	buildLobby()

	local worldsFolder = Instance.new("Folder")
	worldsFolder.Name = "Worlds"
	worldsFolder.Parent = Workspace

	for index = 1, #GameConfig.Worlds do
		local info = buildWorld(index)
		info.Folder.Parent = worldsFolder
	end

	-- Dossier des objets à absorber (rempli par CollectSystem)
	local collectibles = Instance.new("Folder")
	collectibles.Name = "Collectibles"
	collectibles.Parent = Workspace

	-- Réglages globaux du monde
	Workspace.Gravity = 196.2
	Workspace.FallenPartsDestroyHeight = -300
	Lighting.ClockTime = 14
	Lighting.Brightness = 2.5
	Lighting.EnvironmentDiffuseScale = 0.4
	Lighting.EnvironmentSpecularScale = 0.4
	Lighting.GlobalShadows = true
	Lighting.Ambient = Color3.fromRGB(120, 130, 150)
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 150, 170)

	local success, atmosphere = pcall(function()
		local existing = Lighting:FindFirstChildOfClass("Atmosphere")
		if existing then
			existing:Destroy()
		end
		local newAtmosphere = Instance.new("Atmosphere")
		newAtmosphere.Density = 0.32
		newAtmosphere.Offset = 0.1
		newAtmosphere.Color = Color3.fromRGB(200, 220, 255)
		newAtmosphere.Decay = Color3.fromRGB(120, 150, 200)
		newAtmosphere.Glare = 0.2
		newAtmosphere.Haze = 1.4
		newAtmosphere.Parent = Lighting
		return newAtmosphere
	end)
	if not success then
		warn("[WorldFactory] Atmosphere : " .. tostring(atmosphere))
	end

	print(string.format("[WorldFactory] Map générée en %.2fs (%d mondes + lobby)", os.clock() - startClock, #GameConfig.Worlds))
	return worldInfos
end

return WorldFactory
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item><Item class="ModuleScript" referent="RBX0021">
        <Properties>
          <string name="Name">WorldManager</string>
          <ProtectedString name="Source">--!strict
--[[
	WorldManager  |  ServerScriptService.Systems.WorldManager
	------------------------------------------------------------------
	  • Téléportation entre le lobby et les 6 mondes (validée serveur)
	  • Déblocage automatique des mondes (puissance + rebirths)
	  • Gestion des portails (Touched) et du pad de retour
	  • Compteur de joueurs par monde (utilisé par CollectSystem pour
	    n'activer les objets que dans les mondes occupés)
	  • Vérifie en boucle qu'un joueur n'a pas besoin d'être replacé.
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local Net = require(Modules:WaitForChild("Net"))
local Signal = require(Modules:WaitForChild("Signal"))

local DataManager = require(script.Parent.DataManager)
local WorldFactory = require(script.Parent.WorldFactory)
local CollectSystem = require(script.Parent.CollectSystem)

local WorldManager = {}

WorldManager.Events = {
	WorldChanged = Signal.new(), -- (player, worldIndex)
	WorldUnlocked = Signal.new(), -- (player, worldIndex)
}

local lastTravel: { [Player]: number } = {}
local portalDebounce: { [Player]: number } = {}
local occupancy: { [number]: number } = {}
local firstJoinDone: { [Player]: boolean } = {}

-- ============================================================
-- OCCUPATION
-- ============================================================
local function updateOccupancy(profile, delta: number, worldIndex: number?)
	local index = worldIndex or (profile and profile.world) or 0
	occupancy[index] = math.max(0, (occupancy[index] or 0) + delta)
	CollectSystem.worldOccupancy = occupancy
end

local function recomputeOccupancy()
	occupancy = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local profile = DataManager.getProfile(player)
		if profile then
			occupancy[profile.world] = (occupancy[profile.world] or 0) + 1
		end
	end
	CollectSystem.worldOccupancy = occupancy
end

function WorldManager.getOccupancy()
	return occupancy
end

-- ============================================================
-- PLACEMENT DU PERSONNAGE
-- ============================================================
local function getSpawnPosition(worldIndex: number): Vector3
	if worldIndex &lt;= 0 then
		return WorldFactory.getLobbySpawn()
	end
	return WorldFactory.getWorldPosition(worldIndex)
end

local function placeCharacter(player: Player, worldIndex: number)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	local position = getSpawnPosition(worldIndex)
	(character :: Model):PivotTo(CFrame.new(position + Vector3.new(0, 3, 0)))
	return true
end

-- ============================================================
-- VOYAGE
-- ============================================================
function WorldManager.isWorldUnlocked(profile, worldIndex: number): boolean
	if worldIndex &lt;= 0 then
		return true
	end
	local world = GameConfig.Worlds[worldIndex]
	if not world then
		return false
	end
	if profile.maxWorld &lt; worldIndex then
		return false
	end
	if (profile.rebirths or 0) &lt; world.UnlockRebirth then
		return false
	end
	return true
end

--- Téléporte un joueur. Renvoie true si le voyage a eu lieu.
function WorldManager.travel(player: Player, worldIndex: number, silent: boolean?): boolean
	local profile = DataManager.getProfile(player)
	if not profile then
		return false
	end
	if worldIndex ~= 0 and not GameConfig.Worlds[worldIndex] then
		return false
	end
	if not WorldManager.isWorldUnlocked(profile, worldIndex) then
		Net.event("Notify"):FireClient(player, "🔒 Ce monde n'est pas encore débloqué !", "ff6b6b", "🔒")
		return false
	end

	local now = os.clock()
	if lastTravel[player] and now - lastTravel[player] &lt; 0.75 then
		return false
	end
	lastTravel[player] = now

	local previous = profile.world
	updateOccupancy(profile, -1, previous)
	profile.world = worldIndex
	updateOccupancy(profile, 1, worldIndex)

	Net.event("SetWorld"):FireClient(player, worldIndex)
	Net.event("PlaySound"):FireClient(player, "teleport", 0.5)

	-- petit délai pour laisser le fondu client se jouer
	task.spawn(function()
		task.wait(silent and 0 or 0.28)
		-- StreamingEnabled : on force le chargement de la zone AVANT de
		-- téléporter, sinon le joueur risque de tomber dans le vide.
		pcall(function()
			player:RequestStreamAroundAsync(getSpawnPosition(worldIndex))
		end)
		if player.Parent and profile.world == worldIndex then
			if not placeCharacter(player, worldIndex) then
				-- personnage en cours de respawn : on retente une fois
				task.wait(0.5)
				placeCharacter(player, worldIndex)
			end
		end
	end)

	WorldManager.Events.WorldChanged:Fire(player, worldIndex)
	DataManager.notify(player)
	return true
end

--- Vérifie et débloque les mondes accessibles.
function WorldManager.checkUnlocks(player: Player, announce: boolean?)
	local profile = DataManager.getProfile(player)
	if not profile then
		return
	end
	for index = profile.maxWorld + 1, #GameConfig.Worlds do
		local world = GameConfig.Worlds[index]
		local hasPower = profile.bestPower &gt;= world.UnlockPower or profile.power &gt;= world.UnlockPower
		local hasRebirth = (profile.rebirths or 0) &gt;= world.UnlockRebirth
		if hasPower and hasRebirth then
			profile.maxWorld = index
			if announce then
				Net.event("Notify"):FireClient(
					player,
					string.format("%s %s débloqué ! (%s de puissance)", world.Emoji, world.Name, string.format("%.0f", world.UnlockPower)),
					"8affc1",
					"🌍"
				)
				Net.event("PlaySound"):FireClient(player, "unlock", 0.7)
			end
			WorldManager.Events.WorldUnlocked:Fire(player, index)
		else
			break
		end
	end
end

-- ============================================================
-- PORTAILS
-- ============================================================
local function onPortalTouched(player: Player, worldIndex: number?)
	if not DataManager.isLoaded(player) then
		return
	end
	local now = os.clock()
	if portalDebounce[player] and now - portalDebounce[player] &lt; 2 then
		return
	end
	portalDebounce[player] = now

	if worldIndex and worldIndex &gt; 0 then
		WorldManager.travel(player, worldIndex)
	else
		WorldManager.travel(player, 0)
	end
end

local function connectTouch(part: BasePart, callback: (Player) -&gt; ())
	part.Touched:Connect(function(hit)
		local character = hit:FindFirstAncestorOfClass("Model")
		if not character then
			return
		end
		local player = Players:GetPlayerFromCharacter(character)
		if player then
			callback(player)
		end
	end)
end

local function setupPortals()
	local lobby = Workspace:FindFirstChild("Lobby")
	if not lobby then
		return
	end
	local portals = lobby:FindFirstChild("Portals")
	if not portals then
		return
	end
	for _, portalModel in ipairs(portals:GetChildren()) do
		local worldIndex = portalModel:GetAttribute("WorldIndex")
		if type(worldIndex) == "number" then
			for _, descendant in ipairs(portalModel:GetDescendants()) do
				if descendant:IsA("BasePart") and descendant.Name == "Pad" then
					connectTouch(descendant, function(player)
						onPortalTouched(player, worldIndex)
					end)
				end
			end
		end
	end
end

local function setupReturnPads()
	local worldsFolder = Workspace:FindFirstChild("Worlds")
	if not worldsFolder then
		return
	end
	for _, worldFolder in ipairs(worldsFolder:GetChildren()) do
		local returnPad = worldFolder:FindFirstChild("ReturnPad")
		if returnPad and returnPad:IsA("BasePart") then
			connectTouch(returnPad, function(player)
				onPortalTouched(player, 0)
			end)
		end
		local returnPortal = worldFolder:FindFirstChild("ReturnPortal")
		if returnPortal then
			local field = returnPortal:FindFirstChild("Field")
			if field and field:IsA("BasePart") then
				connectTouch(field, function(player)
					onPortalTouched(player, 0)
				end)
			end
		end
	end
end

-- ============================================================
-- CYCLE DE VIE
-- ============================================================
local function onCharacterAdded(player: Player, character: Model)
	local profile = DataManager.waitForProfile(player, 15)
	if not profile then
		return
	end
	character:WaitForChild("HumanoidRootPart", 10)
	task.wait(0.2)
	if character.Parent and player.Parent then
		placeCharacter(player, profile.world)
		if not firstJoinDone[player] then
			firstJoinDone[player] = true
			local world = GameConfig.Worlds[profile.world]
			if world then
				Net.event("Notify"):FireClient(
					player,
					string.format("Bienvenue dans %s %s ! Clique sur les objets pour les absorber.", world.Emoji, world.Name),
					"8affc1",
					"👋"
				)
			end
		end
	end
end

local function onPlayerAdded(player: Player)
	local profile = DataManager.waitForProfile(player, 20)
	if not profile then
		return
	end
	WorldManager.checkUnlocks(player, false)
	-- Si le joueur était dans le lobby, on l'envoie dans son monde
	if profile.world &lt;= 0 then
		profile.world = math.max(1, profile.maxWorld)
		DataManager.notify(player)
	end
	updateOccupancy(profile, 1, profile.world)

	player.CharacterAdded:Connect(function(character)
		task.spawn(onCharacterAdded, player, character)
	end)
	if player.Character then
		task.spawn(onCharacterAdded, player, player.Character)
	end
end

function WorldManager.start()
	setupPortals()
	setupReturnPads()

	Net.event("TravelWorld").OnServerEvent:Connect(function(player, worldIndex)
		if type(worldIndex) ~= "number" then
			return
		end
		worldIndex = math.floor(worldIndex)
		if worldIndex &lt; 0 or worldIndex &gt; #GameConfig.Worlds then
			return
		end
		WorldManager.travel(player, worldIndex)
	end)

	Players.PlayerAdded:Connect(function(player)
		task.spawn(onPlayerAdded, player)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end

	Players.PlayerRemoving:Connect(function(player)
		local profile = DataManager.getProfile(player)
		if profile then
			updateOccupancy(profile, -1, profile.world)
		end
		lastTravel[player] = nil
		portalDebounce[player] = nil
		firstJoinDone[player] = nil
	end)

	-- Vérification périodique des déblocages + occupation
	task.spawn(function()
		while true do
			task.wait(2)
			recomputeOccupancy()
			for _, player in ipairs(Players:GetPlayers()) do
				if DataManager.isLoaded(player) then
					WorldManager.checkUnlocks(player, true)
				end
			end
		end
	end)

	print("[WorldManager] Démarré")
end

return WorldManager
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
    </Item>
  </Item><Item class="StarterPlayer" referent="RBX0022">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties><Item class="StarterPlayerScripts" referent="RBX0023">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties><Item class="LocalScript" referent="RBX0024">
        <Properties>
          <string name="Name">ClientController</string>
          <ProtectedString name="Source">--!strict
--[[
	ClientController  |  StarterPlayer.StarterPlayerScripts.ClientController (LocalScript)
	------------------------------------------------------------------
	POINT D'ENTRÉE DU CLIENT. Il :
	  1. construit l'UI (UIController)
	  2. écoute tous les RemoteEvents et met à jour ClientState
	  3. démarre les contrôleurs d'effets / pets / sons
	  4. gère la collecte au clic, au tap et en maintien (auto-clic)
	  5. demande le profil au serveur (ClientReady + GetProfile)

	Aucune valeur de progression n'est calculée ici : tout vient du
	serveur (ProfileUpdated). Le client ne fait que de l'affichage.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local Formulas = require(Modules:WaitForChild("Formulas"))
local Net = require(Modules:WaitForChild("Net"))

local Controllers = script.Parent:WaitForChild("Controllers")
local UIFolder = script.Parent:WaitForChild("UI")

local ClientState = require(Controllers:WaitForChild("ClientState"))
local SoundController = require(Controllers:WaitForChild("SoundController"))
local EffectsController = require(Controllers:WaitForChild("EffectsController"))
local PetFollowController = require(Controllers:WaitForChild("PetFollowController"))
local UIController = require(UIFolder:WaitForChild("UIController"))
local UIConfig = require(UIFolder:WaitForChild("UIConfig"))

local C = UIConfig.Colors

-- ============================================================
-- 1. INTERFACE
-- ============================================================
local screenGui = UIController.start()

-- ============================================================
-- 2. CONTRÔLEURS
-- ============================================================
SoundController.start()
EffectsController.start(screenGui)
PetFollowController.start()

-- ============================================================
-- 3. REMOTES → ÉTAT LOCAL
-- ============================================================
local function colorFromHex(hex: string?): Color3
	if type(hex) ~= "string" or #hex &lt; 6 then
		return C.Gold
	end
	return UIConfig.fromHex(hex)
end

Net.event("ProfileUpdated").OnClientEvent:Connect(function(profile)
	local wasReady = ClientState.hasProfile
	ClientState.setProfile(profile)
	if not wasReady then
		UIController.hideLoading()
		SoundController.playWorldMusic(profile.world or 1)
	end
end)

Net.event("Notify").OnClientEvent:Connect(function(text, colorHex, icon)
	UIController.toast(text, colorFromHex(colorHex), icon or "✨")
	ClientState.Signals.Notify:Fire(text, colorHex, icon)
end)

Net.event("EffectBurst").OnClientEvent:Connect(function(position, colorHex, value)
	ClientState.Signals.EffectBurst:Fire(position, colorHex, value)
end)

Net.event("PlaySound").OnClientEvent:Connect(function(key, volume)
	SoundController.play(key, volume)
end)

Net.event("CameraShake").OnClientEvent:Connect(function(intensity)
	ClientState.Signals.CameraShake:Fire(intensity)
end)

Net.event("ScreenFlash").OnClientEvent:Connect(function(colorHex, duration)
	ClientState.Signals.ScreenFlash:Fire(colorHex, duration)
end)

Net.event("EventUpdate").OnClientEvent:Connect(function(eventId, endsAt)
	ClientState.eventId = eventId
	ClientState.eventEndsAt = endsAt or 0
	ClientState.Signals.Event:Fire(eventId, endsAt or 0)
end)

Net.event("EggResult").OnClientEvent:Connect(function(rarity, petId, name, mult, eggId, isNew)
	UIController.queueEggReveal({ rarity = rarity, petId = petId, name = name, mult = mult, eggId = eggId, isNew = isNew })
	ClientState.Signals.EggResult:Fire(rarity, petId, name, mult, eggId, isNew)
end)

Net.event("LeaderboardData").OnClientEvent:Connect(function(global, server)
	if type(global) == "table" then
		ClientState.globalLeaderboard = global
	end
	if type(server) == "table" then
		ClientState.serverLeaderboard = server
	end
	ClientState.Signals.Leaderboard:Fire(global, server)
end)

Net.event("SetWorld").OnClientEvent:Connect(function(worldIndex)
	ClientState.currentWorld = worldIndex
	ClientState.Signals.World:Fire(worldIndex)
	ClientState.Signals.Sound:Fire("teleport", 0.5)
end)

Net.event("Transformation").OnClientEvent:Connect(function(tier)
	ClientState.Signals.Transformation:Fire(tier)
	local data = GameConfig.Transformations[tier]
	if data then
		UIController.toast(string.format("Transformation : %s %s !", data.Emoji, data.Name), data.Aura, data.Emoji)
	end
end)

Net.event("DailyAvailable").OnClientEvent:Connect(function(available)
	ClientState.dailyAvailable = available
	ClientState.Signals.Daily:Fire(available)
end)

Net.event("BoostUpdate").OnClientEvent:Connect(function(mult, endsAt)
	ClientState.boostMult = mult or 1
	ClientState.boostEndsAt = endsAt or 0
	ClientState.Signals.Boost:Fire(mult, endsAt)
end)

Net.event("RebirthSuccess").OnClientEvent:Connect(function(rebirths, coins)
	ClientState.Signals.Rebirth:Fire(rebirths, coins)
	UIController.toast(string.format("🔄 REBIRTH %d ! +%s pièces", rebirths, Formulas.formatNumber(coins or 0)), C.Pink, "🔄")
end)

-- ============================================================
-- 4. COLLECTE (clic / tap / maintien)
-- ============================================================
local lastClickTime = 0
local holding = false
local lastPointer = Vector2.new(0, 0)
local collectiblesFolder = nil

local function getCollectibles(): Instance?
	if collectiblesFolder and collectiblesFolder.Parent then
		return collectiblesFolder
	end
	collectiblesFolder = Workspace:FindFirstChild("Collectibles")
	return collectiblesFolder
end

--- Trouve l'objet le plus proche du joueur (fallback mobile / tap dans le vide)
local function findNearestCollectible(maxDistance: number): BasePart?
	local folder = getCollectibles()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not folder or not root then
		return nil
	end
	local origin = (root :: BasePart).Position
	local best = nil
	local bestDistance = maxDistance
	for _, part in ipairs(folder:GetChildren()) do
		if part:IsA("BasePart") then
			local distance = ((part :: BasePart).Position - origin).Magnitude
			if distance &lt; bestDistance then
				bestDistance = distance
				best = part
			end
		end
	end
	return best
end

local function tryCollectAt(screenPosition: Vector2)
	local now = os.clock()
	if now - lastClickTime &lt; 0.045 then
		return
	end
	lastClickTime = now

	local camera = Workspace.CurrentCamera
	local folder = getCollectibles()
	if not camera or not folder then
		return
	end

	local ray = camera:ScreenPointToRay(screenPosition.X, screenPosition.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { folder }
	params.IgnoreWater = true
	local result = Workspace:Raycast(ray.Origin, ray.Direction * 800, params)

	local target = result and result.Instance
	if target and target:IsA("BasePart") then
		Net.event("CollectRequest"):FireServer(target)
		return
	end

	-- Rien de visé : on prend l'objet le plus proche (très pratique sur mobile)
	local nearest = findNearestCollectible(48)
	if nearest then
		Net.event("CollectRequest"):FireServer(nearest)
	end
end

local function canInteract(): boolean
	return ClientState.hasProfile and player.Character ~= nil
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end
	if not canInteract() then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		holding = true
		lastPointer = input.Position
		tryCollectAt(input.Position)
	elseif input.UserInputType == Enum.UserInputType.Touch then
		lastPointer = input.Position
		tryCollectAt(input.Position)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		lastPointer = input.Position
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		holding = false
	end
end)

-- Maintien du clic = clics automatiques rapides (très satisfaisant)
task.spawn(function()
	while true do
		local interval = 0.09
		task.wait(interval)
		if holding and canInteract() then
			tryCollectAt(lastPointer)
		end
	end
end)

-- ============================================================
-- 5. DÉMARRAGE RÉSEAU
-- ============================================================
Net.event("ClientReady"):FireServer()

task.spawn(function()
	local ok, profile = pcall(function()
		return Net.func("GetProfile"):InvokeServer()
	end)
	if ok and type(profile) == "table" and not ClientState.hasProfile then
		ClientState.setProfile(profile)
		UIController.hideLoading()
	end
end)

-- Sécurité : si le serveur met trop de temps, on enlève l'écran de chargement
task.delay(20, function()
	if not ClientState.hasProfile then
		UIController.hideLoading()
		UIController.toast("⚠️ Chargement lent… réessaie de rejoindre si ça bloque.", C.Red, "⚠️")
	end
end)

-- Vitesse / saut : le serveur gère la vitesse (amélioration), le client
-- s'assure juste que la physique reste agréable après un respawn
player.CharacterAdded:Connect(function(character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if humanoid then
		humanoid.UseJumpPower = true
		humanoid.JumpPower = 50
	end
end)

print("[ClientController] Prêt — " .. GameConfig.GameName .. " v" .. tostring(GameConfig.Version))
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item><Item class="Folder" referent="RBX0025">
        <Properties>
          <string name="Name">Controllers</string>
        </Properties><Item class="ModuleScript" referent="RBX0026">
          <Properties>
            <string name="Name">ClientState</string>
            <ProtectedString name="Source">--!strict
--[[
	ClientState  |  StarterPlayer.StarterPlayerScripts.Controllers.ClientState
	------------------------------------------------------------------
	Miroir local du profil serveur + état de l'interface.
	TOUTES les valeurs de progression viennent du serveur : le client ne
	fait que les afficher. Les calculs (multiplicateurs, tiers) sont refaits
	ici uniquement pour l'affichage, jamais pour valider quoi que ce soit.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local Signal = require(Modules:WaitForChild("Signal"))
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local Formulas = require(Modules:WaitForChild("Formulas"))
local ProfileTemplate = require(Modules:WaitForChild("ProfileTemplate"))

local ClientState = {}

ClientState.profile = ProfileTemplate.new()
ClientState.hasProfile = false
ClientState.eventId = nil
ClientState.eventEndsAt = 0
ClientState.currentWorld = 0
ClientState.globalLeaderboard = {}
ClientState.serverLeaderboard = {}
ClientState.boostMult = 1
ClientState.boostEndsAt = 0
ClientState.dailyAvailable = false
ClientState.vacuumReadyAt = 0

ClientState.Signals = {
	Profile = Signal.new(),       -- (profile)
	Event = Signal.new(),         -- (eventId, endsAt)
	World = Signal.new(),         -- (worldIndex)
	Leaderboard = Signal.new(),   -- (global, server)
	EggResult = Signal.new(),     -- (rarity, petId, name, mult, eggId, isNew)
	Rebirth = Signal.new(),       -- (rebirths, coins)
	Notify = Signal.new(),        -- (text, color, icon)
	Boost = Signal.new(),         -- (mult, endsAt)
	Transformation = Signal.new(),-- (tier)
	ScreenFlash = Signal.new(),   -- (color, duration)
	CameraShake = Signal.new(),   -- (intensity)
	Sound = Signal.new(),         -- (key, volume)
	EffectBurst = Signal.new(),   -- (position, color, value)
	Daily = Signal.new(),         -- (available)
}

function ClientState.setProfile(profile)
	if type(profile) ~= "table" then
		return
	end
	local previous = ClientState.profile
	ClientState.profile = profile
	ClientState.hasProfile = true
	ClientState.currentWorld = profile.world or ClientState.currentWorld
	ClientState.Signals.Profile:Fire(profile, previous)
end

-- ============================================================
-- GETTERS (affichage)
-- ============================================================
function ClientState.getPower(): number
	return ClientState.profile.power or 0
end

function ClientState.getCoins(): number
	return ClientState.profile.coins or 0
end

function ClientState.getRebirths(): number
	return ClientState.profile.rebirths or 0
end

function ClientState.getTierIndex(): number
	return Formulas.getTransformIndex(ClientState.getPower())
end

function ClientState.getTier()
	local index = Formulas.getTransformIndex(ClientState.getPower())
	return GameConfig.Transformations[index], index
end

function ClientState.getNextTier()
	local index = Formulas.getTransformIndex(ClientState.getPower())
	return GameConfig.Transformations[index + 1], index
end

function ClientState.getTierProgress(): number
	local current, index = ClientState.getTier()
	local nextTier = GameConfig.Transformations[index + 1]
	if not nextTier then
		return 1
	end
	local span = nextTier.MinPower - current.MinPower
	if span &lt;= 0 then
		return 1
	end
	return math.clamp((ClientState.getPower() - current.MinPower) / span, 0, 1)
end

function ClientState.getBoost(): number
	if ClientState.boostEndsAt &gt; os.time() then
		return math.max(1, ClientState.boostMult)
	end
	return 1
end

--- Multiplicateur d'événement côté client (affichage uniquement ; la
--- valeur officielle est calculée par DataManager/getPowerMultiplier).
function ClientState.getEventMultiplier(): number
	if not ClientState.eventIsActive() then
		return 1
	end
	if ClientState.eventId == "GiantMode" then
		return GameConfig.EventRewards.GiantModePowerMult
	elseif ClientState.eventId == "LuckyTime" then
		return GameConfig.EventRewards.LuckyTimeMult
	end
	return 1
end

function ClientState.getPowerMultiplier(): number
	local profile = ClientState.profile
	local mult = Formulas.totalPowerMultiplier(profile, profile.gamePasses, ClientState.getEventMultiplier(), ClientState.getBoost())
	return mult
end

function ClientState.getPetSlots(): number
	return Formulas.petSlots(ClientState.profile, ClientState.profile.gamePasses and ClientState.profile.gamePasses.ExtraPetSlots)
end

function ClientState.getUpgradeLevel(upgradeId: string): number
	local upgrades = ClientState.profile.upgrades
	return (upgrades and upgrades[upgradeId]) or 0
end

function ClientState.getWorld(): number
	return ClientState.currentWorld
end

function ClientState.getWorldData(worldIndex: number?)
	local index = worldIndex or ClientState.currentWorld
	if index &lt;= 0 then
		return nil
	end
	return GameConfig.Worlds[index]
end

function ClientState.isWorldUnlocked(worldIndex: number): boolean
	local profile = ClientState.profile
	if worldIndex &lt;= 0 then
		return true
	end
	local world = GameConfig.Worlds[worldIndex]
	if not world then
		return false
	end
	return (profile.maxWorld or 1) &gt;= worldIndex
end

function ClientState.ownsPet(uid: string): boolean
	for _, pet in ipairs(ClientState.profile.pets or {}) do
		if pet.uid == uid then
			return true
		end
	end
	return false
end

function ClientState.isEquipped(uid: string): boolean
	for _, equippedUid in ipairs(ClientState.profile.equipped or {}) do
		if equippedUid == uid then
			return true
		end
	end
	return false
end

function ClientState.getEquippedPets()
	local map = {}
	for _, pet in ipairs(ClientState.profile.pets or {}) do
		map[pet.uid] = pet
	end
	local list = {}
	for _, uid in ipairs(ClientState.profile.equipped or {}) do
		if map[uid] then
			table.insert(list, map[uid])
		end
	end
	return list
end

function ClientState.countPetId(petId: string, level: number?): number
	local total = 0
	for _, pet in ipairs(ClientState.profile.pets or {}) do
		if pet.id == petId and (level == nil or pet.level == level) then
			total = total + 1
		end
	end
	return total
end

function ClientState.getSetting(key: string): boolean
	local settings = ClientState.profile.settings
	if settings and settings[key] ~= nil then
		return settings[key] == true
	end
	return true
end

function ClientState.eventIsActive(): boolean
	return ClientState.eventId ~= nil and ClientState.eventEndsAt &gt; os.time()
end

function ClientState.eventRemaining(): number
	return math.max(0, ClientState.eventEndsAt - os.time())
end

return ClientState
</ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item><Item class="ModuleScript" referent="RBX0027">
          <Properties>
            <string name="Name">EffectsController</string>
            <ProtectedString name="Source">--!strict
--[[
	EffectsController  |  StarterPlayer.StarterPlayerScripts.Controllers.EffectsController
	------------------------------------------------------------------
	Tous les effets visuels côté client :

	  • explosion de particules + nombre flottant à chaque absorption
	  • flash d'écran, secousse de caméra
	  • ambiance lumineuse par monde (Atmosphere/Fog/Brume locale)
	  • animation des objets à absorber proches (rotation/flottement)
	  • animation des portails
	  • anneau de transformation

	100% client : aucun coût réseau, désactivé sur mobile si le joueur
	coupe les effets dans les paramètres.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local Debris = game:GetService("Debris")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local Formulas = require(Modules:WaitForChild("Formulas"))

local ClientState = require(script.Parent.ClientState)

local EffectsController = {}

local screenGui: ScreenGui? = nil
local fxLayer: Frame? = nil
local shakeAmount = 0
local shakeConnection = nil
local currentWorld = 0
local camera = Workspace.CurrentCamera

local function toHex(color: Color3): string
	return string.format("%02x%02x%02x", math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5))
end

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

-- ============================================================
-- PARTICULES D'ABSORPTION
-- ============================================================
function EffectsController.burst(position: Vector3, colorHex: string, value: number)
	if not ClientState.getSetting("effects") then
		return
	end
	local color = Color3.fromRGB(tonumber(string.sub(colorHex, 1, 2), 16) or 140, tonumber(string.sub(colorHex, 3, 4), 16) or 255, tonumber(string.sub(colorHex, 5, 6), 16) or 190)

	local anchor = Instance.new("Part")
	anchor.Name = "FxAnchor"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = CFrame.new(position)
	anchor.Parent = Workspace

	if ClientState.getSetting("particles") then
		local emitter = Instance.new("ParticleEmitter")
		emitter.Texture = SPARKLE
		emitter.Color = ColorSequence.new(color)
		emitter.LightEmission = 1
		emitter.LightInfluence = 0
		emitter.Rate = 0
		emitter.Lifetime = NumberRange.new(0.35, 0.7)
		emitter.Speed = NumberRange.new(14, 26)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1.6),
			NumberSequenceKeypoint.new(1, 0),
		})
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(1, 1),
		})
		emitter.Parent = anchor
		emitter:Emit(math.clamp(8 + math.log10(math.max(value, 1)) * 5, 8, 40))

		local ring = Instance.new("ParticleEmitter")
		ring.Texture = SMOKE
		ring.Color = ColorSequence.new(color)
		ring.Rate = 0
		ring.Lifetime = NumberRange.new(0.4, 0.6)
		ring.Speed = NumberRange.new(20, 30)
		ring.SpreadAngle = Vector2.new(0, 360)
		ring.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.5),
			NumberSequenceKeypoint.new(1, 3),
		})
		ring.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		})
		ring.Parent = anchor
		ring:Emit(10)
	end

	-- Nombre flottant
	if ClientState.getSetting("damageNumbers") then
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "FloatNumber"
		billboard.Size = UDim2.fromOffset(160, 44)
		billboard.AlwaysOnTop = true
		billboard.Adornee = anchor
		billboard.Parent = anchor

		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = Enum.Font.FredokaOne
		label.Text = "+" .. Formulas.formatNumber(value) .. " ⚡"
		label.TextColor3 = color
		label.TextStrokeTransparency = 0.2
		label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		label.TextScaled = true
		label.Parent = billboard

		TweenService:Create(anchor, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			CFrame = CFrame.new(position + Vector3.new(math.random(-2, 2), 5, math.random(-2, 2))),
		}):Play()
		TweenService:Create(label, TweenInfo.new(0.8), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	end

	Debris:AddItem(anchor, 1.2)
end

-- ============================================================
-- FLASH / SHAKE
-- ============================================================
function EffectsController.flash(colorHex: string, duration: number?)
	if not fxLayer or not ClientState.getSetting("effects") then
		return
	end
	local color = Color3.fromRGB(tonumber(string.sub(colorHex, 1, 2), 16) or 255, tonumber(string.sub(colorHex, 3, 4), 16) or 255, tonumber(string.sub(colorHex, 5, 6), 16) or 255)
	local flashFrame = Instance.new("Frame")
	flashFrame.Size = UDim2.fromScale(1, 1)
	flashFrame.BackgroundColor3 = color
	flashFrame.BackgroundTransparency = 0.55
	flashFrame.BorderSizePixel = 0
	flashFrame.ZIndex = 50
	flashFrame.Parent = fxLayer
	TweenService:Create(flashFrame, TweenInfo.new(duration or 0.4), { BackgroundTransparency = 1 }):Play()
	Debris:AddItem(flashFrame, (duration or 0.4) + 0.1)
end

function EffectsController.shake(intensity: number)
	if not ClientState.getSetting("cameraShake") then
		return
	end
	shakeAmount = math.clamp(shakeAmount + intensity * 1.4, 0, 3)
	if shakeConnection then
		return
	end
	shakeConnection = RunService.RenderStepped:Connect(function(deltaTime)
		local cam = Workspace.CurrentCamera
		if not cam then
			return
		end
		if shakeAmount &lt;= 0.001 then
			if shakeConnection then
				shakeConnection:Disconnect()
				shakeConnection = nil
			end
			return
		end
		local offset = Vector3.new(
			(math.random() - 0.5) * shakeAmount,
			(math.random() - 0.5) * shakeAmount,
			0
		)
		cam.CFrame = cam.CFrame * CFrame.new(offset)
		shakeAmount = math.max(0, shakeAmount - deltaTime * 4.5)
	end)
end

-- ============================================================
-- TRANSFORMATION
-- ============================================================
function EffectsController.transformation(tierIndex: number)
	local tier = GameConfig.Transformations[tierIndex]
	if not tier or not ClientState.getSetting("effects") then
		return
	end
	EffectsController.flash(toHex(tier.Aura), 0.45)
	EffectsController.shake(0.8)

	local character = game:GetService("Players").LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and ClientState.getSetting("particles") then
		local emitter = Instance.new("ParticleEmitter")
		emitter.Texture = SPARKLE
		emitter.Color = ColorSequence.new(tier.Aura)
		emitter.LightEmission = 1
		emitter.Rate = 0
		emitter.Lifetime = NumberRange.new(0.6, 1.3)
		emitter.Speed = NumberRange.new(30, 55)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 2),
			NumberSequenceKeypoint.new(1, 0),
		})
		emitter.Parent = root
		emitter:Emit(90)
		Debris:AddItem(emitter, 2)
	end
end

-- ============================================================
-- AMBIANCE PAR MONDE (local, n'affecte que ce joueur)
-- ============================================================
local function getAtmosphere(): Atmosphere
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if not atmosphere then
		atmosphere = Instance.new("Atmosphere")
		atmosphere.Density = 0.3
		atmosphere.Offset = 0.1
		atmosphere.Color = Color3.fromRGB(200, 220, 255)
		atmosphere.Decay = Color3.fromRGB(120, 150, 200)
		atmosphere.Glare = 0.2
		atmosphere.Haze = 1.2
		atmosphere.Parent = Lighting
	end
	return atmosphere
end

--- Fondu noir rapide lors d'un voyage (rend le téléportation "propre")
function EffectsController.worldTransition()
	if not fxLayer then
		return
	end
	local fade = Instance.new("Frame")
	fade.Name = "WorldFade"
	fade.Size = UDim2.fromScale(1, 1)
	fade.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	fade.BackgroundTransparency = 0.15
	fade.BorderSizePixel = 0
	fade.ZIndex = 49
	fade.Parent = fxLayer
	TweenService:Create(fade, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		BackgroundTransparency = 1,
	}):Play()
	Debris:AddItem(fade, 0.6)
end

function EffectsController.setWorld(worldIndex: number)
	EffectsController.worldTransition()
	currentWorld = worldIndex
	local world = GameConfig.Worlds[worldIndex]
	if not world then
		-- Lobby
		pcall(function()
			Lighting.ClockTime = 14
			Lighting.FogEnd = 5000
			Lighting.FogStart = 0
			Lighting.FogColor = Color3.fromRGB(200, 220, 255)
			Lighting.Ambient = Color3.fromRGB(120, 130, 150)
			Lighting.OutdoorAmbient = Color3.fromRGB(140, 150, 170)
			local atmosphere = getAtmosphere()
			TweenService:Create(atmosphere, TweenInfo.new(0.8), {
				Color = Color3.fromRGB(200, 220, 255),
				Decay = Color3.fromRGB(120, 150, 200),
				Density = 0.3,
				Haze = 1.2,
			}):Play()
		end)
		return
	end

	pcall(function()
		local atmosphere = getAtmosphere()
		TweenService:Create(atmosphere, TweenInfo.new(0.9), {
			Color = world.AtmosphereColor,
			Decay = world.SkyColor,
			Density = worldIndex &gt;= 4 and 0.4 or 0.3,
			Haze = worldIndex == 3 and 2.5 or 1.2,
			Glare = worldIndex == 6 and 0.8 or 0.2,
		}):Play()
		Lighting.FogColor = world.SkyColor
		Lighting.FogStart = 300
		Lighting.FogEnd = worldIndex &gt;= 5 and 2200 or 4000
		Lighting.Ambient = world.Ambient
		Lighting.OutdoorAmbient = world.Ambient:Lerp(Color3.fromRGB(255, 255, 255), 0.25)
		Lighting.ClockTime = worldIndex == 4 and 0 or 14
	end)
end

-- ============================================================
-- ANIMATION DES OBJETS (rotation / flottement)
-- ============================================================
local animatedParts: { [BasePart]: any } = {}
local refreshTimer = 0

local function refreshAnimatedParts()
	animatedParts = {}
	local folder = Workspace:FindFirstChild("Collectibles")
	if folder then
		local cam = Workspace.CurrentCamera
		local cameraPosition = cam and cam.CFrame.Position or Vector3.zero
		local count = 0
		for _, part in ipairs(folder:GetChildren()) do
			if part:IsA("BasePart") and (part.Position - cameraPosition).Magnitude &lt; 200 then
				animatedParts[part] = {
					baseCFrame = part.CFrame,
					phase = math.random() * math.pi * 2,
					speed = 0.6 + math.random() * 0.6,
				}
				count = count + 1
				if count &gt;= 70 then
					break
				end
			end
		end
	end
	-- Portails animés
	local lobby = Workspace:FindFirstChild("Lobby")
	if lobby then
		for _, descendant in ipairs(lobby:GetDescendants()) do
			if descendant:IsA("BasePart") and descendant:GetAttribute("Animated") then
				animatedParts[descendant] = { animated = true, baseCFrame = descendant.CFrame, phase = 0, speed = 1 }
			end
		end
	end
	local worlds = Workspace:FindFirstChild("Worlds")
	if worlds then
		for _, descendant in ipairs(worlds:GetDescendants()) do
			if descendant:IsA("BasePart") and descendant:GetAttribute("Animated") then
				animatedParts[descendant] = { animated = true, baseCFrame = descendant.CFrame, phase = 0, speed = 1 }
			end
		end
	end
end

local function animateLoop(deltaTime: number)
	refreshTimer = refreshTimer + deltaTime
	if refreshTimer &gt; 0.5 then
		refreshTimer = 0
		refreshAnimatedParts()
	end
	if not ClientState.getSetting("effects") then
		return
	end
	local time = os.clock()
	for part, data in pairs(animatedParts) do
		if not part.Parent then
			animatedParts[part] = nil
		elseif data.animated then
			if string.find(part.Name, "Egg") or part.Name == "AltarOrb" then
				part.CFrame = data.baseCFrame * CFrame.new(0, math.sin(time * 1.5 + data.phase) * 0.6, 0)
			end
		else
			part.CFrame = data.baseCFrame * CFrame.new(0, math.sin(time * data.speed + data.phase) * 0.45, 0) * CFrame.Angles(0, time * data.speed * 0.6, 0)
		end
	end
end

-- ============================================================
-- DÉMARRAGE
-- ============================================================
function EffectsController.start(parentScreenGui: ScreenGui)
	screenGui = parentScreenGui

	fxLayer = Instance.new("Frame")
	fxLayer.Name = "FxLayer"
	fxLayer.Size = UDim2.fromScale(1, 1)
	fxLayer.BackgroundTransparency = 1
	fxLayer.ZIndex = 50
	fxLayer.Parent = parentScreenGui

	ClientState.Signals.EffectBurst:Connect(function(position, color, value)
		EffectsController.burst(position, color or "8affc1", value or 0)
	end)
	ClientState.Signals.ScreenFlash:Connect(function(color, duration)
		EffectsController.flash(color or "ffffff", duration)
	end)
	ClientState.Signals.CameraShake:Connect(function(intensity)
		EffectsController.shake(intensity or 0.4)
	end)
	ClientState.Signals.Transformation:Connect(function(tier)
		EffectsController.transformation(tier)
	end)
	ClientState.Signals.World:Connect(function(worldIndex)
		EffectsController.setWorld(worldIndex)
	end)

	refreshAnimatedParts()
	RunService.Heartbeat:Connect(animateLoop)

	-- Adapte les effets à la puissance (plus tu es puissant, plus c'est fort)

	print("[EffectsController] Démarré")
end

return EffectsController
</ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item><Item class="ModuleScript" referent="RBX0028">
          <Properties>
            <string name="Name">PetFactory</string>
            <ProtectedString name="Source">--!strict
--[[
	PetFactory  |  StarterPlayer.StarterPlayerScripts.Controllers.PetFactory
	------------------------------------------------------------------
	Construit les modèles 3D des pets à partir de primitives Roblox.
	Aucun asset externe : chaque pet = corps + tête + yeux + accessoire,
	coloré selon sa rareté. Les pets sont affichés côté client uniquement
	(le serveur ne connaît que les données).

	Utilisation :
		local model = PetFactory.create("Dragon", 3)
		model:PivotTo(cframe)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))

local PetFactory = {}

local function makePart(name: string, size: Vector3, color: Color3, material: Enum.Material?, parent: Instance): BasePart
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Massless = true
	part.Parent = parent
	return part
end

--- Crée le modèle 3D d'un pet.
function PetFactory.create(petId: string, level: number?): Model
	local info = GameConfig.Pets[petId]
	local rarity = info and GameConfig.Rarities[info.Rarity] or GameConfig.Rarities.Common
	local petLevel = level or 1
	local scale = (info and info.Scale or 1) * (1 + (petLevel - 1) * 0.06)

	local model = Instance.new("Model")
	model.Name = "Pet_" .. petId

	local bodySize = Vector3.new(1.7, 1.7, 1.7)
	if info and info.Shape == "Ball" then
		bodySize = Vector3.new(1.9, 1.9, 1.9)
	elseif info and info.Shape == "Cylinder" then
		bodySize = Vector3.new(1.6, 1.6, 2.1)
	elseif info and info.Shape == "Wedge" then
		bodySize = Vector3.new(1.9, 1.4, 2.4)
	end

	local material = Enum.Material.SmoothPlastic
	if info and info.Glow then
		material = Enum.Material.Neon
	end

	local bodyColor = info and info.BodyColor or Color3.fromRGB(230, 230, 230)
	local accentColor = info and info.AccentColor or Color3.fromRGB(255, 255, 255)

	local body = makePart("Body", bodySize * scale, bodyColor, material, model)
	if info and info.Shape == "Ball" then
		body.Shape = Enum.PartType.Ball
	end
	if info and info.Transparent then
		body.Transparency = info.Transparent
	end

	local head = makePart("Head", Vector3.new(1.35, 1.35, 1.35) * scale, bodyColor, material, model)
	head.Shape = Enum.PartType.Ball
	head.CFrame = CFrame.new(0, bodySize.Y * 0.55 * scale, bodySize.Z * 0.32 * scale)

	-- Yeux
	for _, side in ipairs({ -1, 1 }) do
		local eye = makePart("Eye", Vector3.new(0.34, 0.34, 0.2) * scale, Color3.fromRGB(20, 20, 30), Enum.Material.SmoothPlastic, model)
		eye.CFrame = head.CFrame * CFrame.new(0.3 * side * scale, 0.18 * scale, -0.55 * scale)
	end

	-- Museau / accent
	local accent = makePart("Accent", Vector3.new(0.7, 0.45, 0.4) * scale, accentColor, Enum.Material.SmoothPlastic, model)
	accent.CFrame = head.CFrame * CFrame.new(0, -0.22 * scale, -0.55 * scale)

	-- Ailes / accessoire selon la rareté
	local rarityOrder = rarity.Order or 1
	if rarityOrder &gt;= 3 then
		for _, side in ipairs({ -1, 1 }) do
			local wing = makePart("Wing", Vector3.new(0.18, 1.5, 0.9) * scale, accentColor, Enum.Material.Neon, model)
			wing.CFrame = body.CFrame * CFrame.new(0.95 * side * scale, 0.2 * scale, 0.15 * scale) * CFrame.Angles(0, 0, math.rad(22 * side))
		end
	end
	if rarityOrder &gt;= 5 then
		local crown = makePart("Crown", Vector3.new(0.95, 0.3, 0.95) * scale, Color3.fromRGB(255, 215, 70), Enum.Material.Neon, model)
		crown.Shape = Enum.PartType.Cylinder
		crown.CFrame = head.CFrame * CFrame.new(0, 0.85 * scale, 0) * CFrame.Angles(0, 0, math.rad(90))
	end
	if rarityOrder &gt;= 6 then
		local emitter = Instance.new("ParticleEmitter")
		emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		emitter.Color = ColorSequence.new(rarity.Color)
		emitter.Rate = 12
		emitter.Lifetime = NumberRange.new(0.4, 0.9)
		emitter.Speed = NumberRange.new(1, 3)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.LightEmission = 1
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.6),
			NumberSequenceKeypoint.new(1, 0),
		})
		emitter.Parent = body
	end

	-- Lumière pour les pets rares
	if rarityOrder &gt;= 4 or (info and info.Glow) then
		local light = Instance.new("PointLight")
		light.Color = rarity.Color
		light.Brightness = 1.2
		light.Range = 12
		light.Parent = body
	end

	-- Étiquette au-dessus du pet
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "PetTag"
	billboard.Size = UDim2.fromOffset(120, 40)
	billboard.StudsOffset = Vector3.new(0, 2.1 * scale, 0)
	billboard.AlwaysOnTop = false
	billboard.MaxDistance = 90
	billboard.Adornee = body
	billboard.Parent = model

	local nameLabel = Instance.new("TextLabel")
	nameLabel.BackgroundTransparency = 1
	nameLabel.Size = UDim2.fromScale(1, 0.6)
	nameLabel.Font = Enum.Font.FredokaOne
	nameLabel.Text = string.format("%s %s", (info and info.Emoji) or "🐾", (info and info.Name) or petId)
	nameLabel.TextColor3 = rarity.Color
	nameLabel.TextStrokeTransparency = 0.4
	nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	nameLabel.TextScaled = true
	nameLabel.Parent = billboard

	local levelLabel = Instance.new("TextLabel")
	levelLabel.BackgroundTransparency = 1
	levelLabel.Position = UDim2.fromScale(0, 0.58)
	levelLabel.Size = UDim2.fromScale(1, 0.4)
	levelLabel.Font = Enum.Font.GothamBold
	levelLabel.Text = petLevel &gt; 1 and ("Nv." .. petLevel .. "  ×" .. string.format("%.2f", (info and info.Mult or 0) * (1 + (petLevel - 1) * 0.25))) or ("×" .. string.format("%.2f", info and info.Mult or 0))
	levelLabel.TextColor3 = Color3.fromRGB(240, 245, 255)
	levelLabel.TextStrokeTransparency = 0.5
	levelLabel.TextScaled = true
	levelLabel.Parent = billboard

	model.PrimaryPart = body
	model:SetAttribute("PetId", petId)
	model:SetAttribute("PetLevel", petLevel)
	return model
end

return PetFactory
</ProtectedString>
