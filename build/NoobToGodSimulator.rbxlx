  </Item><Item class="ServerScriptService" referent="RBX0011">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties><Item class="Script" referent="RBX0012">
      <Properties>
        <string name="Name">Bootstrap</string>
        <ProtectedString name="Source">--!strict
--[[
	Bootstrap  |  ServerScriptService.Bootstrap (Script)
	------------------------------------------------------------------
	POINT D'ENTRÉE UNIQUE DU SERVEUR.

	Ordre de démarrage (important) :
	  1. Net.init() ................ crée les RemoteEvents/Functions
	  2. WorldFactory.buildAll() ... génère la map (lobby + 6 mondes)
	  3. Systèmes .................. enregistrent leurs remotes et signaux
	  4. DataManager.start() ....... EN DERNIER : charge les joueurs
	                                 (comme ça tous les systèmes écoutent
	                                 déjà l'événement "Loaded")
	  5. BindToClose ............... sauvegarde tout à la fermeture
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local Net = require(Modules:WaitForChild("Net"))

local Systems = ServerScriptService:WaitForChild("Systems")

print(string.format("===== %s v%d — démarrage =====", GameConfig.GameName, GameConfig.Version))

-- 1. Réseau
Net.init()

-- 2. Map
local WorldFactory = require(Systems:WaitForChild("WorldFactory"))
WorldFactory.buildAll()

-- 3. Systèmes (l'ordre n'a pas d'importance pour les signaux, mais on le
--    garde logique : données → gameplay → social → monétisation)
local systemOrder = {
	"CollectSystem",
	"CharacterSystem",
	"PetSystem",
	"ShopSystem",
	"RebirthSystem",
	"AchievementSystem",
	"DailyRewardSystem",
	"EventManager",
	"LeaderboardManager",
	"SettingsSystem",
	"MonetizationSystem",
	"WorldManager",
}

local loadedSystems = {}
for _, systemName in ipairs(systemOrder) do
	local module = Systems:FindFirstChild(systemName)
	if module then
		local ok, system = pcall(require, module)
		if ok and system and type(system.start) == "function" then
			local started, err = pcall(system.start)
			if started then
				loadedSystems[systemName] = system
			else
				warn(string.format("[Bootstrap] %s.start() a échoué : %s", systemName, tostring(err)))
			end
		else
			warn(string.format("[Bootstrap] impossible de charger %s : %s", systemName, tostring(system)))
		end
	end
end

-- 4. Données (en dernier)
local DataManager = require(Systems:WaitForChild("DataManager"))
DataManager.start()

-- 5. Fermeture propre du serveur
game:BindToClose(function()
	print("[Bootstrap] Fermeture du serveur : sauvegarde de tous les joueurs…")
	pcall(function()
		DataManager.shutdown()
	end)
end)

-- Réglages globaux de confort
Players.CharacterAutoLoads = true
Players.RespawnTime = 3

print(string.format("===== %s prêt (%d systèmes actifs) =====", GameConfig.GameName, (function()
	local count = 0
	for _ in pairs(loadedSystems) do
		count = count + 1
	end
	return count
end)()))
</ProtectedString>
        <bool name="Disabled">false</bool>
        <token name="RunContext">0</token>
      </Properties>
    </Item><Item class="Folder" referent="RBX0013">
      <Properties>
        <string name="Name">Systems</string>
      </Properties><Item class="ModuleScript" referent="RBX0014">
        <Properties>
          <string name="Name">AchievementSystem</string>
          <ProtectedString name="Source">--!strict
--[[
	AchievementSystem  |  ServerScriptService.Systems.AchievementSystem
	------------------------------------------------------------------
	24 succès. La progression est calculée côté serveur à partir des
	statistiques réelles du profil (impossible à falsifier).
	Résultat : récompense en pièces + notification + animation UI.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local Net = require(Modules:WaitForChild("Net"))

local DataManager = require(script.Parent.DataManager)

local AchievementSystem = {}

local function getStatValue(profile, statName: string): number
	if statName == "rebirths" then
		return profile.rebirths or 0
	elseif statName == "bestPower" then
		return math.max(profile.bestPower or 0, profile.power or 0)
	elseif statName == "maxWorld" then
		return profile.maxWorld or 1
	elseif statName == "streak" then
		return (profile.daily and profile.daily.streak) or 0
	end
	return (profile.stats and profile.stats[statName]) or 0
end

--- Vérifie tous les succès d'un joueur, débloque ceux atteints.
function AchievementSystem.check(player: Player, silent: boolean?)
	local profile = DataManager.getProfile(player)
	if not profile then
		return 0
	end
	local unlocked = 0
	for _, achievementId in ipairs(GameConfig.AchievementOrder) do
		local achievement = GameConfig.Achievements[achievementId]
		if achievement and not profile.achievements[achievementId] then
			if getStatValue(profile, achievement.Stat) &gt;= achievement.Goal then
				profile.achievements[achievementId] = true
				profile.coins = profile.coins + achievement.Reward
				unlocked = unlocked + 1
				Net.event("Notify"):FireClient(
					player,
					string.format("%s Succès débloqué : %s  (+%s 🪙)", achievement.Icon, achievement.Name, tostring(achievement.Reward)),
					"ffd700",
					"🏆"
				)
				Net.event("PlaySound"):FireClient(player, "achievement", 0.7)
			end
		end
	end
	if unlocked &gt; 0 then
		DataManager.notify(player, true)
	end
	return unlocked
end

--- Liste des succès avec leur progression (pour l'UI)
function AchievementSystem.getList(profile)
	local list = {}
	for _, achievementId in ipairs(GameConfig.AchievementOrder) do
		local achievement = GameConfig.Achievements[achievementId]
		if achievement then
			local value = profile and getStatValue(profile, achievement.Stat) or 0
			table.insert(list, {
				Id = achievementId,
				Name = achievement.Name,
				Desc = achievement.Desc,
				Icon = achievement.Icon,
				Goal = achievement.Goal,
				Reward = achievement.Reward,
				Progress = math.min(value, achievement.Goal),
				Unlocked = profile and profile.achievements[achievementId] or false,
			})
		end
	end
	return list
end

function AchievementSystem.start()
	-- Vérification régulière (toutes les 2s, peu coûteux)
	task.spawn(function()
		while true do
			task.wait(2)
			for _, player in ipairs(Players:GetPlayers()) do
				if DataManager.isLoaded(player) then
					local ok, err = pcall(AchievementSystem.check, player, true)
					if not ok then
						warn("[AchievementSystem] " .. tostring(err))
					end
				end
			end
		end
	end)

	-- À chaque événement clé, on revérifie immédiatement
	DataManager.Events.Rebirth:Connect(function(player)
		AchievementSystem.check(player, false)
	end)

	Net.event("ClaimAchievement").OnServerEvent:Connect(function(player, achievementId)
		-- Les récompenses sont automatiques ; ce remote sert de "ping"
		AchievementSystem.check(player, false)
	end)

	print("[AchievementSystem] Démarré")
end

return AchievementSystem
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item><Item class="ModuleScript" referent="RBX0015">
        <Properties>
          <string name="Name">CharacterSystem</string>
          <ProtectedString name="Source">--!strict
--[[
	CharacterSystem  |  ServerScriptService.Systems.CharacterSystem
	------------------------------------------------------------------
	Applique les TRANSFORMATIONS sur le personnage :
	  • taille (Model:ScaleTo)
	  • vitesse de déplacement (amélioration)
	  • aura / particules / traînée / lumière selon le tier
	  • titre au-dessus de la tête (BillboardGui) + puissance
	  • mode Géant (événement)
	  • réapplication automatique après un respawn

	Le client ajoute en plus des effets locaux (EffectsController) : il lit
	les attributs "TransformTier" et "TitleId" posés ici.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local Formulas = require(Modules:WaitForChild("Formulas"))
local Net = require(Modules:WaitForChild("Net"))

local DataManager = require(script.Parent.DataManager)

local CharacterSystem = {}

CharacterSystem.sizeMultiplier = 1 -- modifié par EventManager (Giant Mode)

local state: { [Player]: any } = {}

local function clearEffects(character: Model)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	for _, child in ipairs(root:GetChildren()) do
		if child:IsA("ParticleEmitter") or child:IsA("PointLight") or child:IsA("Trail") or child:IsA("Attachment") then
			if child:GetAttribute("TransformFx") then
				child:Destroy()
			end
		end
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		local oldGui = character:FindFirstChild("TitleGui")
		if oldGui then
			oldGui:Destroy()
		end
	end
end

local function buildTitle(character: Model, profile)
	local head = character:FindFirstChild("Head")
	if not head then
		return
	end
	local existing = character:FindFirstChild("TitleGui")
	if existing then
		existing:Destroy()
	end

	local titleGui = Instance.new("BillboardGui")
	titleGui.Name = "TitleGui"
	titleGui.Size = UDim2.fromOffset(240, 64)
	titleGui.StudsOffset = Vector3.new(0, 3.2, 0)
	titleGui.AlwaysOnTop = false
	titleGui.MaxDistance = 250
	titleGui.Adornee = head
	titleGui.Parent = character

	local titleData = nil
	for _, title in ipairs(GameConfig.Titles) do
		if title.Id == profile.titleSelected then
			titleData = title
			break
		end
	end

	local label = Instance.new("TextLabel")
	label.Name = "TitleLabel"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 0.55)
	label.Font = Enum.Font.FredokaOne
	label.Text = (titleData and titleData.Name) or "Noob"
	label.TextColor3 = (titleData and titleData.Color) or Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0.35
	label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	label.TextScaled = true
	label.Parent = titleGui

	local powerLabel = Instance.new("TextLabel")
	powerLabel.Name = "PowerLabel"
	powerLabel.BackgroundTransparency = 1
	powerLabel.Position = UDim2.fromScale(0, 0.52)
	powerLabel.Size = UDim2.fromScale(1, 0.42)
	powerLabel.Font = Enum.Font.GothamBold
	powerLabel.Text = Formulas.formatNumber(profile.power) .. " ⚡"
	powerLabel.TextColor3 = Color3.fromRGB(255, 235, 150)
	powerLabel.TextStrokeTransparency = 0.4
	powerLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	powerLabel.TextScaled = true
	powerLabel.Parent = titleGui
end

local function applyAura(character: Model, tier, hasCosmetics: boolean)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return
	end

	if tier.ParticleRate and tier.ParticleRate &gt; 0 then
		local emitter = Instance.new("ParticleEmitter")
		emitter:SetAttribute("TransformFx", true)
		emitter.Name = "TransformAura"
		emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		emitter.Color = ColorSequence.new(tier.Aura)
		emitter.LightEmission = 0.8
		emitter.LightInfluence = 0
		emitter.Rate = math.min(tier.ParticleRate, 60)
		emitter.Lifetime = NumberRange.new(0.6, 1.4)
		emitter.Speed = NumberRange.new(2, 5)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1.2),
			NumberSequenceKeypoint.new(1, 0),
		})
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.1),
			NumberSequenceKeypoint.new(1, 1),
		})
		emitter.Parent = root

		local light = Instance.new("PointLight")
		light:SetAttribute("TransformFx", true)
		light.Name = "TransformLight"
		light.Color = tier.Aura
		light.Brightness = math.min(1 + tier.Tier * 0.35, 5)
		light.Range = 14 + tier.Tier * 3
		light.Parent = root
	end

	-- Traînée (à partir du tier 4) ou cosmétique VIP
	if tier.Tier &gt;= 4 or hasCosmetics then
		local top = Instance.new("Attachment")
		top:SetAttribute("TransformFx", true)
		top.Name = "TrailTop"
		top.Position = Vector3.new(0, 1.4, 0)
		top.Parent = root

		local bottom = Instance.new("Attachment")
		bottom:SetAttribute("TransformFx", true)
		bottom.Name = "TrailBottom"
		bottom.Position = Vector3.new(0, -1.4, 0)
		bottom.Parent = root

		local trail = Instance.new("Trail")
		trail:SetAttribute("TransformFx", true)
		trail.Name = "TransformTrail"
		trail.Attachment0 = top
		trail.Attachment1 = bottom
		trail.Color = ColorSequence.new(hasCosmetics and Color3.fromRGB(255, 215, 0) or tier.Aura)
		trail.Lifetime = 0.7
		trail.MinLength = 0
		trail.WidthScale = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1.4),
			NumberSequenceKeypoint.new(1, 0),
		})
		trail.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		})
		trail.Parent = root
	end
end

--- Applique la transformation / le titre / la vitesse au personnage.
function CharacterSystem.refresh(player: Player)
	local profile = DataManager.getProfile(player)
	local character = player.Character
	if not profile or not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root then
		return
	end

	local tierIndex = Formulas.getTransformIndex(profile.power)
	local tier = GameConfig.Transformations[tierIndex]
	local playerState = state[player]
	if not playerState then
		playerState = {}
		state[player] = playerState
	end

	local targetScale = tier.Size * CharacterSystem.sizeMultiplier
	local tierChanged = playerState.tier ~= tierIndex
	local scaleChanged = playerState.scale == nil or math.abs(playerState.scale - targetScale) &gt; 0.01
	local titleChanged = playerState.title ~= profile.titleSelected

	if tierChanged or scaleChanged then
		local ok, err = pcall(function()
			(character :: Model):ScaleTo(targetScale)
		end)
		if not ok then
			warn("[CharacterSystem] ScaleTo : " .. tostring(err))
		end
		playerState.scale = targetScale
		player:SetAttribute("CharacterScale", targetScale)
	end

	if tierChanged then
		clearEffects(character)
		applyAura(character, tier, profile.gamePasses and profile.gamePasses.Cosmetics or false)
		playerState.tier = tierIndex
		character:SetAttribute("TransformTier", tierIndex)
		character:SetAttribute("TransformName", tier.Name)
		Net.event("Transformation"):FireClient(player, tierIndex)
		if tierIndex &gt; 1 then
			Net.event("PlaySound"):FireClient(player, "transform", 0.55)
		end
	end

	if titleChanged or tierChanged then
		buildTitle(character, profile)
		playerState.title = profile.titleSelected
	end

	-- Vitesse de déplacement
	local walkSpeed = Formulas.walkSpeed(profile)
	if math.abs(humanoid.WalkSpeed - walkSpeed) &gt; 0.1 then
		humanoid.WalkSpeed = walkSpeed
	end
end

--- Force la reconstruction complète (respawn, changement de titre…)
function CharacterSystem.reset(player: Player)
	state[player] = nil
end

local function updatePowerLabel(player: Player)
	local character = player.Character
	local profile = DataManager.getProfile(player)
	if not character or not profile then
		return
	end
	local titleGui = character:FindFirstChild("TitleGui")
	local powerLabel = titleGui and titleGui:FindFirstChild("PowerLabel")
	if powerLabel and powerLabel:IsA("TextLabel") then
		powerLabel.Text = Formulas.formatNumber(profile.power) .. " ⚡"
	end
end

function CharacterSystem.start()
	local function onCharacter(player: Player, character: Model)
		CharacterSystem.reset(player)
		character:WaitForChild("Humanoid", 10)
		character:WaitForChild("HumanoidRootPart", 10)
		task.wait(0.35)
		CharacterSystem.refresh(player)
	end

	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function(character)
			task.spawn(onCharacter, player, character)
		end)
		if player.Character then
			task.spawn(onCharacter, player, player.Character)
		end
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		player.CharacterAdded:Connect(function(character)
			task.spawn(onCharacter, player, character)
		end)
		if player.Character then
			task.spawn(onCharacter, player, player.Character)
		end
	end

	-- Le titre / la puissance change : on rafraîchit au fil de l'eau
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in ipairs(Players:GetPlayers()) do
				if DataManager.isLoaded(player) then
					local ok, err = pcall(CharacterSystem.refresh, player)
					if not ok then
						warn("[CharacterSystem] refresh : " .. tostring(err))
					end
				end
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(2)
			for _, player in ipairs(Players:GetPlayers()) do
				updatePowerLabel(player)
			end
		end
	end)

	DataManager.Events.Rebirth:Connect(function(player)
		CharacterSystem.reset(player)
		task.wait(0.2)
		CharacterSystem.refresh(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		state[player] = nil
	end)

	print("[CharacterSystem] Démarré")
end

return CharacterSystem
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item><Item class="ModuleScript" referent="RBX0016">
        <Properties>
          <string name="Name">CollectSystem</string>
          <ProtectedString name="Source">--!strict
--[[
	CollectSystem  |  ServerScriptService.Systems.CollectSystem
	------------------------------------------------------------------
	Gère la mécanique principale : ABSORBER DES OBJETS.

	  • Fait apparaître les objets des 6 mondes (pool dynamique, limité
	    pour les mobiles : 40 objets si le monde est vide, 90 sinon).
	  • Traite les clics validés côté serveur (distance + existence +
	    rate limit) → jamais de gain de puissance côté client.
	  • Gère l'absorption automatique (upgrade / game pass).
	  • Gère l'aspirateur de zone (VACUUM) avec cooldown serveur.
	  • Déclenche les effets visuels/sonores chez le bon joueur.
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local Formulas = require(Modules:WaitForChild("Formulas"))
local Net = require(Modules:WaitForChild("Net"))
local Signal = require(Modules:WaitForChild("Signal"))

local DataManager = require(script.Parent.DataManager)
local WorldFactory = require(script.Parent.WorldFactory)

local CollectSystem = {}

CollectSystem.Events = {
	Collected = Signal.new(), -- (player, objectId, power, golden)
	VacuumUsed = Signal.new(), -- (player, count, totalPower)
}

-- Réglages modifiables par EventManager
CollectSystem.goldenChance = 0.05
CollectSystem.spawnMultiplier = 1

-- ============================================================
-- ÉTAT INTERNE
-- ============================================================
local registry: { [BasePart]: any } = {}
local worldCounts: { [number]: number } = {}
local occupiedCells: { [number]: { [string]: boolean } } = {}
local vacuumCooldown: { [Player]: number } = {}
local requestBudget: { [Player]: { tokens: number, last: number } } = {}

local CELL_SIZE = 42

local function getCollectiblesFolder(): Folder
	local folder = Workspace:FindFirstChild("Collectibles")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Collectibles"
		folder.Parent = Workspace
	end
	return folder :: Folder
end

local function worldFolder(index: number): Folder?
	local info = WorldFactory.getWorldInfo(index)
	if info and info.Folder then
		return info.Folder
	end
	return nil
end

-- ============================================================
-- RATE LIMITING (anti-flood / anti-exploit)
-- ============================================================
local function getBudget(player: Player)
	local budget = requestBudget[player]
	if not budget then
		budget = { tokens = GameConfig.Collect.MaxRequestsPerSecond, last = os.clock() }
		requestBudget[player] = budget
	end
	local now = os.clock()
	local elapsed = now - budget.last
	budget.last = now
	budget.tokens = math.min(GameConfig.Collect.MaxRequestsPerSecond, budget.tokens + elapsed * GameConfig.Collect.MaxRequestsPerSecond)
	return budget
end

local function consumeToken(player: Player): boolean
	local budget = getBudget(player)
	if budget.tokens &lt; 1 then
		return false
	end
	budget.tokens = budget.tokens - 1
	return true
end

-- ============================================================
-- SPAWN DES OBJETS
-- ============================================================
local function cellKey(position: Vector3): string
	return string.format("%d_%d", math.floor(position.X / CELL_SIZE), math.floor(position.Z / CELL_SIZE))
end

local function findFreePosition(worldIndex: number): Vector3?
	local info = WorldFactory.getWorldInfo(worldIndex)
	if not info then
		return nil
	end
	local area = info.SpawnArea
	local cells = occupiedCells[worldIndex]
	if not cells then
		cells = {}
		occupiedCells[worldIndex] = cells
	end

	for _ = 1, 24 do
		local x = math.random() * (area.MaxX - area.MinX) + area.MinX
		local z = math.random() * (area.MaxZ - area.MinZ) + area.MinZ
		local y = math.random() * (area.MaxY - area.MinY) + area.MinY
		local position = Vector3.new(x, y, z)
		-- évite le centre (zone du piédestal d'œuf) et les abords du spawn
		local distanceToEgg = (Vector3.new(x, 0, z) - Vector3.new(info.Center.X, 0, info.Center.Z - 60)).Magnitude
		local distanceToSpawn = (Vector3.new(x, 0, z) - Vector3.new(info.Center.X, 0, info.Center.Z + 280)).Magnitude
		if distanceToEgg &gt; 30 and distanceToSpawn &gt; 60 then
			local key = cellKey(position)
			if not cells[key] then
				cells[key] = true
				return position
			end
		end
	end
	return nil
end

local function chooseObjectId(worldIndex: number): string
	local world = GameConfig.Worlds[worldIndex]
	local weights = world.ObjectWeights
	local total = 0
	for _, weight in pairs(weights) do
		total = total + weight
	end
	local roll = math.random() * total
	local accumulator = 0
	local fallback = world.Objects[1]
	for objectId, weight in pairs(weights) do
		accumulator = accumulator + weight
		if roll &lt;= accumulator then
			return objectId
		end
	end
	return fallback
end

local function despawn(part: BasePart, notifyRespawn: boolean)
	local data = registry[part]
	if not data then
		return
	end
	registry[part] = nil

	local worldIndex = data.worldIndex
	worldCounts[worldIndex] = math.max(0, (worldCounts[worldIndex] or 1) - 1)
	local cells = occupiedCells[worldIndex]
	if cells then
		cells[cellKey(data.position)] = nil
	end
	part:Destroy()

	if notifyRespawn then
		task.delay(GameConfig.Collect.RespawnTime, function()
			CollectSystem.spawnOne(worldIndex)
		end)
	end
end

--- Crée un objet à absorber dans un monde donné.
function CollectSystem.spawnOne(worldIndex: number, forcedObjectId: string?, forcedPosition: Vector3?)
	local world = GameConfig.Worlds[worldIndex]
	if not world then
		return nil
	end
	local target = CollectSystem.getWorldTarget(worldIndex)
	if (worldCounts[worldIndex] or 0) &gt;= target then
		return nil
	end

	local objectId = forcedObjectId or chooseObjectId(worldIndex)
	local objectData = Formulas.getObjectData(objectId)
	if not objectData then
		return nil
	end
	local position = forcedPosition or findFreePosition(worldIndex)
	if not position then
		return nil
	end

	local golden = math.random() &lt; CollectSystem.goldenChance

	local part = Instance.new("Part")
	part.Name = objectId
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Color = golden and Color3.fromRGB(255, 215, 0) or objectData.Color
	part.Material = golden and Enum.Material.Neon or objectData.Material
	part.Size = objectData.Size
	if objectData.Shape == "Ball" then
		part.Shape = Enum.PartType.Ball
	elseif objectData.Shape == "Cylinder" then
		part.Shape = Enum.PartType.Cylinder
		part.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
	else
		part.CFrame = CFrame.new(position) * CFrame.Angles(0, math.rad(math.random(0, 359)), 0)
	end
	if part.Shape == Enum.PartType.Ball or part.Shape == Enum.PartType.Block then
		part.CFrame = CFrame.new(position) * CFrame.Angles(0, math.rad(math.random(0, 359)), 0)
	end
	part.Position = position

	-- Petit marqueur visuel pour les objets dorés
	if golden then
		local light = Instance.new("PointLight")
		light.Brightness = 2
		light.Range = 22
		light.Color = Color3.fromRGB(255, 215, 0)
		light.Parent = part
	end

	local power = Formulas.objectPower(worldIndex, objectId, golden)
	part:SetAttribute("ObjectId", objectId)
	part:SetAttribute("WorldIndex", worldIndex)
	part:SetAttribute("Power", power)
	part:SetAttribute("Golden", golden)

	registry[part] = {
		worldIndex = worldIndex,
		objectId = objectId,
		power = power,
		golden = golden,
		position = position,
	}
	worldCounts[worldIndex] = (worldCounts[worldIndex] or 0) + 1
	part.Parent = getCollectiblesFolder()
	return part
end

--- Nombre d'objets visés pour un monde (optimisation mobile)
function CollectSystem.getWorldTarget(worldIndex: number): number
	local hasPlayers = CollectSystem.worldOccupancy and (CollectSystem.worldOccupancy[worldIndex] or 0) &gt; 0
	local base = hasPlayers and GameConfig.Collect.MaxActivePerWorld or 34
	return math.floor(base * CollectSystem.spawnMultiplier)
end

--- Remplit un monde jusqu'à sa cible
function CollectSystem.fillWorld(worldIndex: number)
	local target = CollectSystem.getWorldTarget(worldIndex)
	local created = 0
	for _ = 1, target do
		if (worldCounts[worldIndex] or 0) &gt;= target then
			break
		end
		if CollectSystem.spawnOne(worldIndex) then
			created = created + 1
		else
			break
		end
	end
	return created
end

function CollectSystem.counts()
	return worldCounts
end

-- ============================================================
-- ABSORPTION
-- ============================================================
local function awardPower(player: Player, worldIndex: number, objectId: string, basePower: number, golden: boolean, position: Vector3, silent: boolean?)
	local profile = DataManager.getProfile(player)
	if not profile then
		return 0
	end

	local multiplier = DataManager.getPowerMultiplier(player)
	local power = math.floor(basePower * multiplier)
	if power &lt; 1 then
		power = 1
	end
	DataManager.addPower(player, power, objectId)

	-- Pièces
	local coinMultiplier = Formulas.totalCoinMultiplier(profile, profile.gamePasses)
	local coins = math.max(1, math.floor(power * coinMultiplier))
	DataManager.addCoins(player, coins)

	DataManager.addStat(player, "collected", 1)

	-- Retour visuel / sonore au joueur (pas un remote par objet en auto-collect :
	-- collectRadius envoie un seul effet groupé à la fin)
	if not silent then
		local color = golden and "ffd700" or "8affc1"
		Net.event("EffectBurst"):FireClient(player, position, color, power)
		Net.event("PlaySound"):FireClient(player, golden and "golden" or "absorb", 0.6)
	end

	CollectSystem.Events.Collected:Fire(player, objectId, power, golden)
	DataManager.notify(player)
	return power
end

--- Tente d'absorber un objet précis (clic client validé).
function CollectSystem.tryCollect(player: Player, part: any): boolean
	if typeof(part) ~= "Instance" or not part:IsA("BasePart") then
		return false
	end
	local data = registry[part]
	if not data then
		return false
	end
	local profile = DataManager.getProfile(player)
	if not profile then
		return false
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end

	-- ANTI-CHEAT 1 : portée
	local distance = ((root :: BasePart).Position - data.position).Magnitude
	if distance &gt; GameConfig.Collect.ClickRadius then
		return false
	end

	-- ANTI-CHEAT 2 : rate limit
	if not consumeToken(player) then
		return false
	end

	-- ANTI-CHEAT 3 : le joueur doit être dans le bon monde
	if profile.world ~= data.worldIndex then
		return false
	end

	despawn(part, true)
	awardPower(player, data.worldIndex, data.objectId, data.power, data.golden, data.position)
	return true
end

--- Absorbe tous les objets dans un rayon (auto-collect / vacuum).
function CollectSystem.collectRadius(player: Player, radius: number, silent: boolean?): (number, number)
	local profile = DataManager.getProfile(player)
	if not profile then
		return 0, 0
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return 0, 0
	end
	local origin = (root :: BasePart).Position
	local worldIndex = profile.world

	local toCollect = {}
	for part, data in pairs(registry) do
		if data.worldIndex == worldIndex then
			if (data.position - origin).Magnitude &lt;= radius then
				table.insert(toCollect, part)
			end
		end
	end

	if #toCollect == 0 then
		return 0, 0
	end

	local totalPower = 0
	local collectedCount = 0
	for _, part in ipairs(toCollect) do
		local data = registry[part]
		if data then
			local basePower = data.power
			despawn(part, true)
			totalPower = totalPower + awardPower(player, data.worldIndex, data.objectId, basePower, data.golden, data.position, silent)
			collectedCount = collectedCount + 1
		end
	end

	if not silent and collectedCount &gt; 0 then
		Net.event("EffectBurst"):FireClient(player, origin, "8affc1", totalPower)
		Net.event("PlaySound"):FireClient(player, "vacuum", 0.8)
		Net.event("CameraShake"):FireClient(player, math.min(0.7, 0.15 + collectedCount * 0.01))
	end
	return collectedCount, totalPower
end

-- ============================================================
-- REMOTES
-- ============================================================
local function setupRemotes()
	Net.event("CollectRequest").OnServerEvent:Connect(function(player, part)
		if not DataManager.isLoaded(player) then
			return
		end
		CollectSystem.tryCollect(player, part)
	end)

	Net.event("VacuumRequest").OnServerEvent:Connect(function(player)
		local profile = DataManager.getProfile(player)
		if not profile then
			return
		end
		local now = os.clock()
		local last = vacuumCooldown[player] or 0
		local cooldown = Formulas.vacuumCooldown(profile)
		if now - last &lt; cooldown then
			return
		end
		vacuumCooldown[player] = now

		local radius = Formulas.vacuumRadius(profile)
		local count, totalPower = CollectSystem.collectRadius(player, radius, false)
		if count &gt; 0 then
			DataManager.addStat(player, "vacuums", 1)
			CollectSystem.Events.VacuumUsed:Fire(player, count, totalPower)
			DataManager.notify(player)
		end
	end)
end

-- ============================================================
-- ABSORPTION AUTOMATIQUE
-- ============================================================
local function autoCollectLoop()
	while true do
		task.wait(0.25)
		for _, player in ipairs(Players:GetPlayers()) do
			local profile = DataManager.getProfile(player)
			if profile then
				local hasGamePass = profile.gamePasses and profile.gamePasses.AutoCollect
				local radius = Formulas.autoCollectRadius(profile, hasGamePass)
				if radius &gt; 0 then
					local nextTick = player:GetAttribute("AutoCollectNext")
					if not nextTick or os.clock() &gt;= nextTick then
						local interval = Formulas.autoCollectInterval(profile)
						player:SetAttribute("AutoCollectNext", os.clock() + interval)
						local count = CollectSystem.collectRadius(player, radius, true)
						if count &gt; 0 then
							Net.event("PlaySound"):FireClient(player, "auto", 0.25)
						end
					end
				end
			end
		end
	end
end

-- ============================================================
-- MAINTENANCE (remplissage / nettoyage)
-- ============================================================
local function maintenanceLoop()
	while true do
		task.wait(4)
		for index = 1, #GameConfig.Worlds do
			local target = CollectSystem.getWorldTarget(index)
			local current = worldCounts[index] or 0
			if current &lt; target then
				for _ = 1, math.min(12, target - current) do
					if not CollectSystem.spawnOne(index) then
						break
					end
				end
			elseif current &gt; target + 10 then
				-- trop d'objets (le monde s'est vidé) : on en retire
				local removed = 0
				for part in pairs(registry) do
					if registry[part].worldIndex == index then
						despawn(part, false)
						removed = removed + 1
						if removed &gt;= 10 then
							break
						end
					end
				end
			end
		end
	end
end

-- ============================================================
-- CYCLE DE VIE
-- ============================================================
function CollectSystem.start()
	setupRemotes()

	-- Occupation des mondes (pour l'optimisation mobile)
	CollectSystem.worldOccupancy = {}

	Players.PlayerRemoving:Connect(function(player)
		vacuumCooldown[player] = nil
		requestBudget[player] = nil
	end)

	-- Remplissage initial
	for index = 1, #GameConfig.Worlds do
		task.spawn(function()
			CollectSystem.fillWorld(index)
		end)
	end

	task.spawn(autoCollectLoop)
	task.spawn(maintenanceLoop)

	-- Nettoyage du registry des objets détruits par autre chose
	RunService.Heartbeat:Connect(function()
		for part in pairs(registry) do
			if not part.Parent then
				local data = registry[part]
				registry[part] = nil
				if data then
					worldCounts[data.worldIndex] = math.max(0, (worldCounts[data.worldIndex] or 1) - 1)
				end
			end
		end
	end)

	print("[CollectSystem] Démarré")
end

return CollectSystem
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item><Item class="ModuleScript" referent="RBX0017">
        <Properties>
          <string name="Name">DailyRewardSystem</string>
          <ProtectedString name="Source">--!strict
--[[
	DailyRewardSystem  |  ServerScriptService.Systems.DailyRewardSystem
	------------------------------------------------------------------
	• Récompense quotidienne (7 jours à la suite, puis reset du cycle)
	• Système de série (streak) avec cooldown de 20 h
	• Bonus de boost temporaire et œuf gratuit le 7e jour
	• Gains hors-ligne : si le joueur a l'absorption automatique, il
	  récupère une partie de sa production pendant son absence
	  (plafonnée à 8 h, calculée côté serveur uniquement)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local Formulas = require(Modules:WaitForChild("Formulas"))
local Net = require(Modules:WaitForChild("Net"))

local DataManager = require(script.Parent.DataManager)
local PetSystem = require(script.Parent.PetSystem)

local DailyRewardSystem = {}

local function isAvailable(profile): boolean
	return (os.time() - (profile.daily.lastClaim or 0)) &gt;= GameConfig.DailyResetSeconds
end

function DailyRewardSystem.getStatus(profile)
	if not profile then
		return { available = false, nextAt = 0, dayIndex = 1, streak = 0 }
	end
	local available = isAvailable(profile)
	local remaining = math.max(0, GameConfig.DailyResetSeconds - (os.time() - profile.daily.lastClaim))
	return {
		available = available,
		remaining = available and 0 or remaining,
		nextAt = profile.daily.lastClaim + GameConfig.DailyResetSeconds,
		dayIndex = profile.daily.dayIndex,
		streak = profile.daily.streak,
	}
end

function DailyRewardSystem.claim(player: Player): boolean
	local profile = DataManager.getProfile(player)
	if not profile then
		return false
	end
	if not isAvailable(profile) then
		local remaining = GameConfig.DailyResetSeconds - (os.time() - profile.daily.lastClaim)
		Net.event("Notify"):FireClient(player, "⏳ Reviens dans " .. Formulas.formatTime(remaining), "ff9f43", "⏳")
		return false
	end

	local now = os.time()
	-- Si le joueur a raté plus de 2 jours, la série retombe à 0
	if profile.daily.lastClaim &gt; 0 and (now - profile.daily.lastClaim) &gt; (GameConfig.DailyResetSeconds * 2.5) then
		profile.daily.streak = 0
		profile.daily.dayIndex = 1
	end

	local dayIndex = math.clamp(profile.daily.dayIndex or 1, 1, #GameConfig.DailyRewards)
	local reward = GameConfig.DailyRewards[dayIndex]

	profile.daily.lastClaim = now
	profile.daily.streak = (profile.daily.streak or 0) + 1
	profile.daily.dayIndex = (dayIndex % #GameConfig.DailyRewards) + 1

	profile.coins = profile.coins + (reward.Coins or 0)
	DataManager.addStat(player, "dailies", 1)

	if reward.BoostMinutes and reward.BoostMinutes &gt; 0 then
		profile.boost = {
			mult = math.max(2, profile.boost and profile.boost.mult or 1),
			endsAt = os.time() + reward.BoostMinutes * 60,
		}
		Net.event("BoostUpdate"):FireClient(player, profile.boost.mult, profile.boost.endsAt)
	end

	if reward.FreeEgg and GameConfig.Eggs[reward.FreeEgg] then
		PetSystem.openEgg(player, reward.FreeEgg, 1)
	end

	Net.event("Notify"):FireClient(
		player,
		string.format("📅 Jour %d réclamé ! +%s 🪙  (série : %d)", dayIndex, Formulas.formatNumber(reward.Coins), profile.daily.streak),
		"8affc1",
		"📅"
	)
	Net.event("PlaySound"):FireClient(player, "daily", 0.7)
	Net.event("DailyAvailable"):FireClient(player, false)
	DataManager.notify(player, true)
	return true
end

-- ============================================================
-- GAINS HORS-LIGNE
-- ============================================================
local function computeOfflineEarnings(profile): number
	local autoLevel = (profile.upgrades and profile.upgrades.AutoCollect) or 0
	local hasPass = profile.gamePasses and profile.gamePasses.AutoCollect
	if autoLevel &lt;= 0 and not hasPass then
		return 0
	end
	local lastSeen = profile.__previousLastSeen or profile.lastSeen or os.time()
	local secondsAway = math.clamp(os.time() - lastSeen, 0, GameConfig.MaxOfflineHours * 3600)
	if secondsAway &lt; 300 then
		return 0
	end
	-- estimation : 6 objets/seconde × puissance moyenne du monde courant × 0.35
	local worldIndex = math.clamp(profile.world or 1, 1, #GameConfig.Worlds)
	local world = GameConfig.Worlds[worldIndex]
	local avgObjectPower = 0
	local weightSum = 0
	for objectId, weight in pairs(world.ObjectWeights) do
		local data = Formulas.getObjectData(objectId)
		if data then
			avgObjectPower = avgObjectPower + data.Power * weight
			weightSum = weightSum + weight
		end
	end
	if weightSum == 0 then
		return 0
	end
	avgObjectPower = (avgObjectPower / weightSum) * world.ValueMult
	local estimated = avgObjectPower * 4 * secondsAway * 0.35 * DataManager.getPowerMultiplierFor(profile)
	return math.floor(estimated)
end

function DailyRewardSystem.grantOfflineEarnings(player: Player, profile)
	local earnings = computeOfflineEarnings(profile)
	if earnings &lt;= 0 then
		return
	end
	earnings = math.min(earnings, 1e12)
	DataManager.addPower(player, earnings, "offline")
	local coins = math.floor(earnings * Formulas.totalCoinMultiplier(profile, profile.gamePasses))
	DataManager.addCoins(player, coins)
	task.delay(2, function()
		if player.Parent then
			Net.event("Notify"):FireClient(
				player,
				string.format("💤 Gains hors-ligne : +%s ⚡ et +%s 🪙", Formulas.formatNumber(earnings), Formulas.formatNumber(coins)),
				"8affc1",
				"💤"
			)
			DataManager.notify(player, true)
		end
	end)
end

-- ============================================================
-- DÉMARRAGE
-- ============================================================
function DailyRewardSystem.start()
	Net.event("ClaimDaily").OnServerEvent:Connect(function(player)
		DailyRewardSystem.claim(player)
	end)

	DataManager.Events.Loaded:Connect(function(player, profile)
		task.wait(1.5)
		Net.event("DailyAvailable"):FireClient(player, isAvailable(profile))
		if profile.boost and profile.boost.endsAt &gt; os.time() then
			Net.event("BoostUpdate"):FireClient(player, profile.boost.mult, profile.boost.endsAt)
		end
		DailyRewardSystem.grantOfflineEarnings(player, profile)
	end)

	print("[DailyRewardSystem] Démarré")
end

return DailyRewardSystem
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item><Item class="ModuleScript" referent="RBX0018">
        <Properties>
          <string name="Name">DataManager</string>
          <ProtectedString name="Source">--!strict
--[[
	DataManager  |  ServerScriptService.Systems.DataManager
	------------------------------------------------------------------
	Gère TOUT ce qui touche à la sauvegarde d'un joueur.

	Fonctionnalités :
	  • Chargement avec 5 tentatives + backoff exponentiel
	  • Verrou de session (évite la duplication de données entre serveurs)
	  • Sauvegarde automatique toutes les X secondes
	  • Sauvegarde à la déconnexion + BindToClose
	  • Copie de secours (clé _backup) si les données sont corrompues
	  • Migration / validation des profils (ProfileTemplate.migrate)
	  • Plus jamais d'écrasement de données si le chargement échoue
	    (__saveBlocked) : on retente le chargement en arrière-plan.

	API publique (utilisée par tous les autres systèmes) :
	  DataManager.getProfile(player)        -&gt; profile | nil
	  DataManager.waitForProfile(player)    -&gt; profile
	  DataManager.addPower(player, n)       -&gt; n appliqué
	  DataManager.addCoins(player, n)       -&gt; n appliqué
	  DataManager.spendCoins(player, n)     -&gt; bool
	  DataManager.addStat(player, stat, n)
	  DataManager.notify(player)            -&gt; envoie ProfileUpdated au client
	  DataManager.save(player, releaseLock) -&gt; bool
	  DataManager.broadcastProfile(player)
	  DataManager.isLoaded(player)
]]

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local ProfileTemplate = require(Modules:WaitForChild("ProfileTemplate"))
local Net = require(Modules:WaitForChild("Net"))
local Signal = require(Modules:WaitForChild("Signal"))
local Formulas = require(Modules:WaitForChild("Formulas"))

local DataManager = {}

local LOAD_ATTEMPTS = 5
local SAVE_ATTEMPTS = 3
local LOCK_TIMEOUT = 90 -- secondes avant de considérer un verrou comme périmé
local USE_DATASTORE = true -- passer à false pour tester sans DataStore (aucune sauvegarde)

DataManager.Events = {
	Loaded = Signal.new(),    -- (player, profile)
	Unloaded = Signal.new(),  -- (player, profile)
	Changed = Signal.new(),   -- (player, profile)
	PowerGained = Signal.new(), -- (player, amount, profile)
	CoinsGained = Signal.new(), -- (player, amount, profile)
	Rebirth = Signal.new(),   -- (player, profile)
}

local profiles: { [Player]: any } = {}
local saveBlocked: { [Player]: boolean } = {}
local notifyCooldown: { [Player]: number } = {}
local stores: { [string]: GlobalDataStore } = {}

local function getStore(name: string): GlobalDataStore
	local store = stores[name]
	if not store then
		store = DataStoreService:GetDataStore(name)
		stores[name] = store
	end
	return store
end

local function getKey(player: Player): string
	return GameConfig.DataStoreKeyPrefix .. tostring(player.UserId)
end

local function retry(attempts: number, waitTime: number, fn: (number) -&gt; any): (boolean, any)
	local lastError = nil
	for attempt = 1, attempts do
		local ok, result = pcall(fn, attempt)
		if ok then
			return true, result
		end
		lastError = result
		warn(string.format("[DataManager] tentative %d/%d échouée : %s", attempt, attempts, tostring(result)))
		if attempt &lt; attempts then
			task.wait(waitTime * attempt)
		end
	end
	return false, lastError
end

-- ============================================================
-- LEADERSTATS (affichage tableau des scores Roblox natif)
-- ============================================================
local function setupLeaderstats(player: Player, profile)
	local existing = player:FindFirstChild("leaderstats")
	if existing then
		existing:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"

	local function makeStat(name: string, value: number, order: number)
		local stat = Instance.new("IntValue")
		stat.Name = name
		stat.Value = math.clamp(math.floor(value), -2147483648, 2147483647)
		stat:SetAttribute("Order", order)
		stat.Parent = folder
		return stat
	end

	makeStat("Power", profile.power, 1)
	makeStat("Rebirths", profile.rebirths, 2)
	makeStat("Coins", profile.coins, 3)
	folder.Parent = player
end

function DataManager.syncLeaderstats(player: Player, profile)
	local folder = player:FindFirstChild("leaderstats")
	if not folder then
		return
	end
	local powerValue = folder:FindFirstChild("Power")
	local rebirthValue = folder:FindFirstChild("Rebirths")
	local coinValue = folder:FindFirstChild("Coins")
	if powerValue then
		powerValue.Value = math.clamp(math.floor(profile.power), -2147483648, 2147483647)
	end
	if rebirthValue then
		rebirthValue.Value = math.clamp(math.floor(profile.rebirths), -2147483648, 2147483647)
	end
	if coinValue then
		coinValue.Value = math.clamp(math.floor(profile.coins), -2147483648, 2147483647)
	end
end

-- ============================================================
-- CHARGEMENT
-- ============================================================
local function acquireLockAndLoad(player: Player): (any, boolean)
	local store = getStore(GameConfig.DataStoreName)
	local key = getKey(player)
	local lockOk = false
	local data = nil

	local success, result = retry(LOAD_ATTEMPTS, 1.2, function()
		return store:UpdateAsync(key, function(oldEntry)
			local now = os.time()
			if type(oldEntry) == "table" and type(oldEntry.lock) == "table" then
				local otherJob = oldEntry.lock.jobId
				local lockedAt = tonumber(oldEntry.lock.at) or 0
				local isStale = (now - lockedAt) &gt; LOCK_TIMEOUT
				if otherJob and otherJob ~= game.JobId and not isStale then
					return nil -- verrou détenu par un autre serveur : on abandonne
				end
			end

			local entry = {}
			if type(oldEntry) == "table" then
				entry = oldEntry
			end
			if type(entry.data) == "table" then
				data = entry.data
			end
			entry.lock = { jobId = game.JobId, at = now }
			entry.version = GameConfig.DataVersion
			-- la copie de secours est rafraîchie aussi
			return entry
		end)
	end)

	lockOk = success and result ~= nil
	return data, lockOk
end

-- Récupère la copie de secours si les données principales sont illisibles
local function readBackup(player: Player)
	local backupStore = getStore(GameConfig.DataStoreName .. "_Backup")
	local ok, data = pcall(function()
		return backupStore:GetAsync(getKey(player))
	end)
	if ok and type(data) == "table" then
		return data
	end
	return nil
end

local function finishLoad(player: Player, profile, isFresh: boolean)
	profiles[player] = profile
	saveBlocked[player] = false
	-- On garde l'horodatage de la session précédente : il sert à calculer
	-- les gains hors-ligne (DailyRewardSystem). La clé "__" n'est jamais
	-- sauvegardée (voir serialize()).
	profile.__previousLastSeen = profile.lastSeen or os.time()
	profile.lastSeen = os.time()

	setupLeaderstats(player, profile)
	DataManager.syncLeaderstats(player, profile)

	DataManager.Events.Loaded:Fire(player, profile)

	-- Si le joueur a déjà chargé son UI, on lui envoie l'état immédiatement
	Net.event("ProfileUpdated"):FireClient(player, ProfileTemplate.toPublic(profile))
	if profile.power &gt; 0 or not isFresh then
		Net.event("Notify"):FireClient(player, "Bienvenue ! Tes données sont chargées. 💾", "8affc1", "💾")
	end
end

function DataManager.load(player: Player)
	local data, lockOk = acquireLockAndLoad(player)

	if data == nil and not lockOk then
		-- Échec total du DataStore : on laisse jouer mais SANS sauvegarder
		-- pour ne jamais écraser une vraie sauvegarde.
		warn("[DataManager] chargement impossible pour " .. player.Name .. " → mode invité (sauvegarde bloquée)")
		saveBlocked[player] = true
		local profile = ProfileTemplate.new()
		profile.__saveBlocked = true
		profiles[player] = profile
		profile.__previousLastSeen = profile.lastSeen
		profile.lastSeen = os.time()
		setupLeaderstats(player, profile)
		DataManager.Events.Loaded:Fire(player, profile)
		Net.event("Notify"):FireClient(player, "⚠️ Sauvegarde indisponible, rechargement en cours…", "ff9f43", "⚠️")
		-- on retente en arrière-plan
		task.spawn(function()
			for attempt = 1, 10 do
				task.wait(15)
				if not player.Parent then
					return
				end
				local retryData, retryLock = acquireLockAndLoad(player)
				if retryData ~= nil or retryLock then
					local migrated = ProfileTemplate.migrate(retryData)
					profiles[player] = migrated
					saveBlocked[player] = false
					DataManager.syncLeaderstats(player, migrated)
					DataManager.Events.Loaded:Fire(player, migrated)
					DataManager.notify(player)
					Net.event("Notify"):FireClient(player, "✅ Sauvegarde rétablie !", "8affc1", "✅")
					return
				end
			end
		end)
		return profile
	end

	if data == nil then
		-- aucune donnée existante (première visite) mais le verrou a été pris
		local backup = readBackup(player)
		if backup then
			warn("[DataManager] données principales absentes, restauration depuis la copie de secours : " .. player.Name)
			data = backup
		end
	end

	local profile = ProfileTemplate.migrate(data)
	finishLoad(player, profile, data == nil)
	return profile
end

-- ============================================================
-- SAUVEGARDE
-- ============================================================
local function serialize(profile)
	-- On ne sauvegarde jamais les champs internes
	local payload = {}
	for key, value in pairs(profile) do
		if string.sub(key, 1, 2) ~= "__" and key ~= "gamePasses" then
			payload[key] = value
		end
	end
	payload.lastSeen = os.time()
	payload.version = GameConfig.DataVersion
	return payload
end

function DataManager.save(player: Player, releaseLock: boolean?): boolean
	local profile = profiles[player]
	if not profile then
		return false
	end
	if saveBlocked[player] or profile.__saveBlocked then
		return false
	end
	if not USE_DATASTORE then
		return true
	end

	local payload = serialize(profile)
	local key = getKey(player)
	local store = getStore(GameConfig.DataStoreName)

	local ok = retry(SAVE_ATTEMPTS, 1.5, function()
		return store:UpdateAsync(key, function(oldEntry)
			local entry = oldEntry
			if type(entry) ~= "table" then
				entry = {}
			end
			-- Ne jamais écraser les données d'un autre serveur actif
			if type(entry.lock) == "table" then
				local otherJob = entry.lock.jobId
				local lockedAt = tonumber(entry.lock.at) or 0
				if otherJob and otherJob ~= game.JobId and (os.time() - lockedAt) &lt; LOCK_TIMEOUT then
					warn("[DataManager] sauvegarde annulée : verrou détenu par un autre serveur (" .. tostring(otherJob) .. ")")
					return nil
				end
			end
			entry.data = payload
			entry.version = GameConfig.DataVersion
			if releaseLock then
				entry.lock = nil
			else
				entry.lock = { jobId = game.JobId, at = os.time() }
			end
			return entry
		end)
	end)

	if not ok then
		warn("[DataManager] sauvegarde échouée pour " .. player.Name)
		return false
	end

	-- copie de secours (best effort, jamais bloquante)
	task.spawn(function()
		local backupStore = getStore(GameConfig.DataStoreName .. "_Backup")
		pcall(function()
			backupStore:SetAsync(key, payload)
		end)
	end)
	return true
end

-- ============================================================
-- NOTIFICATION CLIENT (throttlée)
-- ============================================================
function DataManager.notify(player: Player, force: boolean?)
	local profile = profiles[player]
	if not profile or not player.Parent then
		return
	end
	local now = os.clock()
	local last = notifyCooldown[player] or 0
	if not force and now - last &lt; 0.1 then
		-- trop rapide : on planifie une notification différée
		if not profile.__notifyPending then
			profile.__notifyPending = true
			task.delay(0.12, function()
				profile.__notifyPending = false
				if profiles[player] == profile then
					DataManager.notify(player, true)
				end
			end)
		end
		return
	end
	notifyCooldown[player] = now

	DataManager.syncLeaderstats(player, profile)
	Net.event("ProfileUpdated"):FireClient(player, ProfileTemplate.toPublic(profile))
	DataManager.Events.Changed:Fire(player, profile)
end

function DataManager.broadcastProfile(player: Player)
	DataManager.notify(player, true)
end

-- ============================================================
-- HELPERS DE PROGRESSION
-- ============================================================
function DataManager.getProfile(player: Player)
	return profiles[player]
end

function DataManager.isLoaded(player: Player): boolean
	return profiles[player] ~= nil
end

function DataManager.waitForProfile(player: Player, timeout: number?)
	local startTime = os.clock()
	local limit = timeout or 30
	while os.clock() - startTime &lt; limit do
		local profile = profiles[player]
		if profile then
			return profile
		end
		if not player.Parent then
			return nil
		end
		task.wait(0.1)
	end
	return nil
end

function DataManager.getProfiles()
	return profiles
end

--- Ajoute de la puissance. Renvoie le montant réellement appliqué.
function DataManager.addPower(player: Player, amount: number, note: string?): number
	local profile = profiles[player]
	if not profile then
		return 0
	end
	if not (amount == amount) or amount == math.huge or amount &lt;= 0 then
		return 0
	end
	amount = math.floor(amount)
	profile.power = profile.power + amount
	profile.totalPower = profile.totalPower + amount
	if profile.power &gt; profile.bestPower then
		profile.bestPower = profile.power
	end
	DataManager.Events.PowerGained:Fire(player, amount, profile)
	return amount
end

--- Ajoute des pièces.
function DataManager.addCoins(player: Player, amount: number): number
	local profile = profiles[player]
	if not profile then
		return 0
	end
	if not (amount == amount) or amount &lt;= 0 then
		return 0
	end
	amount = math.floor(amount)
	profile.coins = profile.coins + amount
	DataManager.Events.CoinsGained:Fire(player, amount, profile)
	return amount
end

--- Dépense des pièces si possible (atomique côté serveur).
function DataManager.spendCoins(player: Player, amount: number): boolean
	local profile = profiles[player]
	if not profile then
		return false
	end
	if amount &lt;= 0 or profile.coins &lt; amount then
		return false
	end
	profile.coins = profile.coins - amount
	DataManager.notify(player)
	return true
end

--- Incrémente une statistique de succès.
function DataManager.addStat(player: Player, statName: string, amount: number?)
	local profile = profiles[player]
	if not profile then
		return
	end
	if profile.stats[statName] == nil then
		return
	end
	profile.stats[statName] = profile.stats[statName] + (amount or 1)
end

--- Fixe une statistique (ex: maxWorld, streak)
function DataManager.setStat(player: Player, statName: string, value: number)
	local profile = profiles[player]
	if not profile then
		return
	end
	if profile.stats[statName] == nil then
		return
	end
	profile.stats[statName] = math.max(profile.stats[statName], value)
end

function DataManager.getGamePasses(player: Player)
	local profile = profiles[player]
	if not profile then
		return {}
	end
	return profile.gamePasses
end

--- Multiplicateur d'événement actif (rempli par EventManager)
DataManager.eventMultiplier = 1
--- Boost temporaire global du joueur, lu par les systèmes
function DataManager.getBoostMultiplier(profile): number
	if profile.boost and profile.boost.endsAt &gt; os.time() and profile.boost.mult &gt; 1 then
		return profile.boost.mult
	end
	return 1
end

--- Multiplicateur total courant (utilisé par CollectSystem et l'UI)
function DataManager.getPowerMultiplier(player: Player): number
	local profile = profiles[player]
	if not profile then
		return 1
	end
	return Formulas.totalPowerMultiplier(profile, profile.gamePasses, DataManager.eventMultiplier, DataManager.getBoostMultiplier(profile))
end

--- Multiplicateur total calculé depuis un profil (sans Player).
--- Utilisé par les gains hors-ligne.
function DataManager.getPowerMultiplierFor(profile): number
	if not profile then
		return 1
	end
	return Formulas.totalPowerMultiplier(
		profile,
		profile.gamePasses,
		DataManager.eventMultiplier,
		DataManager.getBoostMultiplier(profile)
	)
end

-- ============================================================
-- CYCLE DE VIE
-- ============================================================
local function onPlayerAdded(player: Player)
	local ok, err = pcall(function()
		DataManager.load(player)
	end)
	if not ok then
		warn("[DataManager] erreur fatale de chargement pour " .. player.Name .. " : " .. tostring(err))
		local profile = ProfileTemplate.new()
		profiles[player] = profile
		saveBlocked[player] = true
		setupLeaderstats(player, profile)
		DataManager.Events.Loaded:Fire(player, profile)
	end
end

local function onPlayerRemoving(player: Player)
	local profile = profiles[player]
	if profile then
		profile.playtime = profile.playtime + 1
		DataManager.save(player, true)
		DataManager.Events.Unloaded:Fire(player, profile)
	end
	profiles[player] = nil
	saveBlocked[player] = nil
	notifyCooldown[player] = nil
end

function DataManager.start()
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerAdded:Connect(function(player)
		task.spawn(onPlayerAdded, player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		task.spawn(onPlayerRemoving, player)
	end)

	-- Sauvegarde automatique
	task.spawn(function()
		while true do
			task.wait(GameConfig.Misc.SaveInterval)
			for player in pairs(profiles) do
				if player.Parent then
					task.spawn(function()
						DataManager.save(player, false)
					end)
				end
			end
		end
	end)

	-- Temps de jeu
	task.spawn(function()
		while true do
			task.wait(60)
			for _, profile in pairs(profiles) do
				profile.playtime = profile.playtime + 60
			end
		end
	end)
end

--- À appeler depuis Bootstrap (BindToClose)
function DataManager.shutdown()
	local threads = {}
	for player in pairs(profiles) do
		table.insert(threads, task.spawn(function()
			DataManager.save(player, true)
		end))
	end
	-- attente max 20s (limite Roblox à la fermeture)
	local deadline = os.clock() + 20
	for _, thread in ipairs(threads) do
		while coroutine.status(thread) ~= "dead" and os.clock() &lt; deadline do
			task.wait(0.1)
		end
	end
end

return DataManager
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item><Item class="ModuleScript" referent="RBX0019">
        <Properties>
          <string name="Name">EventManager</string>
          <ProtectedString name="Source">--!strict
--[[
	EventManager  |  ServerScriptService.Systems.EventManager
	------------------------------------------------------------------
	Un événement aléatoire toutes les 5 minutes (configurable) :

	  🦍 Giant Mode      -&gt; tous les joueurs ×1.8 en taille, puissance ×1.5
	  💰 Money Rain      -&gt; des pièces tombent du ciel dans tous les mondes
	  🌙 Low Gravity     -&gt; gravité divisée par 4
	  ✨ Golden Objects  -&gt; 100% d'objets dorés (×5 puissance)
	  🌪️ Chaos Mode      -&gt; mini-événements imprévisibles en chaîne
	  🍀 Lucky Time      -&gt; gains ×2 et pets rares 2× plus probables

	Chaque événement a un compte à rebours diffusé à tous les clients.
	Le nettoyage est garanti (pcall + liste de "revert").
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local Formulas = require(Modules:WaitForChild("Formulas"))
local Net = require(Modules:WaitForChild("Net"))
local Signal = require(Modules:WaitForChild("Signal"))

local DataManager = require(script.Parent.DataManager)
local CollectSystem = require(script.Parent.CollectSystem)
local CharacterSystem = require(script.Parent.CharacterSystem)
local PetSystem = require(script.Parent.PetSystem)

local EventManager = {}

EventManager.Events = {
	Started = Signal.new(), -- (eventId)
	Ended = Signal.new(),   -- (eventId)
}

EventManager.currentEventId = nil
EventManager.endsAt = 0

local BASE_GRAVITY = 196.2
local BASE_GOLDEN_CHANCE = 0.05
local activeReverts = {}
local participatedThisEvent = {}
local moneyRainParts = {}

local function setRevert(key: string, callback: (() -&gt; ())?)
	if callback then
		activeReverts[key] = callback
	else
		activeReverts[key] = nil
	end
end

local function runReverts()
	for key, callback in pairs(activeReverts) do
		local ok, err = pcall(callback)
		if not ok then
			warn("[EventManager] revert " .. key .. " : " .. tostring(err))
		end
	end
	activeReverts = {}
end

local function announce(eventId: string, message: string, color: string?)
	for _, player in ipairs(Players:GetPlayers()) do
		Net.event("Notify"):FireClient(player, message, color or "ffd700", "🎉")
		Net.event("PlaySound"):FireClient(player, "event", 0.8)
	end
end

local function broadcastEventState(eventId: string?, endsAt: number?)
	Net.event("EventUpdate"):FireAllClients(eventId, endsAt)
end

local function refreshAllCharacters()
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(function()
			local ok, err = pcall(CharacterSystem.refresh, player)
			if not ok then
				warn("[EventManager] refresh : " .. tostring(err))
			end
		end)
	end
end

-- ============================================================
-- EFFETS DES ÉVÉNEMENTS
-- ============================================================
local eventEffects = {}

--- 🦍 Tous les joueurs deviennent géants
eventEffects.GiantMode = function()
	CharacterSystem.sizeMultiplier = 1.8
	DataManager.eventMultiplier = DataManager.eventMultiplier * GameConfig.EventRewards.GiantModePowerMult
	refreshAllCharacters()
	setRevert("giant", function()
		CharacterSystem.sizeMultiplier = 1
		refreshAllCharacters()
	end)
	announce("GiantMode", "🦍 GIANT MODE ! Tout le monde devient GÉANT (puissance ×1.5) !", "ff8c3c")
end

--- 💰 Des pièces tombent du ciel
local function spawnMoneyRain(burst: number?)
	local worldsWithPlayers = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local profile = DataManager.getProfile(player)
		if profile and profile.world &gt; 0 then
			worldsWithPlayers[profile.world] = true
		end
	end
	if next(worldsWithPlayers) == nil then
		worldsWithPlayers[1] = true
	end

	local folder = Workspace:FindFirstChild("MoneyRain")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "MoneyRain"
		folder.Parent = Workspace
	end

	for worldIndex in pairs(worldsWithPlayers) do
		local info = require(script.Parent.WorldFactory).getWorldInfo(worldIndex)
		if info then
			local count = burst or 26
			for _ = 1, count do
				local coin = Instance.new("Part")
				coin.Name = "CoinDrop"
				coin.Shape = Enum.PartType.Cylinder
				coin.Size = Vector3.new(0.6, 3, 3)
				coin.Color = Color3.fromRGB(255, 215, 60)
				coin.Material = Enum.Material.Neon
				coin.Anchored = false
				coin.CanCollide = false
				coin.CanTouch = true
				coin.CastShadow = false
				local x = info.Center.X + math.random(-280, 280)
				local z = info.Center.Z + math.random(-280, 280)
				coin.CFrame = CFrame.new(x, math.random(110, 150), z) * CFrame.Angles(0, 0, math.rad(90))
				coin:SetAttribute("EventCoin", true)

				local light = Instance.new("PointLight")
				light.Color = Color3.fromRGB(255, 220, 80)
				light.Brightness = 1.5
				light.Range = 16
				light.Parent = coin

				coin.Touched:Connect(function(hit)
					if not coin.Parent then
						return
					end
					local character = hit:FindFirstAncestorOfClass("Model")
					local player = character and Players:GetPlayerFromCharacter(character)
					if player then
						local profile = DataManager.getProfile(player)
						if profile then
							local amount = math.max(25, math.floor(GameConfig.EventRewards.MoneyRainCoins * (1 + profile.rebirths * 0.25)))
							DataManager.addCoins(player, amount)
							Net.event("EffectBurst"):FireClient(player, coin.Position, "ffd700", amount)
							Net.event("PlaySound"):FireClient(player, "coin", 0.4)
							DataManager.notify(player)
						end
						coin:Destroy()
					end
				end)

				coin.Parent = folder
				table.insert(moneyRainParts, coin)
			end
		end
	end

	-- Nettoyage des pièces non ramassées
	task.delay(40, function()
		for index = #moneyRainParts, 1, -1 do
			local coin = moneyRainParts[index]
			if coin and coin.Parent then
				coin:Destroy()
			end
			table.remove(moneyRainParts, index)
		end
	end)
end

eventEffects.MoneyRain = function()
	announce("MoneyRain", "💰 MONEY RAIN ! Des pièces tombent du ciel, attrape-les !", "ffd700")
	spawnMoneyRain(34)
	setRevert("moneyrain", function() end)
	-- vagues successives
	for wave = 1, 3 do
		task.delay(wave * 12, function()
			if EventManager.currentEventId == "MoneyRain" then
				spawnMoneyRain(18)
			end
		end)
	end
end

--- 🌙 Gravité réduite
eventEffects.LowGravity = function()
	Workspace.Gravity = BASE_GRAVITY / 4
	setRevert("gravity", function()
		Workspace.Gravity = BASE_GRAVITY
	end)
	announce("LowGravity", "🌙 LOW GRAVITY ! La gravité est divisée par 4, envole-toi !", "a0c8ff")
end

--- ✨ Objets dorés
eventEffects.GoldenObjects = function()
	CollectSystem.goldenChance = 1
	CollectSystem.spawnMultiplier = 1.4
	setRevert("golden", function()
		CollectSystem.goldenChance = BASE_GOLDEN_CHANCE
		CollectSystem.spawnMultiplier = 1
	end)
	announce("GoldenObjects", "✨ GOLDEN OBJECTS ! Tous les objets sont dorés : puissance ×5 !", "ffc832")
end

--- 🍀 Chance doublée
eventEffects.LuckyTime = function()
	DataManager.eventMultiplier = DataManager.eventMultiplier * GameConfig.EventRewards.LuckyTimeMult
	PetSystem.luckyMultiplier = 2
	setRevert("lucky", function()
		PetSystem.luckyMultiplier = 1
	end)
	announce("LuckyTime", "🍀 LUCKY TIME ! Gains ×2 et pets rares 2× plus probables !", "5aff8c")
end

--- 🌪️ Chaos : mini-événements aléatoires en chaîne
eventEffects.ChaosMode = function()
	announce("ChaosMode", "🌪️ CHAOS MODE ! Tout peut arriver... accroche-toi !", "ff3cc8")
	local chaosFunctions = {
		function()
			Workspace.Gravity = BASE_GRAVITY * 0.3
			announce("ChaosMode", "🌀 Gravité mollassonne !", "ff3cc8")
			task.delay(8, function()
				Workspace.Gravity = BASE_GRAVITY
			end)
		end,
		function()
			spawnMoneyRain(12)
			announce("ChaosMode", "💰 Pluie de pièces surprise !", "ffd700")
		end,
		function()
			CollectSystem.goldenChance = 1
			task.delay(8, function()
				CollectSystem.goldenChance = BASE_GOLDEN_CHANCE
			end)
			announce("ChaosMode", "✨ Objets dorés pendant 8 secondes !", "ffc832")
		end,
		function()
			CharacterSystem.sizeMultiplier = 2.2
			refreshAllCharacters()
			task.delay(8, function()
				CharacterSystem.sizeMultiplier = 1
				refreshAllCharacters()
			end)
			announce("ChaosMode", "🦍 GÉANT pendant 8 secondes !", "ff8c3c")
		end,
		function()
			announce("ChaosMode", "🎁 Cadeau du chaos : +puissance pour tous !", "8affc1")
			for _, player in ipairs(Players:GetPlayers()) do
				local profile = DataManager.getProfile(player)
				if profile then
					local bonus = math.max(10, math.floor(profile.power * 0.15))
					DataManager.addPower(player, bonus, "chaos")
					Net.event("EffectBurst"):FireClient(player, player.Character and player.Character:GetPivot().Position or Vector3.zero, "ff3cc8", bonus)
					DataManager.notify(player)
				end
			end
		end,
	}
	for index = 1, 8 do
		task.delay(index * 8, function()
			if EventManager.currentEventId == "ChaosMode" then
				local chaos = chaosFunctions[math.random(1, #chaosFunctions)]
				pcall(chaos)
			end
		end)
	end
	setRevert("chaos", function()
		Workspace.Gravity = BASE_GRAVITY
		CollectSystem.goldenChance = BASE_GOLDEN_CHANCE
		CharacterSystem.sizeMultiplier = 1
		refreshAllCharacters()
	end)
end

-- ============================================================
-- CYCLE DES ÉVÉNEMENTS
-- ============================================================
function EventManager.startEvent(eventId: string)
	local eventData = GameConfig.Events[eventId]
	if not eventData then
		return
	end
	if EventManager.currentEventId then
		EventManager.stopEvent()
	end

	EventManager.currentEventId = eventId
	EventManager.endsAt = os.time() + (eventData.Duration or GameConfig.EventDuration)
	participatedThisEvent = {}

	broadcastEventState(eventId, EventManager.endsAt)
	EventManager.Events.Started:Fire(eventId)

	local effect = eventEffects[eventId]
	if effect then
		local ok, err = pcall(effect)
		if not ok then
			warn("[EventManager] effet " .. eventId .. " : " .. tostring(err))
			EventManager.stopEvent()
			return
		end
	end

	print(string.format("[EventManager] Événement lancé : %s (%d s)", eventData.Name, eventData.Duration or GameConfig.EventDuration))
end

function EventManager.stopEvent()
	local eventId = EventManager.currentEventId
	if not eventId then
		return
	end
	runReverts()
	DataManager.eventMultiplier = 1
	PetSystem.luckyMultiplier = 1
	Workspace.Gravity = BASE_GRAVITY
	CollectSystem.goldenChance = BASE_GOLDEN_CHANCE
	CollectSystem.spawnMultiplier = 1
	CharacterSystem.sizeMultiplier = 1
	refreshAllCharacters()

	EventManager.currentEventId = nil
	EventManager.endsAt = 0
	broadcastEventState(nil, nil)

	local eventData = GameConfig.Events[eventId]
	if eventData then
		announce("", string.format("%s est terminé ! Prochain événement dans %s.", eventData.Name, Formulas.formatTime(GameConfig.EventInterval)), "aaaaaa")
	end
	EventManager.Events.Ended:Fire(eventId)
	print("[EventManager] Événement terminé : " .. eventId)
end

function EventManager.start()
	-- Participation : collecter pendant un événement compte pour un succès
	CollectSystem.Events.Collected:Connect(function(player)
		if EventManager.currentEventId then
			local profile = DataManager.getProfile(player)
			if profile and not participatedThisEvent[player] then
				participatedThisEvent[player] = true
				DataManager.addStat(player, "events", 1)
			end
		end
	end)

	-- Boucle principale
	task.spawn(function()
		task.wait(25) -- laisse le temps aux joueurs de charger
		while true do
			EventManager.startEvent(GameConfig.EventOrder[math.random(1, #GameConfig.EventOrder)])

			local duration = (GameConfig.Events[EventManager.currentEventId] and GameConfig.Events[EventManager.currentEventId].Duration) or GameConfig.EventDuration
			-- compte à rebours : petites mises à jour (les clients calculent en local)
			for _ = 1, duration do
				task.wait(1)
			end

			EventManager.stopEvent()
			task.wait(GameConfig.EventInterval - duration)
		end
	end)

	-- Un joueur qui rejoint pendant un événement reçoit l'état courant
	DataManager.Events.Loaded:Connect(function(player)
		task.wait(1)
		if EventManager.currentEventId then
			Net.event("EventUpdate"):FireClient(player, EventManager.currentEventId, EventManager.endsAt)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		participatedThisEvent[player] = nil
	end)

	print("[EventManager] Démarré (intervalle : " .. GameConfig.EventInterval .. "s)")
end

return EventManager
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item><Item class="ModuleScript" referent="RBX001A">
        <Properties>
          <string name="Name">LeaderboardManager</string>
          <ProtectedString name="Source">--!strict
--[[
	LeaderboardManager  |  ServerScriptService.Systems.LeaderboardManager
	------------------------------------------------------------------
	Deux classements :
	  • SERVEUR : tri en mémoire des joueurs connectés (temps réel)
	  • MONDIAL : OrderedDataStore, top 25 des puissances à vie

	Met aussi à jour le panneau dans le lobby (SurfaceGui) et pousse les
	données aux clients toutes les 8 secondes.
]]

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local Formulas = require(Modules:WaitForChild("Formulas"))
local Net = require(Modules:WaitForChild("Net"))

local DataManager = require(script.Parent.DataManager)

local LeaderboardManager = {}

local orderedStore: OrderedDataStore? = nil
local nameCache: { [number]: string } = {}
local globalCache = {}
local lastGlobalFetch = 0
local lastPush = 0

local function getOrderedStore(): OrderedDataStore?
	if orderedStore then
		return orderedStore
	end
	local ok, store = pcall(function()
		return DataStoreService:GetOrderedDataStore(GameConfig.DataStoreName .. "_GlobalPower")
	end)
	if ok then
		orderedStore = store
		return store
	end
	return nil
end

-- ============================================================
-- CLASSEMENT SERVEUR
-- ============================================================
function LeaderboardManager.getServerTop(limit: number?)
	local list = {}
	for player, profile in pairs(DataManager.getProfiles()) do
		if player.Parent then
			table.insert(list, {
				UserId = player.UserId,
				Name = player.DisplayName,
				Power = math.floor(profile.power),
				BestPower = math.floor(profile.bestPower),
				Rebirths = profile.rebirths,
				Title = profile.titleSelected,
			})
		end
	end
	table.sort(list, function(a, b)
		return a.Power &gt; b.Power
	end)
	local max = limit or GameConfig.Misc.LeaderboardTop
	if #list &gt; max then
		local trimmed = {}
		for index = 1, max do
			trimmed[index] = list[index]
		end
		return trimmed
	end
	return list
end

-- ============================================================
-- CLASSEMENT MONDIAL
-- ============================================================
local function resolveName(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	if ok and name then
		nameCache[userId] = name
		return name
	end
	nameCache[userId] = "Joueur " .. tostring(userId)
	return nameCache[userId]
end

function LeaderboardManager.submitScore(player: Player)
	local profile = DataManager.getProfile(player)
	local store = getOrderedStore()
	if not profile or not store then
		return
	end
	local value = math.floor(math.max(profile.bestPower, profile.power))
	if value &lt; 1 then
		return
	end
	if value &gt; 9.2e18 then
		value = 9.2e18
	end
	task.spawn(function()
		local ok, err = pcall(function()
			store:SetAsync(tostring(player.UserId), value)
		end)
		if not ok then
			warn("[LeaderboardManager] submit : " .. tostring(err))
		end
	end)
end

function LeaderboardManager.fetchGlobal(force: boolean?)
	if not force and os.clock() - lastGlobalFetch &lt; 60 and #globalCache &gt; 0 then
		return globalCache
	end
	local store = getOrderedStore()
	if not store then
		return globalCache
	end
	local ok, pages = pcall(function()
		return store:GetSortedAsync(false, math.clamp(GameConfig.Misc.LeaderboardTop, 1, 100))
	end)
	if not ok then
		warn("[LeaderboardManager] GetSortedAsync : " .. tostring(pages))
		return globalCache
	end

	local list = {}
	local success, page = pcall(function()
		return pages:GetCurrentPage()
	end)
	if success and type(page) == "table" then
		for rank, entry in ipairs(page) do
			local userId = tonumber(entry.key)
			if userId then
				table.insert(list, {
					Rank = rank,
					UserId = userId,
					Name = resolveName(userId),
					Power = entry.value,
				})
			end
		end
	end
	globalCache = list
	lastGlobalFetch = os.clock()
	return list
end

-- ============================================================
-- PANNEAU DANS LE LOBBY
-- ============================================================
local function updateLobbyBoard()
	local lobby = Workspace:FindFirstChild("Lobby")
	local board = lobby and lobby:FindFirstChild("ServerBoard")
	local gui = board and board:FindFirstChild("ServerLeaderboard")
	local list = gui and gui:FindFirstChild("List")
	if not list then
		return
	end

	local top = LeaderboardManager.getServerTop(10)
	local children = list:GetChildren()
	for _, child in ipairs(children) do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end

	for index = 1, math.max(#top, 1) do
		local label = Instance.new("TextLabel")
		label.Name = "Row" .. tostring(index)
		label.LayoutOrder = index
		label.Size = UDim2.new(1, 0, 0, 36)
		label.BackgroundTransparency = 0.85
		label.BackgroundColor3 = index == 1 and Color3.fromRGB(255, 215, 90) or Color3.fromRGB(255, 255, 255)
		label.Font = Enum.Font.GothamBold
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.TextScaled = true
		local entry = top[index]
		if entry then
			label.Text = string.format("  #%d  %s   —   %s ⚡", index, entry.Name, Formulas.formatNumber(entry.Power))
			label.TextColor3 = index == 1 and Color3.fromRGB(60, 40, 0) or Color3.fromRGB(230, 240, 255)
		else
			label.Text = index == 1 and "  En attente de joueurs…" or ""
			label.TextColor3 = Color3.fromRGB(150, 160, 180)
		end
		label.Parent = list
	end
end

-- ============================================================
-- DÉMARRAGE
-- ============================================================
function LeaderboardManager.start()
	Net.func("GetLeaderboards").OnServerInvoke = function(player)
		local globalList = LeaderboardManager.fetchGlobal(false)
		local serverList = LeaderboardManager.getServerTop(GameConfig.Misc.LeaderboardTop)
		return globalList, serverList
	end

	-- Soumission des scores
	Players.PlayerRemoving:Connect(function(player)
		LeaderboardManager.submitScore(player)
	end)

	-- Précharge le classement mondial (les noms coûtent cher la 1re fois)
	task.spawn(function()
		task.wait(10)
		LeaderboardManager.fetchGlobal(true)
	end)

	task.spawn(function()
		while true do
			task.wait(8)
			updateLobbyBoard()
			local serverList = LeaderboardManager.getServerTop(GameConfig.Misc.LeaderboardTop)
			Net.event("LeaderboardData"):FireAllClients(globalCache, serverList)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(45)
			for _, player in ipairs(Players:GetPlayers()) do
				LeaderboardManager.submitScore(player)
			end
			LeaderboardManager.fetchGlobal(true)
		end
	end)

	print("[LeaderboardManager] Démarré")
end

return LeaderboardManager
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item><Item class="ModuleScript" referent="RBX001B">
        <Properties>
          <string name="Name">MonetizationSystem</string>
          <ProtectedString name="Source">--!strict
--[[
	MonetizationSystem  |  ServerScriptService.Systems.MonetizationSystem
	------------------------------------------------------------------
	GAME PASSES (permanents, vérifiés côté serveur) :
	  DoublePower, AutoCollect, ExtraPetSlots, VIP, Cosmetics

	DEVELOPER PRODUCTS (consommables) :
	  PowerBoost ×3 (15 min), CoinPack, MegaCoinPack, LuckyEgg (légendaire)

	⚠️ IMPORTANT : remplace les Id = 0 dans GameConfig par tes vrais IDs.
	   Tant que les IDs valent 0, tout le système de paiement est ignoré
	   (aucune erreur) et le jeu reste 100% jouable gratuitement.

	Sécurité : ProcessReceipt est idempotent (PurchaseId mémorisé dans le
	profil), les récompenses sont accordées uniquement côté serveur.
]]

local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local Formulas = require(Modules:WaitForChild("Formulas"))
local Net = require(Modules:WaitForChild("Net"))

local DataManager = require(script.Parent.DataManager)
local PetSystem = require(script.Parent.PetSystem)

local MonetizationSystem = {}

local productById: { [number]: any } = {}
local receiptHistory: { [number]: { [string]: boolean } } = {}

local function buildProductIndex()
	for productName, product in pairs(GameConfig.DeveloperProducts) do
		if product.Id and product.Id &gt; 0 then
			productById[product.Id] = product
			product.Key = product.Key or productName
		end
	end
end

-- ============================================================
-- GAME PASSES
-- ============================================================
local function checkGamePass(player: Player, passId: number): boolean
	if passId &lt;= 0 then
		return false
	end
	local ok, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, passId)
	end)
	if ok then
		return owns == true
	end
	warn("[Monetization] UserOwnsGamePassAsync : " .. tostring(owns))
	return false
end

function MonetizationSystem.refreshGamePasses(player: Player)
	local profile = DataManager.getProfile(player)
	if not profile then
		return
	end
	local passes = profile.gamePasses
	for passName, pass in pairs(GameConfig.GamePasses) do
		passes[passName] = checkGamePass(player, pass.Id or 0)
	end
	DataManager.notify(player, true)
end

-- ============================================================
-- DEVELOPER PRODUCTS
-- ============================================================
local function grantProduct(player: Player, productKey: string): boolean
	local profile = DataManager.getProfile(player)
	if not profile then
		return false
	end
	local rewards = GameConfig.ProductRewards[productKey]
	if not rewards then
		return false
	end

	if rewards.BoostMult and rewards.BoostSeconds then
		local endsAt = os.time() + rewards.BoostSeconds
		local currentMult = 1
		if profile.boost and profile.boost.endsAt &gt; os.time() then
			currentMult = profile.boost.mult
		end
		profile.boost = { mult = math.max(currentMult, rewards.BoostMult), startsAt = os.time(), endsAt = endsAt }
		Net.event("BoostUpdate"):FireClient(player, profile.boost.mult, endsAt)
		Net.event("Notify"):FireClient(player, "🚀 Boost ×" .. tostring(profile.boost.mult) .. " activé pour 15 min !", "8affc1", "🚀")
	end

	if rewards.Coins and rewards.Coins &gt; 0 then
		DataManager.addCoins(player, rewards.Coins)
		Net.event("Notify"):FireClient(player, "🪙 +" .. Formulas.formatNumber(rewards.Coins) .. " pièces !", "ffd700", "🪙")
	end

	if rewards.GuaranteedRarity then
		PetSystem.grantPetOfRarity(player, rewards.GuaranteedRarity)
	end

	DataManager.notify(player, true)
	return true
end

function MonetizationSystem.start()
	buildProductIndex()

	MarketplaceService.ProcessReceipt = function(receiptInfo)
		local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
		if not player then
			-- le joueur est parti : on ne débite pas, il sera remboursé
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end

		local profile = DataManager.getProfile(player)
		if not profile then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end

		-- Idempotence
		local history = receiptHistory[player.UserId]
		if not history then
			history = {}
			receiptHistory[player.UserId] = history
		end
		if history[receiptInfo.PurchaseId] then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end

		local product = productById[receiptInfo.ProductId]
		local productKey = product and product.Key or nil
		if not productKey then
			-- produit non configuré : on cherche par nom dans la config
			for name, entry in pairs(GameConfig.DeveloperProducts) do
				if entry.Id == receiptInfo.ProductId then
					productKey = entry.Key or name
					break
				end
			end
		end

		if not productKey then
			warn("[Monetization] produit inconnu : " .. tostring(receiptInfo.ProductId))
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end

		local ok, err = pcall(grantProduct, player, productKey)
		if not ok then
			warn("[Monetization] échec d'attribution : " .. tostring(err))
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end

		history[receiptInfo.PurchaseId] = true
		DataManager.save(player, false)
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	-- Vérification des game passes à l'arrivée
	DataManager.Events.Loaded:Connect(function(player)
		task.spawn(function()
			MonetizationSystem.refreshGamePasses(player)
		end)
	end)

	Players.PlayerRemoving:Connect(function(player)
		receiptHistory[player.UserId] = nil
	end)

	local configured = 0
	for _, pass in pairs(GameConfig.GamePasses) do
		if (pass.Id or 0) &gt; 0 then
			configured = configured + 1
		end
	end
	if configured == 0 then
		print("[MonetizationSystem] Démarré — ⚠️ aucun Game Pass configuré (IDs = 0), monétisation désactivée.")
	else
		print(string.format("[MonetizationSystem] Démarré — %d game passes configurés.", configured))
	end
end

return MonetizationSystem
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item><Item class="ModuleScript" referent="RBX001C">
        <Properties>
          <string name="Name">PetSystem</string>
          <ProtectedString name="Source">--!strict
--[[
	PetSystem  |  ServerScriptService.Systems.PetSystem
	------------------------------------------------------------------
	Œufs, inventaire, équipement, fusion et meilleurs pets.

	SÉCURITÉ (tout est serveur) :
	  • le client ne fait que DEMANDER ("ouvre l'œuf X")
	  • le tirage aléatoire est fait ici (Random.new)
	  • le prix est vérifié et débité ici
	  • les uid sont générés ici, jamais par le client
	  • impossible d'équiper un pet non possédé
	  • impossible de fusionner des pets non possédés
	  • limite d'inventaire (anti-duplication)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local Formulas = require(Modules:WaitForChild("Formulas"))
local Net = require(Modules:WaitForChild("Net"))
local Util = require(Modules:WaitForChild("Util"))
local Signal = require(Modules:WaitForChild("Signal"))

local DataManager = require(script.Parent.DataManager)

local PetSystem = {}

PetSystem.Events = {
	EggOpened = Signal.new(), -- (player, eggId, petId, rarity, isNew)
	PetEquipped = Signal.new(), -- (player, uid)
	PetFused = Signal.new(), -- (player, petId, newLevel)
}

local rng = Random.new(os.time() + math.floor(os.clock() * 1e6))
local lastEggOpen: { [Player]: number } = {}
local openBudget: { [Player]: number } = {}

-- Modifié par EventManager (Lucky Time) : chances de raretés améliorées
PetSystem.luckyMultiplier = 1

local RARE_SET = {
	Rare = true,
	Epic = true,
	Legendary = true,
	Mythical = true,
	Secret = true,
}

-- ============================================================
-- HELPERS
-- ============================================================
local function findPet(profile, uid: string)
	for index, pet in ipairs(profile.pets) do
		if pet.uid == uid then
			return pet, index
		end
	end
	return nil, nil
end

local function isEggAvailable(player: Player, profile, eggId: string): (boolean, string)
	local egg = GameConfig.Eggs[eggId]
	if not egg then
		return false, "Œuf inconnu."
	end
	if egg.MinRebirth and (profile.rebirths or 0) &lt; egg.MinRebirth then
		return false, string.format("Nécessite %d rebirth(s).", egg.MinRebirth)
	end
	if egg.World and profile.maxWorld &lt; egg.World then
		return false, "Débloque d'abord ce monde."
	end
	return true, ""
end

local function rollRarity(egg)
	local weights = {}
	for rarity, weight in pairs(egg.Rates) do
		local pool = egg.Pool[rarity]
		if pool and #pool &gt; 0 then
			local adjusted = weight
			if RARE_SET[rarity] and PetSystem.luckyMultiplier &gt; 1 then
				adjusted = weight * PetSystem.luckyMultiplier
			end
			weights[rarity] = adjusted
		end
	end
	local rarity = Util.weightedChoice(weights, rng)
	if not rarity then
		for _, candidate in ipairs(GameConfig.RarityOrder) do
			if egg.Pool[candidate] and #egg.Pool[candidate] &gt; 0 then
				rarity = candidate
				break
			end
		end
	end
	return rarity
end

local function rollPetOfRarity(egg, rarity: string): string?
	local pool = egg.Pool[rarity]
	if not pool or #pool == 0 then
		return nil
	end
	local weighted = {}
	for _, petId in ipairs(pool) do
		local petInfo = GameConfig.Pets[petId]
		if petInfo then
			weighted[petId] = petInfo.Weight or GameConfig.PetWeightInsideRarity
		end
	end
	return Util.weightedChoice(weighted, rng)
end

local function createPetEntry(profile, petId: string)
	local uid = Util.generateUid(rng)
	while findPet(profile, uid) do
		uid = Util.generateUid(rng)
	end
	local pet = { uid = uid, id = petId, level = 1 }
	table.insert(profile.pets, pet)
	return pet
end

local function countRarity(profile, rarity: string): number
	local total = 0
	for _, pet in ipairs(profile.pets) do
		local info = GameConfig.Pets[pet.id]
		if info and info.Rarity == rarity then
			total = total + 1
		end
	end
	return total
end

-- ============================================================
-- OUVERTURE D'ŒUF
-- ============================================================
--- Accorde un pet directement (utilisé par les developer products)
function PetSystem.grantPet(player: Player, petId: string, rarityOverride: string?): any
	local profile = DataManager.getProfile(player)
	if not profile then
		return nil
	end
	if #profile.pets &gt;= GameConfig.Misc.MaxPets then
		Net.event("Notify"):FireClient(player, "Inventaire plein ! Fusionne tes pets.", "ff6b6b", "⚠️")
		return nil
	end
	local alreadyOwned = false
	for _, pet in ipairs(profile.pets) do
		if pet.id == petId then
			alreadyOwned = true
			break
		end
	end
	local pet = createPetEntry(profile, petId)
	local info = GameConfig.Pets[petId]
	if info.Rarity == "Legendary" then
		DataManager.addStat(player, "legendaryPets", 1)
	elseif info.Rarity == "Mythical" then
		DataManager.addStat(player, "mythicalPets", 1)
	elseif info.Rarity == "Secret" then
		DataManager.addStat(player, "secretPets", 1)
	end
	Net.event("EggResult"):FireClient(player, info.Rarity, petId, info.Name, info.Mult, "DeveloperProduct", not alreadyOwned)
	DataManager.notify(player, true)
	PetSystem.Events.EggOpened:Fire(player, "DeveloperProduct", petId, info.Rarity, not alreadyOwned)
	return pet
end

--- Accorde un pet d'une rareté donnée (choisi dans tous les pets du jeu)
function PetSystem.grantPetOfRarity(player: Player, rarity: string)
	local candidates = {}
	for petId, info in pairs(GameConfig.Pets) do
		if info.Rarity == rarity then
			table.insert(candidates, petId)
		end
	end
	if #candidates == 0 then
		return nil
	end
	local petId = candidates[rng:NextInteger(1, #candidates)]
	return PetSystem.grantPet(player, petId)
end

function PetSystem.openEgg(player: Player, eggId: any, amount: any): number
	local profile = DataManager.getProfile(player)
	if not profile then
		return 0
	end
	if type(eggId) ~= "string" then
		return 0
	end
	local egg = GameConfig.Eggs[eggId]
	if not egg then
		return 0
	end

	-- anti-spam
	local now = os.clock()
	if lastEggOpen[player] and now - lastEggOpen[player] &lt; 0.25 then
		return 0
	end
	local budget = (openBudget[player] or 0) + 1
	if now - (lastEggOpen[player] or 0) &gt; 1 then
		budget = 1
	end
	if budget &gt; 12 then
		return 0
	end
	openBudget[player] = budget
	lastEggOpen[player] = now

	local quantity = 1
	if type(amount) == "number" then
		quantity = math.clamp(math.floor(amount), 1, 3)
	end

	local available, reason = isEggAvailable(player, profile, eggId)
	if not available then
		Net.event("Notify"):FireClient(player, "🔒 " .. reason, "ff6b6b", "🔒")
		return 0
	end

	local isFree = egg.FreeOnePerPlayer and not profile.freeEggsTaken[eggId]
	local totalPrice = 0
	if not isFree then
		totalPrice = (egg.Price or 0) * quantity
	else
		quantity = 1
	end

	if #profile.pets + quantity &gt; GameConfig.Misc.MaxPets then
		Net.event("Notify"):FireClient(player, "Inventaire plein ! Fusionne tes pets.", "ff6b6b", "⚠️")
		return 0
	end

	if totalPrice &gt; 0 then
		if profile.coins &lt; totalPrice then
			Net.event("Notify"):FireClient(player, "Pas assez de pièces ! (" .. Formulas.formatNumber(totalPrice) .. " requis)", "ff6b6b", "🪙")
			return 0
		end
		profile.coins = profile.coins - totalPrice
	end

	if isFree then
		profile.freeEggsTaken[eggId] = true
	end

	local opened = 0
	for _ = 1, quantity do
		if #profile.pets &gt;= GameConfig.Misc.MaxPets then
			break
		end
		local rarity = rollRarity(egg)
		local petId = rarity and rollPetOfRarity(egg, rarity) or nil
		if rarity and petId then
			local alreadyOwned = false
			for _, existingPet in ipairs(profile.pets) do
				if existingPet.id == petId then
					alreadyOwned = true
					break
				end
			end

			createPetEntry(profile, petId)
			DataManager.addStat(player, "eggsOpened", 1)

			if rarity == "Legendary" then
				DataManager.addStat(player, "legendaryPets", 1)
			elseif rarity == "Mythical" then
				DataManager.addStat(player, "mythicalPets", 1)
			elseif rarity == "Secret" then
				DataManager.addStat(player, "secretPets", 1)
			end

			local info = GameConfig.Pets[petId]
			Net.event("EggResult"):FireClient(player, rarity, petId, info.Name, info.Mult, eggId, not alreadyOwned)
			PetSystem.Events.EggOpened:Fire(player, eggId, petId, rarity, not alreadyOwned)
			opened = opened + 1

			-- notification globale pour les pets très rares
			if rarity == "Secret" or rarity == "Mythical" then
				for _, other in ipairs(Players:GetPlayers()) do
					local otherProfile = DataManager.getProfile(other)
					if otherProfile and other == player then
						Net.event("Notify"):FireClient(other, string.format("🎉 %s a obtenu %s %s !", player.DisplayName, GameConfig.Rarities[rarity].Name, info.Name), "ffd700", info.Emoji)
					elseif otherProfile and otherProfile.settings.effects then
						Net.event("Notify"):FireClient(other, string.format("🌟 %s a obtenu %s (%s) !", player.DisplayName, info.Name, rarity), "c9a6ff", info.Emoji)
					end
				end
			end
		end
	end

	DataManager.notify(player, true)
	return opened
end

-- ============================================================
-- ÉQUIPEMENT
-- ============================================================
function PetSystem.equip(player: Player, uid: any): boolean
	local profile = DataManager.getProfile(player)
	if not profile or type(uid) ~= "string" then
		return false
	end
	local pet = findPet(profile, uid)
	if not pet then
		return false
	end
	if Util.indexOf(profile.equipped, uid) &gt; 0 then
		return false
	end
	local slots = Formulas.petSlots(profile, profile.gamePasses and profile.gamePasses.ExtraPetSlots)
	if #profile.equipped &gt;= slots then
		Net.event("Notify"):FireClient(player, "Tous tes emplacements sont utilisés ! Améliore-les dans la boutique.", "ff6b6b", "🐾")
		return false
	end
	table.insert(profile.equipped, uid)
	DataManager.notify(player, true)
	PetSystem.Events.PetEquipped:Fire(player, uid)
	return true
end

function PetSystem.unequip(player: Player, uid: any): boolean
	local profile = DataManager.getProfile(player)
	if not profile or type(uid) ~= "string" then
		return false
	end
	if not Util.removeValue(profile.equipped, uid) then
		return false
	end
	DataManager.notify(player, true)
	return true
end

--- Équipe automatiquement les meilleurs pets possédés.
function PetSystem.equipBest(player: Player): number
	local profile = DataManager.getProfile(player)
	if not profile then
		return 0
	end
	local slots = Formulas.petSlots(profile, profile.gamePasses and profile.gamePasses.ExtraPetSlots)
	local sorted = {}
	for _, pet in ipairs(profile.pets) do
		table.insert(sorted, pet)
	end
	table.sort(sorted, function(a, b)
		return Formulas.petPower(a.id, a.level) &gt; Formulas.petPower(b.id, b.level)
	end)
	local equipped = {}
	for index = 1, math.min(slots, #sorted) do
		equipped[index] = sorted[index].uid
	end
	profile.equipped = equipped
	DataManager.notify(player, true)
	Net.event("Notify"):FireClient(player, "✨ Meilleurs pets équipés !", "8affc1", "🐾")
	return #equipped
end

--- Vérifie que l'équipement reste valide (appelé après un changement de slots)
function PetSystem.validateEquipped(player: Player)
	local profile = DataManager.getProfile(player)
	if not profile then
		return
	end
	local owned = {}
	for _, pet in ipairs(profile.pets) do
		owned[pet.uid] = true
	end
	local slots = Formulas.petSlots(profile, profile.gamePasses and profile.gamePasses.ExtraPetSlots)
	local valid = {}
	for _, uid in ipairs(profile.equipped) do
		if owned[uid] and #valid &lt; slots then
			table.insert(valid, uid)
		end
	end
	if #valid ~= #profile.equipped then
		profile.equipped = valid
		DataManager.notify(player, true)
	end
end

-- ============================================================
-- FUSION
-- ============================================================
function PetSystem.fuse(player: Player, petId: any): boolean
	local profile = DataManager.getProfile(player)
	if not profile or type(petId) ~= "string" then
		return false
	end
	local info = GameConfig.Pets[petId]
	if not info then
		return false
	end

	local needed = GameConfig.Misc.FuseCount
	local requiredLevel = nil
	local candidates = {}
	for _, pet in ipairs(profile.pets) do
		if pet.id == petId then
			table.insert(candidates, pet)
		end
	end

	-- on privilégie les pets du plus petit niveau identique
	table.sort(candidates, function(a, b)
		return a.level &lt; b.level
	end)
	if #candidates &lt; needed then
		Net.event("Notify"):FireClient(player, string.format("Il faut %d %s identiques (niveau identique).", needed, info.Name), "ff6b6b", "⚗️")
		return false
	end

	requiredLevel = candidates[1].level
	if requiredLevel &gt;= GameConfig.Misc.MaxPetLevel then
		Net.event("Notify"):FireClient(player, "Ce pet est déjà au niveau maximum !", "ff6b6b", "⚗️")
		return false
	end

	local toConsume = {}
	for _, pet in ipairs(candidates) do
		if pet.level == requiredLevel and #toConsume &lt; needed then
			table.insert(toConsume, pet)
		end
	end
	if #toConsume &lt; needed then
		Net.event("Notify"):FireClient(player, string.format("Il faut %d %s de NIVEAU %d.", needed, info.Name, requiredLevel), "ff6b6b", "⚗️")
		return false
	end

	-- retrait sécurisé par uid
	local consumedUids = {}
	for _, pet in ipairs(toConsume) do
		consumedUids[pet.uid] = true
	end
	local newPets = {}
	for _, pet in ipairs(profile.pets) do
		if not consumedUids[pet.uid] then
			table.insert(newPets, pet)
		end
	end

	local wasEquipped = false
	for _, uid in ipairs(profile.equipped) do
		if consumedUids[uid] then
			wasEquipped = true
			break
		end
	end
	local newEquipped = {}
	for _, uid in ipairs(profile.equipped) do
		if not consumedUids[uid] then
			table.insert(newEquipped, uid)
		end
	end

	local upgraded = { uid = toConsume[1].uid, id = petId, level = requiredLevel + 1 }
	table.insert(newPets, upgraded)
	if wasEquipped then
		table.insert(newEquipped, upgraded.uid)
	end

	profile.pets = newPets
	profile.equipped = newEquipped
	DataManager.addStat(player, "fusions", 1)

	Net.event("Notify"):FireClient(
		player,
		string.format("⚗️ Fusion réussie ! %s %s niveau %d", info.Emoji, info.Name, upgraded.level),
		"8affc1",
		"⚗️"
	)
	Net.event("PlaySound"):FireClient(player, "fuse", 0.7)
	DataManager.notify(player, true)
	PetSystem.validateEquipped(player)
	PetSystem.Events.PetFused:Fire(player, petId, upgraded.level)
	return true
end

-- ============================================================
-- DÉMARRAGE
-- ============================================================
function PetSystem.start()
	Net.event("OpenEgg").OnServerEvent:Connect(function(player, eggId, amount)
		PetSystem.openEgg(player, eggId, amount)
	end)

	Net.event("EquipPet").OnServerEvent:Connect(function(player, uid)
		if PetSystem.equip(player, uid) then
			Net.event("PlaySound"):FireClient(player, "equip", 0.4)
		end
	end)

	Net.event("UnequipPet").OnServerEvent:Connect(function(player, uid)
		PetSystem.unequip(player, uid)
	end)

	Net.event("EquipBestPets").OnServerEvent:Connect(function(player)
		PetSystem.equipBest(player)
	end)

	Net.event("FusePet").OnServerEvent:Connect(function(player, petId)
		PetSystem.fuse(player, petId)
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastEggOpen[player] = nil
		openBudget[player] = nil
	end)

	print("[PetSystem] Démarré")
end

return PetSystem
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item><Item class="ModuleScript" referent="RBX001D">
        <Properties>
          <string name="Name">RebirthSystem</string>
          <ProtectedString name="Source">--!strict
--[[
	RebirthSystem  |  ServerScriptService.Systems.RebirthSystem
	------------------------------------------------------------------
	Rebirth : le joueur sacrifie sa puissance actuelle contre un
	multiplicateuf permanent + des pièces + un nouveau titre.

	• Coût croissant : 2500 × 2.15^rebirths (40 rebirths max)
	• Multiplicateur permanent : +0.35× par rebirth
	• Récompense en pièces + déblocage de titres tous les 5 rebirths
	• Annonce à tout le serveur (effet de victoire)
	• Tout est vérifié côté serveur, une seule requête par 2 secondes
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local Formulas = require(Modules:WaitForChild("Formulas"))
local Net = require(Modules:WaitForChild("Net"))
local Signal = require(Modules:WaitForChild("Signal"))

local DataManager = require(script.Parent.DataManager)
local WorldManager = require(script.Parent.WorldManager)
local CharacterSystem = require(script.Parent.CharacterSystem)

local RebirthSystem = {}

RebirthSystem.Events = {
	RebirthPerformed = Signal.new(), -- (player, rebirths)
}

local lastRequest: { [Player]: number } = {}

-- ============================================================
-- TITRES
-- ============================================================
local function updateTitles(player: Player, profile)
	for _, title in ipairs(GameConfig.Titles) do
		if profile.rebirths &gt;= title.Rebirth then
			if not table.find(profile.titles, title.Id) then
				table.insert(profile.titles, title.Id)
				Net.event("Notify"):FireClient(player, "🏷️ Nouveau titre débloqué : " .. title.Name, "ffd700", "🏷️")
			end
		end
	end
end

-- ============================================================
-- REBIRTH
-- ============================================================
function RebirthSystem.canRebirth(player: Player): (boolean, string, number)
	local profile = DataManager.getProfile(player)
	if not profile then
		return false, "Profil non chargé.", 0
	end
	if profile.rebirths &gt;= GameConfig.Rebirth.MaxRebirths then
		return false, "Rebirth maximum atteint ! 🏆", 0
	end
	local cost = Formulas.rebirthCost(profile.rebirths)
	if profile.power &lt; cost then
		return false, string.format("Il te manque %s de puissance.", Formulas.formatNumber(cost - profile.power)), cost
	end
	return true, "", cost
end

function RebirthSystem.rebirth(player: Player): boolean
	local now = os.clock()
	if lastRequest[player] and now - lastRequest[player] &lt; 2 then
		return false
	end
	lastRequest[player] = now

	local profile = DataManager.getProfile(player)
	if not profile then
		return false
	end

	local can, reason, cost = RebirthSystem.canRebirth(player)
	if not can then
		Net.event("Notify"):FireClient(player, "❌ " .. reason, "ff6b6b", "❌")
		return false
	end

	if profile.power &lt; cost then
		return false
	end

	-- Application (atomique)
	profile.power = 0
	profile.rebirths = profile.rebirths + 1
	profile.totalRebirths = profile.totalRebirths + 1

	local coinReward = Formulas.rebirthCoinReward(profile.rebirths)
	profile.coins = profile.coins + coinReward

	updateTitles(player, profile)
	DataManager.addStat(player, "rebirths", 1)

	-- Les pets restent équipés, les améliorations sont conservées.
	-- Le joueur repart de zéro en puissance mais avec un multiplicateur.

	Net.event("RebirthSuccess"):FireClient(player, profile.rebirths, coinReward)
	Net.event("PlaySound"):FireClient(player, "rebirth", 0.9)
	Net.event("CameraShake"):FireClient(player, 1.2)
	Net.event("ScreenFlash"):FireClient(player, "ffffff", 0.5)

	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			Net.event("Notify"):FireClient(
				other,
				string.format("🔄 %s vient d'effectuer son Rebirth %d !", player.DisplayName, profile.rebirths),
				"ffd700",
				"🔄"
			)
		end
	end

	DataManager.notify(player, true)
	DataManager.save(player, false)

	WorldManager.checkUnlocks(player, true)
	CharacterSystem.reset(player)
	task.delay(0.2, function()
		CharacterSystem.refresh(player)
	end)

	RebirthSystem.Events.RebirthPerformed:Fire(player, profile.rebirths)
	DataManager.Events.Rebirth:Fire(player, profile)
	return true
end

-- ============================================================
-- DÉMARRAGE
-- ============================================================
function RebirthSystem.start()
	Net.event("RebirthRequest").OnServerEvent:Connect(function(player)
		RebirthSystem.rebirth(player)
	end)

	-- L'autel de rebirth est aussi cliquable dans le lobby (Touched)
	task.spawn(function()
		local lobby = workspace:WaitForChild("Lobby", 20)
		if not lobby then
			return
		end
		local altar = lobby:FindFirstChild("RebirthAltar")
		if not altar then
			return
		end
		local base = altar:FindFirstChild("AltarBase")
		if base and base:IsA("BasePart") then
			base.Touched:Connect(function(hit)
				local character = hit:FindFirstAncestorOfClass("Model")
				local touchPlayer = character and Players:GetPlayerFromCharacter(character)
				if touchPlayer then
					Net.event("Notify"):FireClient(touchPlayer, "Appuie sur le bouton 🔄 Rebirth de l'interface !", "ffd700", "🔄")
				end
			end)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastRequest[player] = nil
	end)

	print("[RebirthSystem] Démarré")
end

return RebirthSystem
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item><Item class="ModuleScript" referent="RBX001E">
        <Properties>
          <string name="Name">SettingsSystem</string>
          <ProtectedString name="Source">--!strict
--[[
	SettingsSystem  |  ServerScriptService.Systems.SettingsSystem
	------------------------------------------------------------------
	• Paramètres joueur (musique, sons, effets, particules, pets visibles)
	  → validés et sauvegardés par le serveur (le client ne peut écrire
	    que les clés autorisées, avec des booléens)
	• Sélection de titre (uniquement les titres débloqués)
	• "ClientReady" : le serveur renvoie l'état complet au client
	• Petites actions sociales : comparaison de puissance
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local Formulas = require(Modules:WaitForChild("Formulas"))
local Net = require(Modules:WaitForChild("Net"))
local ProfileTemplate = require(Modules:WaitForChild("ProfileTemplate"))

local DataManager = require(script.Parent.DataManager)
local CharacterSystem = require(script.Parent.CharacterSystem)

local SettingsSystem = {}

local VALID_SETTINGS = {
	music = true,
	sfx = true,
	effects = true,
	particles = true,
	cameraShake = true,
	petsVisible = true,
	damageNumbers = true,
}

function SettingsSystem.setSetting(player: Player, key: any, value: any): boolean
	if type(key) ~= "string" or type(value) ~= "boolean" then
		return false
	end
	if VALID_SETTINGS[key] ~= true then
		return false
	end
	local profile = DataManager.getProfile(player)
	if not profile then
		return false
	end
	profile.settings[key] = value
	DataManager.notify(player)
	return true
end

function SettingsSystem.selectTitle(player: Player, titleId: any): boolean
	if type(titleId) ~= "string" then
		return false
	end
	local profile = DataManager.getProfile(player)
	if not profile then
		return false
	end
	if not table.find(profile.titles, titleId) then
		return false
	end
	profile.titleSelected = titleId
	CharacterSystem.reset(player)
	CharacterSystem.refresh(player)
	DataManager.notify(player, true)
	Net.event("PlaySound"):FireClient(player, "equip", 0.4)
	return true
end

--- Comparaison de puissance demandée par le client (bouton "Comparer")
function SettingsSystem.compare(player: Player, otherPlayer: Player)
	local a = DataManager.getProfile(player)
	local b = DataManager.getProfile(otherPlayer)
	if not a or not b then
		return
	end
	local diff = a.power - b.power
	local message
	if diff &gt;= 0 then
		message = string.format("Tu es plus puissant que %s de %s ⚡ !", otherPlayer.DisplayName, Formulas.formatNumber(diff))
	else
		message = string.format("%s est plus puissant que toi de %s ⚡…", otherPlayer.DisplayName, Formulas.formatNumber(-diff))
	end
	Net.event("Notify"):FireClient(player, message, "8ac8ff", "⚖️")
end

function SettingsSystem.start()
	Net.event("SetSetting").OnServerEvent:Connect(function(player, key, value)
		SettingsSystem.setSetting(player, key, value)
	end)

	Net.event("SelectTitle").OnServerEvent:Connect(function(player, titleId)
		SettingsSystem.selectTitle(player, titleId)
	end)

	-- Comparaison de puissance avec un autre joueur du serveur
	Net.event("ComparePower").OnServerEvent:Connect(function(player, userId)
		if type(userId) ~= "number" then
			return
		end
		local otherPlayer = Players:GetPlayerByUserId(userId)
		if otherPlayer and otherPlayer ~= player then
			SettingsSystem.compare(player, otherPlayer)
		end
	end)

	Net.event("ClientReady").OnServerEvent:Connect(function(player)
		local profile = DataManager.waitForProfile(player, 20)
		if profile then
			Net.event("ProfileUpdated"):FireClient(player, ProfileTemplate.toPublic(profile))
			Net.event("SetWorld"):FireClient(player, profile.world)
		end
	end)

	Net.func("GetProfile").OnServerInvoke = function(player)
		local profile = DataManager.waitForProfile(player, 15)
		if profile then
			return ProfileTemplate.toPublic(profile)
		end
		return nil
	end

	Net.func("GetServerInfo").OnServerInvoke = function(player)
		return {
			players = #Players:GetPlayers(),
			serverTime = os.time(),
		}
	end

	Net.event("PlayEmote").OnServerEvent:Connect(function(player, emote)
		if type(emote) ~= "string" then
			return
		end
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			local animations = {
				dance = "rbxassetid://507771019",
				wave = "rbxassetid://507770239",
				laugh = "rbxassetid://507770818",
				cheer = "rbxassetid://507770677",
			}
			local assetId = animations[emote]
			if assetId then
				local animation = Instance.new("Animation")
				animation.AnimationId = assetId
				local track = humanoid:FindFirstChildOfClass("Animator") and humanoid:FindFirstChildOfClass("Animator"):LoadAnimation(animation)
				if track then
					track:Play()
					task.delay(4, function()
						if track.IsPlaying then
							track:Stop()
						end
					end)
				end
			end
		end
	end)

	print("[SettingsSystem] Démarré")
end

return SettingsSystem
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item><Item class="ModuleScript" referent="RBX001F">
        <Properties>
          <string name="Name">ShopSystem</string>
          <ProtectedString name="Source">--!strict
--[[
	ShopSystem  |  ServerScriptService.Systems.ShopSystem
	------------------------------------------------------------------
	Améliorations achetables en pièces :
	  PowerMult, CoinMult, AutoCollect, Vacuum, WalkSpeed, PetSlots

	Tout est validé côté serveur : l'ID de l'amélioration doit exister,
	le niveau maximum doit être respecté, les pièces doivent être
	effectivement débitées (DataManager.spendCoins est atomique).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local Formulas = require(Modules:WaitForChild("Formulas"))
local Net = require(Modules:WaitForChild("Net"))

local DataManager = require(script.Parent.DataManager)
local PetSystem = require(script.Parent.PetSystem)
local CharacterSystem = require(script.Parent.CharacterSystem)

local ShopSystem = {}

local lastPurchase: { [Player]: number } = {}

-- ============================================================
-- ACHAT D'AMÉLIORATION
-- ============================================================
function ShopSystem.buyUpgrade(player: Player, upgradeId: any): boolean
	if type(upgradeId) ~= "string" then
		return false
	end
	local upgrade = GameConfig.Upgrades[upgradeId]
	if not upgrade then
		return false
	end
	local profile = DataManager.getProfile(player)
	if not profile then
		return false
	end

	-- anti-spam (5 achats/seconde max)
	local now = os.clock()
	local history = lastPurchase[player] or {}
	table.insert(history, now)
	while #history &gt; 5 do
		table.remove(history, 1)
	end
	lastPurchase[player] = history
	if #history == 5 and now - history[1] &lt; 1 then
		return false
	end

	local level = profile.upgrades[upgradeId] or 0
	if level &gt;= upgrade.MaxLevel then
		Net.event("Notify"):FireClient(player, "Niveau maximum atteint pour " .. upgrade.Name, "ff6b6b", "⬆️")
		return false
	end

	local cost = Formulas.upgradeCost(upgradeId, level)
	if profile.coins &lt; cost then
		Net.event("Notify"):FireClient(player, "Pas assez de pièces ! (" .. Formulas.formatNumber(cost) .. ")", "ff6b6b", "🪙")
		return false
	end

	if not DataManager.spendCoins(player, cost) then
		return false
	end

	profile.upgrades[upgradeId] = level + 1
	Net.event("PlaySound"):FireClient(player, "buy", 0.6)
	Net.event("Notify"):FireClient(
		player,
		string.format("%s %s niveau %d !", upgrade.Icon, upgrade.Name, level + 1),
		"8affc1",
		upgrade.Icon
	)

	if upgradeId == "PetSlots" then
		PetSystem.validateEquipped(player)
	end
	if upgradeId == "WalkSpeed" then
		CharacterSystem.refresh(player)
	end

	-- Auto-collect : on remet le compteur à zéro pour un effet immédiat
	if upgradeId == "AutoCollect" then
		player:SetAttribute("AutoCollectNext", 0)
	end

	DataManager.notify(player, true)
	return true
end

--- Prix/état de chaque amélioration (pour l'UI)
function ShopSystem.getUpgradeInfo(profile)
	local list = {}
	for upgradeId, upgrade in pairs(GameConfig.Upgrades) do
		local level = (profile and profile.upgrades and profile.upgrades[upgradeId]) or 0
		table.insert(list, {
			Id = upgradeId,
			Name = upgrade.Name,
			Desc = upgrade.Desc,
			Icon = upgrade.Icon,
			Level = level,
			MaxLevel = upgrade.MaxLevel,
			Cost = Formulas.upgradeCost(upgradeId, level),
			Maxed = level &gt;= upgrade.MaxLevel,
		})
	end
	return list
end

function ShopSystem.start()
	Net.event("BuyUpgrade").OnServerEvent:Connect(function(player, upgradeId)
		ShopSystem.buyUpgrade(player, upgradeId)
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastPurchase[player] = nil
	end)

	print("[ShopSystem] Démarré")
end

return ShopSystem
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item><Item class="ModuleScript" referent="RBX0020">
        <Properties>
          <string name="Name">WorldFactory</string>
          <ProtectedString name="Source">--!strict
--[[
	WorldFactory  |  ServerScriptService.Systems.WorldFactory
	------------------------------------------------------------------
	Construit 100% de la map depuis du code (aucune asset externe) :

	  Workspace.Lobby            -&gt; plateforme, spawn, autel de rebirth,
	                                portails des 6 mondes, panneau du jeu,
	                                tableau des scores, piédestal d'œuf
	  Workspace.Worlds.World1..6 -&gt; plateformes thématiques, décor,
	                                portail de retour, piédestal d'œuf

	Avantage : la map est versionnée dans Git, modifiable en 3 lignes,
	et il n'y a aucun asset à importer. Chaque monde expose ses zones
	de spawn d'objets à CollectSystem.
]]

local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))

local WorldFactory = {}

-- ============================================================
-- CONSTANTES DE LAYOUT
-- ============================================================
WorldFactory.LOBBY_CENTER = Vector3.new(0, 0, 0)
WorldFactory.LOBBY_SIZE = 420
WorldFactory.LOBBY_SPAWN = Vector3.new(0, 6, 90)
WorldFactory.WORLD_PLATFORM_SIZE = 700
WorldFactory.WORLD_SPACING = 1500

local worldInfos = {}

-- ============================================================
-- OUTILS DE CONSTRUCTION
-- ============================================================
local function part(parent: Instance, props: { [string]: any }): Part
	local instance = Instance.new("Part")
	instance.Anchored = true
	instance.TopSurface = Enum.SurfaceType.Smooth
	instance.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		instance[key] = value
	end
	instance.Parent = parent
	return instance
end

local function wedge(parent: Instance, props: { [string]: any }): WedgePart
	local instance = Instance.new("WedgePart")
	instance.Anchored = true
	for key, value in pairs(props) do
		instance[key] = value
	end
	instance.Parent = parent
	return instance
end

local function label(parent: Instance, text: string, color: Color3, size: Vector2?): BillboardGui
	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Size = UDim2.fromOffset(size and size.X or 220, size and size.Y or 60)
	gui.StudsOffset = Vector3.new(0, 3, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 900
	gui.Adornee = parent
	gui.Parent = parent

	local textLabel = Instance.new("TextLabel")
	textLabel.BackgroundTransparency = 1
	textLabel.Size = UDim2.fromScale(1, 1)
	textLabel.Font = Enum.Font.FredokaOne
	textLabel.Text = text
	textLabel.TextColor3 = color
	textLabel.TextScaled = true
	textLabel.TextStrokeTransparency = 0.35
	textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	textLabel.Parent = gui
	return gui
end

local function neon(parent: Instance, props: { [string]: any }): Part
	props.Material = Enum.Material.Neon
	props.CanCollide = false
	return part(parent, props)
end

-- ============================================================
-- LOBBY
-- ============================================================
local function buildLobby(): Folder
	local lobby = Instance.new("Folder")
	lobby.Name = "Lobby"

	-- Sol principal
	local floor = part(lobby, {
		Name = "LobbyFloor",
		Size = Vector3.new(WorldFactory.LOBBY_SIZE, 4, WorldFactory.LOBBY_SIZE),
		Position = Vector3.new(0, -2, 0),
		Color = Color3.fromRGB(120, 200, 255),
		Material = Enum.Material.SmoothPlastic,
	})
	floor:SetAttribute("Permanent", true)

	-- Bordure décorative
	for _, offset in ipairs({
		{ Vector3.new(0, 0, -WorldFactory.LOBBY_SIZE / 2), Vector3.new(WorldFactory.LOBBY_SIZE, 6, 6) },
		{ Vector3.new(0, 0, WorldFactory.LOBBY_SIZE / 2), Vector3.new(WorldFactory.LOBBY_SIZE, 6, 6) },
		{ Vector3.new(-WorldFactory.LOBBY_SIZE / 2, 0, 0), Vector3.new(6, 6, WorldFactory.LOBBY_SIZE) },
		{ Vector3.new(WorldFactory.LOBBY_SIZE / 2, 0, 0), Vector3.new(6, 6, WorldFactory.LOBBY_SIZE) },
	}) do
		neon(lobby, {
			Name = "Border",
			Size = offset[2],
			Position = offset[1] + Vector3.new(0, 2, 0),
			Color = Color3.fromRGB(90, 220, 255),
			Transparency = 0.25,
		})
	end

	-- Spawn officiel
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Size = Vector3.new(24, 1, 24)
	spawn.Position = WorldFactory.LOBBY_SPAWN - Vector3.new(0, 5, 0)
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Color = Color3.fromRGB(90, 220, 255)
	spawn.Material = Enum.Material.Neon
	spawn.Transparency = 0.35
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = lobby
	label(spawn, "SPAWN", Color3.fromRGB(255, 255, 255), Vector2.new(150, 40))

	-- Autel de Rebirth
	local altar = Instance.new("Model")
	altar.Name = "RebirthAltar"
	altar.Parent = lobby

	part(altar, {
		Name = "AltarBase",
		Size = Vector3.new(46, 2, 46),
		Position = Vector3.new(0, 1, -30),
		Color = Color3.fromRGB(255, 215, 90),
		Material = Enum.Material.Neon,
	})
	part(altar, {
		Name = "AltarPillar",
		Size = Vector3.new(14, 26, 14),
		Position = Vector3.new(0, 15, -30),
		Color = Color3.fromRGB(255, 240, 180),
		Material = Enum.Material.Marble,
	})
	local orb = neon(altar, {
		Name = "AltarOrb",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(16, 16, 16),
		Position = Vector3.new(0, 34, -30),
		Color = Color3.fromRGB(255, 230, 120),
		Transparency = 0.15,
	})
	orb:SetAttribute("Animated", "float")

	local altarLight = Instance.new("PointLight")
	altarLight.Brightness = 4
	altarLight.Range = 60
	altarLight.Color = Color3.fromRGB(255, 220, 120)
	altarLight.Parent = orb

	label(orb, "⟳ REBIRTH", Color3.fromRGB(255, 235, 150), Vector2.new(320, 80))

	-- Portails des mondes
	local portals = Instance.new("Folder")
	portals.Name = "Portals"
	portals.Parent = lobby

	local firstX = -250
	for index, world in ipairs(GameConfig.Worlds) do
		local portalModel = Instance.new("Model")
		portalModel.Name = "Portal" .. tostring(index)
		portalModel:SetAttribute("WorldIndex", index)
		portalModel.Parent = portals

		local position = Vector3.new(firstX + (index - 1) * 100, 0, -155)

		-- Pad au sol
		local pad = neon(portalModel, {
			Name = "Pad",
			Size = Vector3.new(30, 1, 30),
			Position = position + Vector3.new(0, 1, 0),
			Color = world.FloorColor,
			Transparency = 0.25,
		})
		pad:SetAttribute("PortalPad", index)

		-- Arche
		local archLeft = neon(portalModel, {
			Name = "ArchL",
			Size = Vector3.new(4, 30, 4),
			Position = position + Vector3.new(-13, 15, 0),
			Color = world.SkyColor,
			Transparency = 0.15,
		})
		local archRight = neon(portalModel, {
			Name = "ArchR",
			Size = Vector3.new(4, 30, 4),
			Position = position + Vector3.new(13, 15, 0),
			Color = world.SkyColor,
			Transparency = 0.15,
		})
		local archTop = neon(portalModel, {
			Name = "ArchTop",
			Size = Vector3.new(30, 4, 4),
			Position = position + Vector3.new(0, 30, 0),
			Color = world.SkyColor,
			Transparency = 0.15,
		})

		-- Champ d'énergie
		local field = neon(portalModel, {
			Name = "Field",
			Size = Vector3.new(22, 28, 1),
			Position = position + Vector3.new(0, 16, 0),
			Color = world.SkyColor,
			Transparency = 0.55,
		})
		field:SetAttribute("Animated", "portal")
		field:SetAttribute("WorldIndex", index)

		local fieldLight = Instance.new("PointLight")
		fieldLight.Brightness = 2
		fieldLight.Range = 40
		fieldLight.Color = world.SkyColor
		fieldLight.Parent = field

		label(archTop, "PORTAL " .. tostring(index), Color3.fromRGB(255, 255, 255), Vector2.new(240, 50))
		label(archTop, string.upper(world.Name) .. "  " .. world.Emoji, Color3.fromRGB(255, 255, 255), Vector2.new(360, 60)).StudsOffset = Vector3.new(0, 6, 0)

		archLeft.Name = "ArchL"
		archRight.Name = "ArchR"
	end

	-- Piédestal de l'œuf du noob (gratuit)
	local eggPedestal = Instance.new("Model")
	eggPedestal.Name = "EggPedestal_StarterEgg"
	eggPedestal:SetAttribute("EggId", "StarterEgg")
	eggPedestal.Parent = lobby

	part(eggPedestal, {
		Name = "Base",
		Size = Vector3.new(16, 2, 16),
		Position = Vector3.new(-90, 1, 30),
		Color = Color3.fromRGB(240, 240, 240),
		Material = Enum.Material.Marble,
	})
	local egg = neon(eggPedestal, {
		Name = "Egg",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(10, 13, 10),
		Position = Vector3.new(-90, 9, 30),
		Color = Color3.fromRGB(255, 255, 255),
		Transparency = 0.1,
	})
	egg:SetAttribute("Animated", "float")
	label(egg, "🥚 ŒUF GRATUIT", Color3.fromRGB(255, 255, 255), Vector2.new(300, 70))

	-- Panneau du jeu
	local sign = part(lobby, {
		Name = "GameSign",
		Size = Vector3.new(150, 40, 3),
		Position = Vector3.new(0, 70, -195),
		Color = Color3.fromRGB(25, 25, 40),
		Material = Enum.Material.SmoothPlastic,
	})
	local surface = Instance.new("SurfaceGui")
	surface.Face = Enum.NormalId.Front
	surface.CanvasSize = Vector2.new(1500, 400)
	surface.Parent = sign

	local title = Instance.new("TextLabel")
	title.Size = UDim2.fromScale(1, 0.62)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.FredokaOne
	title.Text = "NOOB ➜ GOD SIMULATOR"
	title.TextScaled = true
	title.TextColor3 = Color3.fromRGB(255, 230, 100)
	title.TextStrokeTransparency = 0
	title.TextStrokeColor3 = Color3.fromRGB(255, 60, 180)
	title.Parent = surface

	local subtitle = Instance.new("TextLabel")
	subtitle.Position = UDim2.fromScale(0, 0.62)
	subtitle.Size = UDim2.fromScale(1, 0.32)
	subtitle.BackgroundTransparency = 1
	subtitle.Font = Enum.Font.GothamBold
	subtitle.Text = "Absorbe. Grandis. Deviens un dieu. 👑"
	subtitle.TextScaled = true
	subtitle.TextColor3 = Color3.fromRGB(200, 240, 255)
	subtitle.Parent = surface

	for _, offset in ipairs({ Vector3.new(-70, 20, 0), Vector3.new(70, 20, 0) }) do
		neon(lobby, {
			Name = "SignPillar",
			Size = Vector3.new(6, 50, 6),
			Position = Vector3.new(0, 45, -195) + offset,
			Color = Color3.fromRGB(120, 80, 255),
			Transparency = 0.2,
		})
	end

	-- Tableau des scores du serveur (SurfaceGui rempli par LeaderboardManager)
	local board = part(lobby, {
		Name = "ServerBoard",
		Size = Vector3.new(70, 48, 3),
		Position = Vector3.new(140, 46, 40),
		Color = Color3.fromRGB(20, 22, 34),
		Material = Enum.Material.SmoothPlastic,
	})
	board.CFrame = CFrame.new(board.Position, Vector3.new(140, 46, 200))
	local boardGui = Instance.new("SurfaceGui")
	boardGui.Name = "ServerLeaderboard"
	boardGui.Face = Enum.NormalId.Front
	boardGui.CanvasSize = Vector2.new(700, 480)
	boardGui.Parent = board

	local boardTitle = Instance.new("TextLabel")
	boardTitle.Name = "Title"
	boardTitle.Size = UDim2.new(1, 0, 0, 60)
	boardTitle.BackgroundTransparency = 1
	boardTitle.Font = Enum.Font.FredokaOne
	boardTitle.Text = "🏆 TOP DU SERVEUR"
	boardTitle.TextScaled = true
	boardTitle.TextColor3 = Color3.fromRGB(255, 220, 90)
	boardTitle.Parent = boardGui

	local boardList = Instance.new("Frame")
	boardList.Name = "List"
	boardList.Position = UDim2.new(0, 10, 0, 70)
	boardList.Size = UDim2.new(1, -20, 1, -80)
	boardList.BackgroundTransparency = 1
	boardList.Parent = boardGui
	local listLayout = Instance.new("UIListLayout")
	listLayout.Padding = UDim.new(0, 4)
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Parent = boardList

	-- Décor du lobby : petits noobs en statue
	for index = 1, 10 do
		local angle = (index / 10) * math.pi * 2
		local radius = 190
		local position = Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius - 20)
		local statue = part(lobby, {
			Name = "Statue",
			Size = Vector3.new(6, 10, 6),
			Position = position + Vector3.new(0, 5, 0),
			Color = Color3.fromRGB(255, 214, 80),
			Material = Enum.Material.SmoothPlastic,
		})
		local head = part(lobby, {
			Name = "StatueHead",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(6, 6, 6),
			Position = position + Vector3.new(0, 13, 0),
			Color = Color3.fromRGB(255, 235, 150),
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
		})
		statue.CanCollide = false
		head.CanCollide = false
	end

	lobby.Parent = Workspace
	return lobby
end

