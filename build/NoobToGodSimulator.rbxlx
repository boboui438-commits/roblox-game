            <ProtectedString name="Source">--!strict
--[[
	DailyUI  |  StarterPlayer.StarterPlayerScripts.UI.DailyUI
	------------------------------------------------------------------
	Récompenses quotidiennes : 7 jours, série, cooldown de 20 h.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local Formulas = require(Modules:WaitForChild("Formulas"))
local Net = require(Modules:WaitForChild("Net"))

local UIConfig = require(script.Parent.UIConfig)
local UILib = require(script.Parent.UILib)
local ClientState = require(script.Parent.Parent.Controllers.ClientState)

local DailyUI = {}

local C = UIConfig.Colors

function DailyUI.show(ctx)
	local frame, content = UILib.showModal(ctx.screenGui, "daily", "📅 RÉCOMPENSE QUOTIDIENNE", { Size = UDim2.fromOffset(700, 520) })
	UILib.clearContent(content)

	local infoLabel = UILib.label(content, "", {
		Size = UDim2.new(1, -8, 0, 40),
		Font = UIConfig.FontBold,
		TextSize = 14,
		Color = C.Text,
		TextWrapped = true,
		LayoutOrder = 0,
	})
	infoLabel.Name = "Info"

	local gridHolder = Instance.new("Frame")
	gridHolder.Name = "Days"
	gridHolder.Size = UDim2.new(1, -8, 0, 220)
	gridHolder.BackgroundTransparency = 1
	gridHolder.LayoutOrder = 1
	gridHolder.Parent = content
	UILib.grid(gridHolder, UDim2.fromOffset(148, 100), UDim2.fromOffset(8, 8))

	local dayCards = {}
	for dayIndex, reward in ipairs(GameConfig.DailyRewards) do
		local card = UILib.card(gridHolder, {
			Name = "Day" .. dayIndex,
			Size = UDim2.fromOffset(148, 100),
			Color = C.Card,
			LayoutOrder = dayIndex,
			StrokeColor = C.Gold,
			StrokeTransparency = 0.6,
		})

		UILib.label(card, "JOUR " .. dayIndex, {
			Size = UDim2.new(1, 0, 0, 20),
			Position = UDim2.fromOffset(0, 8),
			Font = UIConfig.FontBold,
			TextSize = 12,
			Color = C.Gold,
		})

		UILib.label(card, "🪙 " .. Formulas.formatNumber(reward.Coins), {
			Size = UDim2.new(1, 0, 0, 22),
			Position = UDim2.fromOffset(0, 32),
			Font = UIConfig.FontTitle,
			TextSize = 16,
			Color = C.Text,
		})

		local extraText = ""
		if reward.BoostMinutes then
			extraText = string.format("🚀 boost %dmin", reward.BoostMinutes)
		elseif reward.FreeEgg then
			extraText = "🥚 œuf offert"
		end
		UILib.label(card, extraText, {
			Size = UDim2.new(1, -8, 0, 16),
			Position = UDim2.fromOffset(0, 56),
			Font = UIConfig.FontSmall,
			TextSize = 10,
			Color = C.Orange,
		})

		local statusLabel = UILib.label(card, "", {
			Size = UDim2.new(1, 0, 0, 20),
			Position = UDim2.fromOffset(0, 74),
			Font = UIConfig.FontBold,
			TextSize = 11,
			Color = C.Green,
		})
		statusLabel.Name = "Status"

		dayCards[dayIndex] = { Card = card, Status = statusLabel }
	end

	local claimButton = UILib.button(content, "RÉCLAMER", {
		Name = "Claim",
		Size = UDim2.new(1, -8, 0, 58),
		Color = C.Green,
		TextColor = C.TextDark,
		Radius = UIConfig.Radius.Large,
		LayoutOrder = 2,
		Gradient = { C.Green, Color3.fromRGB(70, 220, 130) },
	})
	claimButton.MouseButton1Click:Connect(function()
		Net.event("ClaimDaily"):FireServer()
	end)

	local streakLabel = UILib.label(content, "", {
		Size = UDim2.new(1, -8, 0, 26),
		Font = UIConfig.FontSmall,
		TextSize = 12,
		Color = C.TextDim,
		LayoutOrder = 3,
	})
	streakLabel.Name = "Streak"

	local function refresh()
		local profile = ClientState.profile
		local daily = profile.daily or { lastClaim = 0, streak = 0, dayIndex = 1 }
		local remaining = math.max(0, GameConfig.DailyResetSeconds - (os.time() - (daily.lastClaim or 0)))
		local available = remaining &lt;= 0

		claimButton.Text = available and "RÉCLAMER MA RÉCOMPENSE" or ("⏳ DANS " .. Formulas.formatTime(remaining))
		claimButton.BackgroundColor3 = available and C.Green or C.PanelLight
		claimButton.TextColor3 = available and C.TextDark or C.TextDim

		for dayIndex, data in pairs(dayCards) do
			local isCurrent = dayIndex == (daily.dayIndex or 1)
			local claimed = dayIndex &lt; (daily.dayIndex or 1)
			data.Status.Text = claimed and "✅ réclamé" or (isCurrent and (available and "👉 à réclamer" or "⏳ bientôt") or "🔒 à venir")
			data.Status.TextColor3 = claimed and C.TextDim or (isCurrent and C.Gold or C.TextDim)
			data.Card.BackgroundColor3 = isCurrent and C.PanelLight or C.Card
			data.Card:FindFirstChildOfClass("UIStroke").Transparency = isCurrent and 0.2 or 0.7
		end

		infoLabel.Text = available
			and "Ta récompense est prête ! Reviens tous les jours pour garder ta série."
			or "Tu as déjà réclamé aujourd'hui. Reviens plus tard pour le jour suivant !"
		streakLabel.Text = string.format("🔥 Série actuelle : %d jour(s)  •  Total réclamé : %s fois", daily.streak or 0, Formulas.formatNumber((profile.stats and profile.stats.dailies) or 0))
	end

	refresh()
	return refresh
end

return DailyUI
</ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item><Item class="ModuleScript" referent="RBX002E">
          <Properties>
            <string name="Name">HudUI</string>
            <ProtectedString name="Source">--!strict
--[[
	HudUI  |  StarterPlayer.StarterPlayerScripts.UI.HudUI
	------------------------------------------------------------------
	Interface permanente (HUD) :

	  ⚡ Puissance (+ multiplicateur)      🪙 Pièces      🔄 Rebirths
	  Barre de progression vers la transformation suivante
	  Bannière d'événement avec compte à rebours (en haut au centre)
	  Colonne de boutons : Boutique, Œufs, Pets, Rebirth, Mondes,
	                       Classement, Succès, Quotidien, Réglages
	  Bouton ASPIRER (VACUUM) avec cooldown
	  Indicateur d'absorption automatique

	S'adapte aux téléphones/tablettes/PC via un UIScale calculé sur la
	taille de l'écran.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local Formulas = require(Modules:WaitForChild("Formulas"))
local Net = require(Modules:WaitForChild("Net"))

local UIConfig = require(script.Parent.UIConfig)
local UILib = require(script.Parent.UILib)
local ClientState = require(script.Parent.Parent.Controllers.ClientState)

local HudUI = {}

local C = UIConfig.Colors

local refs = {}
local currentPower = 0
local currentCoins = 0
local vacuumCooldownEnd = 0
local vacuumCooldownTotal = 12

-- ============================================================
-- CONSTRUCTION
-- ============================================================
local function buildStatCard(parent: Instance, emoji: string, caption: string, color: Color3, layoutOrder: number)
	local card = UILib.panel(parent, {
		Name = caption .. "Card",
		Size = UDim2.fromOffset(150, 62),
		Color = C.Panel,
		Radius = UIConfig.Radius.Medium,
		LayoutOrder = layoutOrder,
		StrokeColor = color,
		StrokeTransparency = 0.55,
	})
	local icon = UILib.label(card, emoji, {
		Size = UDim2.fromOffset(40, 40),
		Position = UDim2.fromOffset(10, 11),
		Font = UIConfig.FontTitle,
		TextScaled = true,
	})
	icon.Name = "Icon"

	local cap = UILib.label(card, caption, {
		Size = UDim2.new(1, -60, 0, 16),
		Position = UDim2.fromOffset(52, 10),
		Font = UIConfig.FontBold,
		TextSize = 11,
		Color = C.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	cap.Name = "Caption"

	local value = UILib.label(card, "0", {
		Size = UDim2.new(1, -60, 0, 26),
		Position = UDim2.fromOffset(52, 26),
		Font = UIConfig.FontTitle,
		TextScaled = true,
		Color = color,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	value.Name = "Value"
	UILib.padding(card, 0, 0, 0, 10)

	return card, value
end

function HudUI.start(screenGui: ScreenGui, ctx)
	-- Conteneur racine (scalé pour mobile)
	local root = Instance.new("Frame")
	root.Name = "Root"
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundTransparency = 1
	root.Parent = screenGui
	refs.root = root

	local scale = Instance.new("UIScale")
	scale.Parent = root
	refs.scale = scale

	local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
	local function computeScale()
		local cam = workspace.CurrentCamera
		local size = cam and cam.ViewportSize or viewport
		-- 1.0 de référence sur 1000px de haut
		return math.clamp(size.Y / 900, 0.72, 1.15)
	end
	scale.Scale = computeScale()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			scale.Scale = computeScale()
		end)
	end

	-- ============================================================
	-- BLOC DE GAUCHE : puissance / pièces / rebirths
	-- ============================================================
	local leftColumn = Instance.new("Frame")
	leftColumn.Name = "LeftColumn"
	leftColumn.Size = UDim2.fromOffset(320, 200)
	leftColumn.Position = UDim2.fromOffset(16, 12)
	leftColumn.BackgroundTransparency = 1
	leftColumn.Parent = root
	UILib.list(leftColumn, { Padding = UDim.new(0, 8), HorizontalAlignment = Enum.HorizontalAlignment.Left })

	-- Carte de puissance
	local powerCard = UILib.panel(leftColumn, {
		Name = "PowerCard",
		Size = UDim2.fromOffset(320, 86),
		Color = C.Panel,
		Radius = UIConfig.Radius.Large,
		LayoutOrder = 1,
		StrokeColor = C.Gold,
		StrokeTransparency = 0.4,
		Gradient = { C.PanelLight, C.Panel },
		GradientRotation = 120,
	})

	local powerIcon = UILib.label(powerCard, "⚡", {
		Size = UDim2.fromOffset(54, 54),
		Position = UDim2.fromOffset(12, 16),
		Font = UIConfig.FontTitle,
		TextScaled = true,
	})
	powerIcon.Name = "Icon"

	local powerCaption = UILib.label(powerCard, "PUISSANCE", {
		Size = UDim2.new(1, -90, 0, 16),
		Position = UDim2.fromOffset(74, 10),
		Font = UIConfig.FontBold,
		TextSize = 12,
		Color = C.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	local powerValue = UILib.label(powerCard, "0", {
		Size = UDim2.new(1, -100, 0, 40),
		Position = UDim2.fromOffset(74, 26),
		Font = UIConfig.FontTitle,
		TextScaled = true,
		Color = C.Gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Stroke = true,
	})
	powerValue.Name = "PowerValue"
	refs.powerValue = powerValue

	local multChip = UILib.panel(powerCard, {
		Name = "MultiplierChip",
		Size = UDim2.fromOffset(72, 26),
		Position = UDim2.new(1, -84, 0, 10),
		Color = C.Purple,
		Radius = UIConfig.Radius.Pill,
		Stroke = false,
	})
	local multLabel = UILib.label(multChip, "×1", {
		Size = UDim2.fromScale(1, 1),
		Font = UIConfig.FontBold,
		TextScaled = true,
		Color = C.TextDark,
	})
	multLabel.Name = "Text"
	UILib.padding(multChip, 2, 2, 6, 6)
	refs.multiplier = multLabel

	-- Ligne pièces / rebirths
	local row = Instance.new("Frame")
	row.Name = "StatsRow"
	row.Size = UDim2.fromOffset(320, 62)
	row.BackgroundTransparency = 1
	row.LayoutOrder = 2
	row.Parent = leftColumn
	UILib.list(row, { Padding = UDim.new(0, 8), HorizontalAlignment = Enum.HorizontalAlignment.Left })
	local rowDirection = Instance.new("UIGridLayout")
	rowDirection.CellSize = UDim2.fromOffset(156, 62)
	rowDirection.CellPadding = UDim2.fromOffset(8, 0)
	rowDirection.FillDirection = Enum.FillDirection.Horizontal
	rowDirection.SortOrder = Enum.SortOrder.LayoutOrder
	rowDirection.Parent = row
	if row:FindFirstChildOfClass("UIListLayout") then
		row:FindFirstChildOfClass("UIListLayout"):Destroy()
	end

	local _, coinValue = buildStatCard(row, "🪙", "PIÈCES", C.Gold, 1)
	local _, rebirthValue = buildStatCard(row, "🔄", "REBIRTHS", C.Pink, 2)
	refs.coins = coinValue
	refs.rebirths = rebirthValue

	-- Barre de transformation
	local tierCard = UILib.panel(leftColumn, {
		Name = "TierCard",
		Size = UDim2.fromOffset(320, 54),
		Color = C.Panel,
		Radius = UIConfig.Radius.Medium,
		LayoutOrder = 3,
		StrokeColor = C.Blue,
		StrokeTransparency = 0.6,
	})
	local tierLabel = UILib.label(tierCard, "🪵 Noob", {
		Size = UDim2.new(1, -20, 0, 18),
		Position = UDim2.fromOffset(10, 7),
		Font = UIConfig.FontTitle,
		TextSize = 14,
		Color = C.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	tierLabel.Name = "TierLabel"
	refs.tierLabel = tierLabel

	local tierBarHolder, tierBarFill = UILib.bar(tierCard, {
		Size = UDim2.new(1, -20, 0, 10),
		Position = UDim2.fromOffset(10, 30),
		Color = C.Blue,
	})
	refs.tierBar = tierBarFill

	local tierProgressLabel = UILib.label(tierCard, "", {
		Size = UDim2.new(1, -20, 0, 12),
		Position = UDim2.fromOffset(10, 40),
		Font = UIConfig.FontSmall,
		TextSize = 10,
		Color = C.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	refs.tierProgress = tierProgressLabel

	-- ============================================================
	-- BANNIÈRE D'ÉVÉNEMENT (haut centre)
	-- ============================================================
	local eventBanner = UILib.panel(root, {
		Name = "EventBanner",
		Size = UDim2.fromOffset(420, 62),
		Position = UDim2.new(0.5, 0, 0, 12),
		AnchorPoint = Vector2.new(0.5, 0),
		Color = C.Panel,
		Radius = UIConfig.Radius.Pill,
		StrokeColor = C.Gold,
		StrokeThickness = 2,
		Gradient = { C.PanelLight, C.Panel },
		GradientRotation = 90,
	})
	eventBanner.Visible = false
	refs.eventBanner = eventBanner

	local eventEmoji = UILib.label(eventBanner, "🎉", {
		Size = UDim2.fromOffset(44, 44),
		Position = UDim2.fromOffset(12, 9),
		Font = UIConfig.FontTitle,
		TextScaled = true,
	})
	eventEmoji.Name = "Emoji"
	refs.eventEmoji = eventEmoji

	local eventTitle = UILib.label(eventBanner, "ÉVÉNEMENT", {
		Size = UDim2.new(1, -140, 0, 20),
		Position = UDim2.fromOffset(62, 12),
		Font = UIConfig.FontBold,
		TextSize = 13,
		Color = C.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	refs.eventTitle = eventTitle

	local eventTimer = UILib.label(eventBanner, "1:00", {
		Size = UDim2.new(1, -140, 0, 18),
		Position = UDim2.fromOffset(62, 32),
		Font = UIConfig.FontTitle,
		TextSize = 15,
		Color = C.Gold,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	refs.eventTimer = eventTimer

	local eventBarHolder, eventBarFill = UILib.bar(eventBanner, {
		Size = UDim2.fromOffset(70, 8),
		Position = UDim2.new(1, -84, 0.5, -4),
		Color = C.Gold,
	})
	refs.eventBar = eventBarFill

	-- ============================================================
	-- COLONNE DE BOUTONS (droite)
	-- ============================================================
	local buttonPanel = Instance.new("Frame")
	buttonPanel.Name = "Buttons"
	buttonPanel.Size = UDim2.fromOffset(176, 430)
	buttonPanel.Position = UDim2.new(1, -16, 0, 96)
	buttonPanel.AnchorPoint = Vector2.new(1, 0)
	buttonPanel.BackgroundTransparency = 1
	buttonPanel.Parent = root

	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromOffset(84, 84)
	grid.CellPadding = UDim2.fromOffset(4, 4)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.FillDirection = Enum.FillDirection.Horizontal
	grid.HorizontalAlignment = Enum.HorizontalAlignment.Right
	grid.Parent = buttonPanel
	refs.buttonPanel = buttonPanel

	local buttons = {
		{ Id = "shop", Emoji = "🛒", Caption = "Boutique", Color = C.Gold },
		{ Id = "eggs", Emoji = "🥚", Caption = "Œufs", Color = C.Orange },
		{ Id = "pets", Emoji = "🐾", Caption = "Pets", Color = C.Purple },
		{ Id = "rebirth", Emoji = "🔄", Caption = "Rebirth", Color = C.Pink },
		{ Id = "worlds", Emoji = "🌍", Caption = "Mondes", Color = C.Blue },
		{ Id = "ranks", Emoji = "🏆", Caption = "Classement", Color = C.Gold },
		{ Id = "achievements", Emoji = "🏅", Caption = "Succès", Color = C.Green },
		{ Id = "daily", Emoji = "📅", Caption = "Quotidien", Color = C.Cyan },
		{ Id = "settings", Emoji = "⚙️", Caption = "Réglages", Color = C.Card },
	}

	for index, buttonInfo in ipairs(buttons) do
		local button = UILib.iconButton(buttonPanel, buttonInfo.Emoji, buttonInfo.Caption, {
			Name = "Btn_" .. buttonInfo.Id,
			Color = C.Card,
			StrokeColor = buttonInfo.Color,
		})
		button.Parent.LayoutOrder = index
		button.LayoutOrder = index
		button.MouseButton1Click:Connect(function()
			if ctx and ctx.openModal then
				ctx.openModal(buttonInfo.Id)
			end
		end)
		refs["btn_" .. buttonInfo.Id] = button
		if buttonInfo.Id == "daily" then
			local badge = button:FindFirstChild("Badge")
			if badge then
				badge.Text = "!"
				badge.TextColor3 = C.Red
			end
		end
	end

	-- ============================================================
	-- BOUTON VACUUM (bas centre)
	-- ============================================================
	local vacuumHolder = Instance.new("Frame")
	vacuumHolder.Name = "VacuumHolder"
	vacuumHolder.Size = UDim2.fromOffset(300, 76)
	vacuumHolder.Position = UDim2.new(0.5, 0, 1, -22)
	vacuumHolder.AnchorPoint = Vector2.new(0.5, 1)
	vacuumHolder.BackgroundTransparency = 1
	vacuumHolder.Parent = root

	local vacuumButton = UILib.button(vacuumHolder, "", {
		Name = "VacuumButton",
		Size = UDim2.fromOffset(280, 70),
		Position = UDim2.new(0.5, 0, 1, 0),
		AnchorPoint = Vector2.new(0.5, 1),
		Color = C.Purple,
		Radius = UIConfig.Radius.Pill,
		Gradient = { C.Purple, C.Pink },
		GradientRotation = 0,
		StrokeColor = C.White,
		StrokeThickness = 2,
	})
	refs.vacuumButton = vacuumButton

	local vacuumLabel = UILib.label(vacuumButton, "🌪️ ASPIRER", {
		Size = UDim2.fromScale(1, 0.55),
		Position = UDim2.fromScale(0, 0.08),
		Font = UIConfig.FontTitle,
		TextScaled = true,
		Color = C.Text,
		Stroke = true,
	})
	vacuumLabel.Name = "Label"
	UILib.padding(vacuumLabel, 6, 0, 20, 20)

	local vacuumSub = UILib.label(vacuumButton, "Prêt", {
		Size = UDim2.new(1, 0, 0, 20),
		Position = UDim2.fromScale(0, 0.66),
		Font = UIConfig.FontBold,
		TextSize = 12,
		Color = C.Text,
	})
	vacuumSub.Name = "Sub"
	refs.vacuumSub = vacuumSub

	local vacuumCooldownOverlay = Instance.new("Frame")
	vacuumCooldownOverlay.Name = "Cooldown"
	vacuumCooldownOverlay.Size = UDim2.fromScale(0, 1)
	vacuumCooldownOverlay.BackgroundColor3 = C.Background
	vacuumCooldownOverlay.BackgroundTransparency = 0.35
	vacuumCooldownOverlay.BorderSizePixel = 0
	vacuumCooldownOverlay.ZIndex = 7
	vacuumCooldownOverlay.Parent = vacuumButton
	UILib.corner(vacuumCooldownOverlay, UIConfig.Radius.Pill)
	refs.vacuumCooldown = vacuumCooldownOverlay

	vacuumButton.MouseButton1Click:Connect(function()
		if os.clock() &lt; vacuumCooldownEnd then
			return
		end
		local profile = ClientState.profile
		local cooldown = Formulas.vacuumCooldown(profile)
		vacuumCooldownTotal = cooldown
		vacuumCooldownEnd = os.clock() + cooldown
		Net.event("VacuumRequest"):FireServer()
		UILib.pulse(vacuumButton, 1.1)
	end)

	-- ============================================================
	-- INDICATEURS (bas gauche)
	-- ============================================================
	local indicators = Instance.new("Frame")
	indicators.Name = "Indicators"
	indicators.Size = UDim2.fromOffset(280, 60)
	indicators.Position = UDim2.new(0, 16, 1, -90)
	indicators.AnchorPoint = Vector2.new(0, 1)
	indicators.BackgroundTransparency = 1
	indicators.Parent = root
	UILib.list(indicators, { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Left })

	local autoChip = UILib.panel(indicators, {
		Name = "AutoChip",
		Size = UDim2.fromOffset(270, 30),
		Color = C.Panel,
		Radius = UIConfig.Radius.Pill,
		LayoutOrder = 1,
		StrokeColor = C.Green,
		StrokeTransparency = 0.5,
	})
	local autoLabel = UILib.label(autoChip, "🌀 Absorption auto : inactive", {
		Size = UDim2.fromScale(1, 1),
		Font = UIConfig.FontBold,
		TextSize = 12,
		Color = C.TextDim,
	})
	autoLabel.Name = "Text"
	UILib.padding(autoChip, 2, 2, 10, 10)
	refs.autoLabel = autoLabel
	refs.autoChip = autoChip

	local boostChip = UILib.panel(indicators, {
		Name = "BoostChip",
		Size = UDim2.fromOffset(270, 30),
		Color = C.Panel,
		Radius = UIConfig.Radius.Pill,
		LayoutOrder = 2,
		StrokeColor = C.Orange,
		StrokeTransparency = 0.5,
	})
	local boostLabel = UILib.label(boostChip, "", {
		Size = UDim2.fromScale(1, 1),
		Font = UIConfig.FontBold,
		TextSize = 12,
		Color = C.Orange,
	})
	boostLabel.Name = "Text"
	UILib.padding(boostChip, 2, 2, 10, 10)
	boostChip.Visible = false
	refs.boostChip = boostChip
	refs.boostLabel = boostLabel

	-- ============================================================
	-- MISE À JOUR
	-- ============================================================
	local function refreshProfile(profile)
		local power = profile.power or 0
		if power ~= currentPower then
			local from = currentPower
			currentPower = power
			if not refs.lastPowerUpdate or os.clock() - refs.lastPowerUpdate &gt; 0.06 then
				refs.lastPowerUpdate = os.clock()
				UILib.animateNumber(powerValue, from, power, function(value)
					return Formulas.formatNumber(math.max(0, value))
				end, 0.35)
			end
		end
		currentCoins = profile.coins or 0
		coinValue.Text = Formulas.formatNumber(currentCoins)
		rebirthValue.Text = tostring(profile.rebirths or 0)
		multLabel.Text = "×" .. string.format("%.2f", ClientState.getPowerMultiplier())

		local tier, tierIndex = ClientState.getTier()
		tierLabel.Text = string.format("%s %s  (Tier %d/%d)", tier.Emoji, tier.Name, tierIndex, #GameConfig.Transformations)
		tierLabel.TextColor3 = tier.Aura
		UILib.setBar(tierBarFill, ClientState.getTierProgress())
		tierBarFill.BackgroundColor3 = tier.Aura
		local nextTier = ClientState.getNextTier()
		if nextTier then
			tierProgressLabel.Text = string.format("%s ⚡ → %s %s", Formulas.formatNumber(nextTier.MinPower), nextTier.Emoji, nextTier.Name)
		else
			tierProgressLabel.Text = "🏆 Transformation MAXIMALE atteinte !"
		end

		-- Auto collect
		local autoLevel = ClientState.getUpgradeLevel("AutoCollect")
		local hasPass = profile.gamePasses and profile.gamePasses.AutoCollect
		if autoLevel &gt; 0 or hasPass then
			autoLabel.Text = string.format("🌀 Absorption auto : ACTIVE (niv. %d)", math.max(autoLevel, 1))
			autoLabel.TextColor3 = C.Green
		else
			autoLabel.Text = "🌀 Absorption auto : inactive (Boutique)"
			autoLabel.TextColor3 = C.TextDim
		end

		-- Badge quotidien
		local dailyButton = refs.btn_daily
		local badge = dailyButton and dailyButton:FindFirstChild("Badge")
		if badge then
			badge.Text = ClientState.dailyAvailable and "!" or ""
		end
	end

	function HudUI.refresh()
		refreshProfile(ClientState.profile)
	end

	ClientState.Signals.Profile:Connect(refreshProfile)
	ClientState.Signals.Event:Connect(function(eventId, endsAt)
		local eventData = eventId and GameConfig.Events[eventId]
		if eventData then
			eventBanner.Visible = true
			eventEmoji.Text = eventData.Emoji
			eventTitle.Text = string.upper(eventData.Name)
			eventTitle.TextColor3 = eventData.Color
			eventTimer.TextColor3 = eventData.Color
			UILib.pulse(eventBanner, 1.04)
		else
			eventBanner.Visible = false
		end
	end)
	ClientState.Signals.Boost:Connect(function(mult, endsAt)
		ClientState.boostMult = mult
		ClientState.boostEndsAt = endsAt
	end)
	ClientState.Signals.Daily:Connect(function(available)
		ClientState.dailyAvailable = available
		refreshProfile(ClientState.profile)
	end)
	ClientState.Signals.World:Connect(function()
		refreshProfile(ClientState.profile)
	end)

	-- Boucle d'animation (compte à rebours, cooldown, boost)
	RunService.Heartbeat:Connect(function()
		if ClientState.eventIsActive() then
			local remaining = ClientState.eventRemaining()
			eventTimer.Text = Formulas.formatTime(remaining)
			local total = GameConfig.Events[ClientState.eventId] and GameConfig.Events[ClientState.eventId].Duration or 60
			UILib.setBar(eventBarFill, remaining / total)
			if remaining &lt;= 0 then
				eventBanner.Visible = false
			end
		end

		-- Cooldown du vacuum
		local now = os.clock()
		if now &lt; vacuumCooldownEnd then
			local remaining = vacuumCooldownEnd - now
			vacuumCooldownOverlay.Size = UDim2.fromScale(remaining / math.max(vacuumCooldownTotal, 0.1), 1)
			vacuumSub.Text = string.format("Recharge… %.1fs", remaining)
			vacuumLabel.TextColor3 = C.TextDim
		else
			vacuumCooldownOverlay.Size = UDim2.fromScale(0, 1)
			local profile = ClientState.profile
			vacuumSub.Text = string.format("Rayon %d • %ds", math.floor(Formulas.vacuumRadius(profile)), math.floor(Formulas.vacuumCooldown(profile)))
			vacuumLabel.TextColor3 = C.Text
		end

		-- Boost
		if ClientState.boostEndsAt &gt; os.time() then
			boostChip.Visible = true
			boostLabel.Text = string.format("🚀 Boost ×%s — %s", tostring(ClientState.boostMult), Formulas.formatTime(ClientState.boostEndsAt - os.time()))
		elseif boostChip.Visible then
			boostChip.Visible = false
		end
	end)

	refreshProfile(ClientState.profile)
	print("[HudUI] Construit")
end

return HudUI
</ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item><Item class="ModuleScript" referent="RBX002F">
          <Properties>
            <string name="Name">LeaderboardUI</string>
            <ProtectedString name="Source">--!strict
--[[
	LeaderboardUI  |  StarterPlayer.StarterPlayerScripts.UI.LeaderboardUI
	------------------------------------------------------------------
	Classement du serveur (temps réel) et classement mondial
	(OrderedDataStore, top 25).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local Formulas = require(Modules:WaitForChild("Formulas"))
local Net = require(Modules:WaitForChild("Net"))
local GameConfig = require(Modules:WaitForChild("GameConfig"))

local UIConfig = require(script.Parent.UIConfig)
local UILib = require(script.Parent.UILib)
local ClientState = require(script.Parent.Parent.Controllers.ClientState)

local LeaderboardUI = {}

local C = UIConfig.Colors

local function buildRow(parent: Instance, entry, layoutOrder: number, isPlayer: boolean)
	local medal = "▫️"
	if isPlayer and entry.Rank == 1 then
		medal = "🥇"
	elseif isPlayer and entry.Rank == 2 then
		medal = "🥈"
	elseif isPlayer and entry.Rank == 3 then
		medal = "🥉"
	end

	local isMe = entry.UserId == Players.LocalPlayer.UserId
	local row = UILib.card(parent, {
		Size = UDim2.new(1, -8, 0, 52),
		Color = (isPlayer and entry.Rank and entry.Rank &lt;= 3) and C.PanelLight or C.Card,
		LayoutOrder = layoutOrder,
		StrokeColor = isMe and C.Gold or C.Stroke,
		StrokeTransparency = isMe and 0.1 or 0.75,
	})

	UILib.label(row, string.format("%s #%d", medal, entry.Rank or layoutOrder), {
		Size = UDim2.fromOffset(74, 52),
		Position = UDim2.fromOffset(6, 0),
		Font = UIConfig.FontBold,
		TextSize = 15,
		Color = C.Gold,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	UILib.label(row, (entry.Name or "???") .. (isMe and "  (toi)" or ""), {
		Size = UDim2.new(1, -420, 0, 52),
		Position = UDim2.fromOffset(84, 0),
		Font = UIConfig.FontBold,
		TextSize = 14,
		Color = isMe and C.Gold or C.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	-- Comparaison de puissance (uniquement pour les autres joueurs du serveur)
	if isPlayer and not isMe then
		local compareButton = UILib.button(row, "⚖️", {
			Size = UDim2.fromOffset(40, 34),
			Position = UDim2.new(1, -340, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			Color = C.PanelLight,
			Radius = UIConfig.Radius.Small,
			TextSize = 16,
		})
		compareButton.MouseButton1Click:Connect(function()
			Net.event("ComparePower"):FireServer(entry.UserId)
		end)
	end

	UILib.label(row, Formulas.formatNumber(entry.Power or 0) .. " ⚡", {
		Size = UDim2.fromOffset(170, 52),
		Position = UDim2.new(1, -290, 0, 0),
		Font = UIConfig.FontTitle,
		TextSize = 16,
		Color = C.Gold,
		TextXAlignment = Enum.TextXAlignment.Right,
	})

	if isPlayer and entry.Rebirths then
		UILib.label(row, string.format("🔄 %d", entry.Rebirths), {
			Size = UDim2.fromOffset(84, 52),
			Position = UDim2.new(1, -96, 0, 0),
			Font = UIConfig.FontBold,
			TextSize = 13,
			Color = C.Pink,
			TextXAlignment = Enum.TextXAlignment.Right,
		})
	end

	return row
end

function LeaderboardUI.show(ctx)
	local frame, content = UILib.showModal(ctx.screenGui, "ranks", "🏆 CLASSEMENT", { Size = UDim2.fromOffset(760, 560) })
	UILib.clearContent(content)

	local header = Instance.new("Frame")
	header.Name = "Header"
	header.Size = UDim2.new(1, -8, 0, 44)
	header.BackgroundTransparency = 1
	header.LayoutOrder = 0
	header.Parent = content
	UILib.list(header, { Padding = UDim.new(0, 8), HorizontalAlignment = Enum.HorizontalAlignment.Left })

	local holder = Instance.new("Frame")
	holder.Name = "Holder"
	holder.Size = UDim2.new(1, -8, 0, 0)
	holder.AutomaticSize = Enum.AutomaticSize.Y
	holder.BackgroundTransparency = 1
	holder.LayoutOrder = 1
	holder.Parent = content
	UILib.list(holder, { Padding = UDim.new(0, 6) })

	local currentTab = "server"

	local function render()
		for _, child in ipairs(holder:GetChildren()) do
			if not child:IsA("UIListLayout") then
				child:Destroy()
			end
		end

		local list = currentTab == "server" and ClientState.serverLeaderboard or ClientState.globalLeaderboard
		if not list or #list == 0 then
			local emptyText = currentTab == "server"
				and "Aucun joueur classé pour le moment… Absorbe des objets !"
				or "Classement mondial en cours de chargement… (il se remplit au fil des parties)"
			local empty = UILib.label(holder, emptyText, {
				Size = UDim2.new(1, -8, 0, 100),
				Font = UIConfig.FontBold,
				TextSize = 14,
				Color = C.TextDim,
				TextWrapped = true,
				LayoutOrder = 1,
			})
			empty.Name = "Empty"
			return
		end

		for index, entry in ipairs(list) do
			if index &gt; GameConfig.Misc.LeaderboardTop then
				break
			end
			buildRow(holder, entry, index, currentTab == "server")
		end
	end

	local function makeTab(tabId: string, label: string, color: Color3)
		local button = UILib.button(header, label, {
			Size = UDim2.fromOffset(190, 42),
			Color = C.PanelLight,
			Radius = UIConfig.Radius.Medium,
			TextSize = 14,
		})
		button:SetAttribute("TabId", tabId)
		button.MouseButton1Click:Connect(function()
			currentTab = tabId
			for _, sibling in ipairs(header:GetChildren()) do
				if sibling:IsA("TextButton") and sibling:GetAttribute("TabId") then
					sibling.BackgroundColor3 = C.PanelLight
					sibling.TextColor3 = C.TextDim
				end
			end
			button.BackgroundColor3 = color
			button.TextColor3 = C.Text
			render()
		end)
		return button
	end

	local serverTab = makeTab("server", "🏠 Ce serveur", C.Blue)
	makeTab("global", "🌐 Mondial", C.Gold)
	serverTab.BackgroundColor3 = C.Blue
	serverTab.TextColor3 = C.Text

	render()

	-- Rafraîchissement des données (RemoteFunction, throttlé)
	local lastFetch = 0
	task.spawn(function()
		if os.clock() - lastFetch &gt; 15 then
			lastFetch = os.clock()
			local global, server = Net.func("GetLeaderboards"):InvokeServer()
			if type(global) == "table" then
				ClientState.globalLeaderboard = global
			end
			if type(server) == "table" then
				ClientState.serverLeaderboard = server
			end
			if frame.Visible then
				render()
			end
		end
	end)

	ClientState.Signals.Leaderboard:Connect(function()
		if frame.Visible then
			render()
		end
	end)

	-- Pas de reconstruction périodique : la liste se met à jour via le
	-- signal Leaderboard (toutes les 8 s) pour ne pas casser le scroll.
	return function() end
end

return LeaderboardUI
</ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item><Item class="ModuleScript" referent="RBX0030">
          <Properties>
            <string name="Name">PetsUI</string>
            <ProtectedString name="Source">--!strict
--[[
	PetsUI  |  StarterPlayer.StarterPlayerScripts.UI.PetsUI
	------------------------------------------------------------------
	Écran "Pets &amp; Œufs" :

	  ONGLET ŒUFS
	    • tous les œufs : prix, prérequis, probabilités de rareté
	    • boutons "Ouvrir" et "Ouvrir ×3" (le serveur débite et tire)

	  ONGLET INVENTAIRE
	    • emplacements équipés (X/Y)
	    • "Équiper les meilleurs" / "Retirer tout"
	    • liste des pets : rareté, niveau, multiplicateur, état
	    • boutons Équiper / Retirer / Fusionner (3 identiques)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local Formulas = require(Modules:WaitForChild("Formulas"))
local Net = require(Modules:WaitForChild("Net"))

local UIConfig = require(script.Parent.UIConfig)
local UILib = require(script.Parent.UILib)
local ClientState = require(script.Parent.Parent.Controllers.ClientState)

local PetsUI = {}

local C = UIConfig.Colors

local function rarityChip(parent: Instance, rarityName: string, layoutOrder: number?)
	local rarity = GameConfig.Rarities[rarityName] or GameConfig.Rarities.Common
	local chip = UILib.panel(parent, {
		Size = UDim2.fromOffset(84, 22),
		Color = rarity.Color,
		Radius = UIConfig.Radius.Pill,
		Stroke = false,
		LayoutOrder = layoutOrder or 1,
	})
	local label = UILib.label(chip, rarity.Name, {
		Size = UDim2.fromScale(1, 1),
		Font = UIConfig.FontBold,
		TextSize = 11,
		Color = C.TextDark,
	})
	label.Name = "Text"
	UILib.padding(chip, 0, 0, 4, 4)
	return chip
end

-- ============================================================
-- ONGLET ŒUFS
-- ============================================================
local function buildEggCard(parent: Instance, eggId: string, layoutOrder: number)
	local egg = GameConfig.Eggs[eggId]
	local card = UILib.card(parent, {
		Name = "Egg_" .. eggId,
		Size = UDim2.new(1, -8, 0, 168),
		Color = C.Card,
		LayoutOrder = layoutOrder,
	})

	local eggCircle = UILib.panel(card, {
		Size = UDim2.fromOffset(84, 84),
		Position = UDim2.fromOffset(14, 14),
		Color = C.Panel,
		Radius = UIConfig.Radius.Pill,
		StrokeColor = egg.Color,
		StrokeThickness = 3,
	})
	local emoji = UILib.label(eggCircle, egg.Emoji, {
		Size = UDim2.fromScale(1, 1),
		Font = UIConfig.FontTitle,
		TextScaled = true,
	})
	emoji.Name = "Emoji"
	UILib.padding(eggCircle, 10)

	local title = UILib.label(card, egg.Name, {
		Size = UDim2.new(1, -320, 0, 24),
		Position = UDim2.fromOffset(112, 12),
		Font = UIConfig.FontTitle,
		TextSize = 18,
		Color = egg.Color,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	title.Name = "Title"

	local priceText = (egg.Price and egg.Price &gt; 0) and ("🪙 " .. Formulas.formatNumber(egg.Price)) or "GRATUIT (1 fois)"
	local requirement = ""
	if egg.MinRebirth and egg.MinRebirth &gt; 0 then
		requirement = string.format("  •  🔄 %d rebirth requis", egg.MinRebirth)
	end

	local subtitle = UILib.label(card, priceText .. requirement, {
		Size = UDim2.new(1, -320, 0, 18),
		Position = UDim2.fromOffset(112, 38),
		Font = UIConfig.FontBold,
		TextSize = 12,
		Color = C.Gold,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	subtitle.Name = "Price"

	-- Probabilités
	local oddsHolder = Instance.new("Frame")
	oddsHolder.Name = "Odds"
	oddsHolder.Size = UDim2.new(1, -140, 0, 0)
	oddsHolder.Position = UDim2.fromOffset(112, 60)
	oddsHolder.AutomaticSize = Enum.AutomaticSize.Y
	oddsHolder.BackgroundTransparency = 1
	oddsHolder.Parent = card
	UILib.list(oddsHolder, { Padding = UDim.new(0, 4), HorizontalAlignment = Enum.HorizontalAlignment.Left })
	local oddsGrid = Instance.new("UIGridLayout")
	oddsGrid.CellSize = UDim2.fromOffset(112, 26)
	oddsGrid.CellPadding = UDim2.fromOffset(6, 6)
	oddsGrid.FillDirection = Enum.FillDirection.Horizontal
	oddsGrid.SortOrder = Enum.SortOrder.LayoutOrder
	oddsGrid.Parent = oddsHolder
	local listLayout = oddsHolder:FindFirstChildOfClass("UIListLayout")
	if listLayout then
		listLayout:Destroy()
	end
	oddsHolder.Size = UDim2.new(1, -140, 0, 60)

	for index, entry in ipairs(Formulas.eggDisplayOdds(eggId)) do
		local rarity = GameConfig.Rarities[entry.Rarity]
		local chip = UILib.panel(oddsHolder, {
			Size = UDim2.fromOffset(112, 26),
			Color = rarity.Color,
			Radius = UIConfig.Radius.Small,
			Stroke = false,
			LayoutOrder = index,
		})
		local chance = entry.Chance
		local text = string.format("%s %s", rarity.Name:sub(1, 3), chance &gt;= 10 and string.format("%.0f%%", chance) or string.format("%.2f%%", chance))
		local label = UILib.label(chip, text, {
			Size = UDim2.fromScale(1, 1),
			Font = UIConfig.FontBold,
			TextSize = 10,
			Color = C.TextDark,
		})
		label.Name = "Text"
		UILib.padding(chip, 0, 0, 3, 3)
	end

	local openButton = UILib.button(card, "OUVRIR", {
		Name = "Open",
		Size = UDim2.fromOffset(150, 48),
		Position = UDim2.new(1, -164, 0, 40),
		Color = C.Green,
		TextColor = C.TextDark,
		Radius = UIConfig.Radius.Medium,
		Gradient = { C.Green, Color3.fromRGB(70, 220, 130) },
	})
	openButton.MouseButton1Click:Connect(function()
		Net.event("OpenEgg"):FireServer(eggId, 1)
		UILib.playClick("pop")
	end)

	local openThreeButton = UILib.button(card, "OUVRIR ×3", {
		Name = "Open3",
		Size = UDim2.fromOffset(150, 40),
		Position = UDim2.new(1, -164, 0, 96),
		Color = C.Purple,
		TextColor = C.Text,
		Radius = UIConfig.Radius.Medium,
		TextSize = 14,
	})
	openThreeButton.MouseButton1Click:Connect(function()
		Net.event("OpenEgg"):FireServer(eggId, 3)
		UILib.playClick("pop")
	end)

	local function refresh()
		local profile = ClientState.profile
		local price = egg.Price or 0
		local isFree = egg.FreeOnePerPlayer and not (profile.freeEggsTaken and profile.freeEggsTaken[eggId])
		local canAfford = isFree or (profile.coins or 0) &gt;= price
		openButton.BackgroundColor3 = canAfford and C.Green or C.PanelLight
		openButton.TextColor3 = canAfford and C.TextDark or C.TextDim
		openButton.Text = isFree and "GRATUIT" or ("🪙 " .. Formulas.formatNumber(price))
		openThreeButton.Visible = not isFree
		openThreeButton.BackgroundColor3 = ((profile.coins or 0) &gt;= price * 3) and C.Purple or C.PanelLight
		openThreeButton.Text = "×3  🪙 " .. Formulas.formatNumber(price * 3)
		openButton.TextScaled = false
	end

	refresh()
	return refresh
end

-- ============================================================
-- ONGLET INVENTAIRE
-- ============================================================
local function buildPetRow(parent: Instance, pet, layoutOrder: number)
	local info = GameConfig.Pets[pet.id]
	if not info then
		return nil
	end
	local rarity = GameConfig.Rarities[info.Rarity]

	local card = UILib.card(parent, {
		Name = "Pet_" .. pet.uid,
		Size = UDim2.new(1, -8, 0, 76),
		Color = C.Card,
		LayoutOrder = layoutOrder,
		StrokeColor = rarity.Color,
		StrokeTransparency = 0.55,
	})

	local iconBox = UILib.panel(card, {
		Size = UDim2.fromOffset(52, 52),
		Position = UDim2.fromOffset(12, 12),
		Color = rarity.Color:Lerp(C.Panel, 0.65),
		Radius = UIConfig.Radius.Medium,
		StrokeColor = rarity.Color,
		StrokeTransparency = 0.3,
	})
	local emoji = UILib.label(iconBox, info.Emoji, {
		Size = UDim2.fromScale(1, 1),
		Font = UIConfig.FontTitle,
		TextScaled = true,
	})
	emoji.Name = "Emoji"
	UILib.padding(iconBox, 8)

	local name = UILib.label(card, info.Name, {
		Size = UDim2.new(1, -360, 0, 20),
		Position = UDim2.fromOffset(74, 9),
		Font = UIConfig.FontBold,
		TextSize = 14,
		Color = rarity.Color,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	name.Name = "Name"

	local power = Formulas.petPower(pet.id, pet.level)
	local detail = UILib.label(card, string.format("Niveau %d  •  ×%s puissance", pet.level or 1, string.format("%.2f", power)), {
		Size = UDim2.new(1, -360, 0, 18),
		Position = UDim2.fromOffset(74, 30),
		Font = UIConfig.FontSmall,
		TextSize = 11,
		Color = C.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	detail.Name = "Detail"

	local chipHolder = Instance.new("Frame")
	chipHolder.Name = "Chips"
	chipHolder.Size = UDim2.fromOffset(100, 20)
	chipHolder.Position = UDim2.fromOffset(74, 50)
	chipHolder.BackgroundTransparency = 1
	chipHolder.Parent = card
	rarityChip(chipHolder, info.Rarity)

	local equipped = ClientState.isEquipped(pet.uid)
	local equipButton = UILib.button(card, equipped and "RETIRER" or "ÉQUIPER", {
		Name = "Equip",
		Size = UDim2.fromOffset(120, 40),
		Position = UDim2.new(1, -252, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Color = equipped and C.PanelLight or C.Green,
		TextColor = equipped and C.TextDim or C.TextDark,
		Radius = UIConfig.Radius.Medium,
		TextSize = 13,
	})
	equipButton.MouseButton1Click:Connect(function()
		if ClientState.isEquipped(pet.uid) then
			Net.event("UnequipPet"):FireServer(pet.uid)
		else
			Net.event("EquipPet"):FireServer(pet.uid)
		end
	end)

	-- Fusion : 3 identiques du même niveau
	local sameLevelCount = ClientState.countPetId(pet.id, pet.level)
	local canFuse = sameLevelCount &gt;= GameConfig.Misc.FuseCount and (pet.level or 1) &lt; GameConfig.Misc.MaxPetLevel
	local fuseButton = UILib.button(card, string.format("FUSIONNER (%d/%d)", sameLevelCount, GameConfig.Misc.FuseCount), {
		Name = "Fuse",
		Size = UDim2.fromOffset(120, 40),
		Position = UDim2.new(1, -126, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Color = canFuse and C.Purple or C.PanelLight,
		TextColor = canFuse and C.Text or C.TextDim,
		Radius = UIConfig.Radius.Medium,
		TextSize = 11,
	})
	fuseButton.MouseButton1Click:Connect(function()
		Net.event("FusePet"):FireServer(pet.id)
	end)

	return card
end

-- ============================================================
-- AFFICHAGE
-- ============================================================
function PetsUI.show(ctx, initialTab: string?)
	local frame, content = UILib.showModal(ctx.screenGui, "pets", "🐾 PETS &amp; ŒUFS", { Size = UDim2.fromOffset(800, 560) })
	UILib.clearContent(content)

	local currentTab = initialTab or "eggs"
	local inventorySignature = ""

	-- En-tête : tabs + emplacements
	local header = Instance.new("Frame")
	header.Name = "Header"
	header.Size = UDim2.new(1, -8, 0, 46)
	header.BackgroundTransparency = 1
	header.LayoutOrder = 0
	header.Parent = content
	UILib.list(header, { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Left })

	local slotLabel = UILib.label(header, "3/3 pets équipés", {
		Size = UDim2.fromOffset(200, 42),
		Position = UDim2.fromOffset(0, 0),
		Font = UIConfig.FontBold,
		TextSize = 13,
		Color = C.Green,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	slotLabel.Name = "Slots"
	slotLabel.LayoutOrder = 5

	local bestButton = UILib.button(header, "✨ MEILLEURS", {
		Size = UDim2.fromOffset(160, 42),
		Color = C.Purple,
		Radius = UIConfig.Radius.Medium,
		TextSize = 13,
	})
	bestButton.LayoutOrder = 4
	bestButton.MouseButton1Click:Connect(function()
		Net.event("EquipBestPets"):FireServer()
	end)

	local holder = Instance.new("Frame")
	holder.Name = "Holder"
	holder.Size = UDim2.new(1, -8, 0, 0)
	holder.AutomaticSize = Enum.AutomaticSize.Y
	holder.BackgroundTransparency = 1
	holder.LayoutOrder = 1
	holder.Parent = content
	UILib.list(holder, { Padding = UDim.new(0, 10) })

	local eggRefreshers = {}

	local function render()
		eggRefreshers = {}
		for _, child in ipairs(holder:GetChildren()) do
			if not child:IsA("UIListLayout") then
				child:Destroy()
			end
		end

		if currentTab == "eggs" then
			for index, eggId in ipairs(GameConfig.EggOrder) do
				table.insert(eggRefreshers, buildEggCard(holder, eggId, index))
			end
		else
			local profile = ClientState.profile
			local pets = {}
			for _, pet in ipairs(profile.pets or {}) do
				table.insert(pets, pet)
			end
			table.sort(pets, function(a, b)
				local aInfo = GameConfig.Pets[a.id]
				local bInfo = GameConfig.Pets[b.id]
				local aOrder = aInfo and GameConfig.Rarities[aInfo.Rarity].Order or 0
				local bOrder = bInfo and GameConfig.Rarities[bInfo.Rarity].Order or 0
				if aOrder ~= bOrder then
					return aOrder &gt; bOrder
				end
				if (a.level or 1) ~= (b.level or 1) then
					return (a.level or 1) &gt; (b.level or 1)
				end
				return (aInfo and aInfo.Mult or 0) &gt; (bInfo and bInfo.Mult or 0)
			end)

			if #pets == 0 then
				local empty = UILib.label(holder, "Aucun pet… Ouvre un œuf dans l'onglet Œufs ! 🥚", {
					Size = UDim2.new(1, -8, 0, 80),
					Font = UIConfig.FontBold,
					TextSize = 15,
					Color = C.TextDim,
					TextWrapped = true,
					LayoutOrder = 1,
				})
				empty.Name = "Empty"
			else
				for index, pet in ipairs(pets) do
					buildPetRow(holder, pet, index)
				end
			end
		end

		local profile = ClientState.profile
		slotLabel.Text = string.format("%d/%d pets équipés", #(profile.equipped or {}), ClientState.getPetSlots())
		slotLabel.TextColor3 = #(profile.equipped or {}) &gt;= ClientState.getPetSlots() and C.Gold or C.Green

		-- signature : évite de reconstruire la liste à chaque mise à jour
		local signatureParts = { tostring(#(profile.pets or {})), tostring(#(profile.equipped or {})) }
		for _, uid in ipairs(profile.equipped or {}) do
			table.insert(signatureParts, uid)
		end
		inventorySignature = table.concat(signatureParts, "|")
	end

	local function makeTab(tabId: string, label: string, color: Color3, order: number)
		local button = UILib.button(header, label, {
			Size = UDim2.fromOffset(170, 42),
			Color = C.PanelLight,
			Radius = UIConfig.Radius.Medium,
			TextSize = 14,
		})
		button.LayoutOrder = order
		button:SetAttribute("TabId", tabId)
		button.MouseButton1Click:Connect(function()
			currentTab = tabId
			for _, sibling in ipairs(header:GetChildren()) do
				if sibling:IsA("TextButton") and sibling:GetAttribute("TabId") then
					sibling.BackgroundColor3 = C.PanelLight
					sibling.TextColor3 = C.TextDim
				end
			end
			button.BackgroundColor3 = color
			button.TextColor3 = C.Text
			render()
		end)
		return button
	end

	local eggsTab = makeTab("eggs", "🥚 Œufs", C.Orange, 1)
	local petsTab = makeTab("pets", "🐾 Inventaire", C.Purple, 2)
	if currentTab == "eggs" then
		eggsTab.BackgroundColor3 = C.Orange
		eggsTab.TextColor3 = C.Text
	else
		petsTab.BackgroundColor3 = C.Purple
		petsTab.TextColor3 = C.Text
	end

	render()

	return function()
		if currentTab == "eggs" then
			for _, refresh in ipairs(eggRefreshers) do
				pcall(refresh)
			end
			local profile = ClientState.profile
			slotLabel.Text = string.format("%d/%d pets équipés", #(profile.equipped or {}), ClientState.getPetSlots())
		else
			local profile = ClientState.profile
			local signatureParts = { tostring(#(profile.pets or {})), tostring(#(profile.equipped or {})) }
			for _, uid in ipairs(profile.equipped or {}) do
				table.insert(signatureParts, uid)
			end
			if table.concat(signatureParts, "|") ~= inventorySignature then
				render()
			end
		end
	end
end

return PetsUI
</ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item><Item class="ModuleScript" referent="RBX0031">
          <Properties>
            <string name="Name">RebirthUI</string>
            <ProtectedString name="Source">--!strict
--[[
	RebirthUI  |  StarterPlayer.StarterPlayerScripts.UI.RebirthUI
	------------------------------------------------------------------
	Écran de Rebirth : coût, multiplicateur actuel/gagné, récompenses,
	prochains paliers et bouton d'action.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local Formulas = require(Modules:WaitForChild("Formulas"))
local Net = require(Modules:WaitForChild("Net"))

local UIConfig = require(script.Parent.UIConfig)
local UILib = require(script.Parent.UILib)
local ClientState = require(script.Parent.Parent.Controllers.ClientState)

local RebirthUI = {}

local C = UIConfig.Colors

function RebirthUI.show(ctx)
	local frame, content = UILib.showModal(ctx.screenGui, "rebirth", "🔄 REBIRTH", { Size = UDim2.fromOffset(700, 560) })
	UILib.clearContent(content)

	-- Carte principale
	local hero = UILib.panel(content, {
		Name = "Hero",
		Size = UDim2.new(1, -8, 0, 210),
		Color = C.Panel,
		Radius = UIConfig.Radius.Large,
		LayoutOrder = 1,
		StrokeColor = C.Pink,
		StrokeThickness = 2,
		Gradient = { C.PanelLight, C.Panel },
		GradientRotation = 120,
	})

	local orb = UILib.panel(hero, {
		Size = UDim2.fromOffset(110, 110),
		Position = UDim2.fromOffset(24, 42),
		Color = C.Pink,
		Radius = UIConfig.Radius.Pill,
		StrokeColor = C.Gold,
		StrokeThickness = 3,
	})
	local orbText = UILib.label(orb, "🔄", {
		Size = UDim2.fromScale(1, 1),
		Font = UIConfig.FontTitle,
		TextScaled = true,
	})
	orbText.Name = "Emoji"
	UILib.padding(orb, 16)

	local rebirthTitle = UILib.label(hero, "Rebirth 0", {
		Size = UDim2.new(1, -200, 0, 34),
		Position = UDim2.fromOffset(154, 20),
		Font = UIConfig.FontTitle,
		TextSize = 26,
		Color = C.Gold,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	rebirthTitle.Name = "RebirthTitle"

	local multText = UILib.label(hero, "", {
		Size = UDim2.new(1, -200, 0, 22),
		Position = UDim2.fromOffset(154, 56),
		Font = UIConfig.FontBold,
		TextSize = 14,
		Color = C.Purple,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	multText.Name = "Multiplier"

	local costText = UILib.label(hero, "", {
		Size = UDim2.new(1, -200, 0, 22),
		Position = UDim2.fromOffset(154, 80),
		Font = UIConfig.FontBody,
		TextSize = 13,
		Color = C.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	costText.Name = "Cost"

	local progressHolder, progressFill = UILib.bar(hero, {
		Size = UDim2.new(1, -190, 0, 16),
		Position = UDim2.fromOffset(154, 110),
		Color = C.Pink,
	})
	progressHolder.Name = "Progress"

	local progressLabel = UILib.label(hero, "", {
		Size = UDim2.new(1, -190, 0, 18),
		Position = UDim2.fromOffset(154, 130),
		Font = UIConfig.FontSmall,
		TextSize = 11,
		Color = C.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	progressLabel.Name = "ProgressLabel"

	local actionButton = UILib.button(hero, "EFFECTUER LE REBIRTH", {
		Name = "Action",
		Size = UDim2.new(1, -190, 0, 48),
		Position = UDim2.fromOffset(154, 150),
		Color = C.Pink,
		TextColor = C.Text,
		Radius = UIConfig.Radius.Pill,
		Gradient = { C.Pink, C.Purple },
	})
	actionButton.MouseButton1Click:Connect(function()
		Net.event("RebirthRequest"):FireServer()
	end)

	-- Informations / paliers
	local infoCard = UILib.card(content, {
		Name = "Info",
		Size = UDim2.new(1, -8, 0, 120),
		Color = C.Card,
		LayoutOrder = 2,
	})
	UILib.padding(infoCard, 12)
	local infoTitle = UILib.label(infoCard, "COMMENT ÇA MARCHE", {
		Size = UDim2.new(1, 0, 0, 20),
		Font = UIConfig.FontBold,
		TextSize = 13,
		Color = C.Gold,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	local infoBody = UILib.label(infoCard, "", {
		Position = UDim2.fromOffset(0, 24),
		Size = UDim2.new(1, 0, 1, -24),
		Font = UIConfig.FontSmall,
		TextSize = 12,
		Color = C.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
	})
	infoBody.Name = "Body"

	-- Paliers de titres
	local tiersCard = UILib.card(content, {
		Name = "Titles",
		Size = UDim2.new(1, -8, 0, 0),
		Color = C.Card,
		LayoutOrder = 3,
	})
	tiersCard.AutomaticSize = Enum.AutomaticSize.Y
	UILib.padding(tiersCard, 12)
	local tiersHolder = Instance.new("Frame")
	tiersHolder.Name = "List"
	tiersHolder.Size = UDim2.new(1, 0, 0, 0)
	tiersHolder.AutomaticSize = Enum.AutomaticSize.Y
	tiersHolder.BackgroundTransparency = 1
	tiersHolder.Parent = tiersCard
	UILib.grid(tiersHolder, UDim2.fromOffset(120, 32), UDim2.fromOffset(8, 8))

	for index, title in ipairs(GameConfig.Titles) do
		local chip = UILib.panel(tiersHolder, {
			Size = UDim2.fromOffset(120, 32),
			Color = C.PanelLight,
			Radius = UIConfig.Radius.Pill,
			LayoutOrder = index,
		})
		chip.Name = "TitleChip_" .. title.Id
		local label = UILib.label(chip, string.format("%s (🔄%d)", title.Name, title.Rebirth), {
			Size = UDim2.fromScale(1, 1),
			Font = UIConfig.FontBold,
			TextSize = 10,
			Color = C.TextDim,
		})
		label.Name = "Text"
		UILib.padding(chip, 0, 0, 4, 4)
	end

	local function refresh()
		local profile = ClientState.profile
		local rebirths = profile.rebirths or 0
		local maxRebirths = GameConfig.Rebirth.MaxRebirths
		local cost = Formulas.rebirthCost(rebirths)
		local power = profile.power or 0

		rebirthTitle.Text = string.format("Rebirth %d / %d", rebirths, maxRebirths)
		multText.Text = string.format(
			"Multiplicateur actuel ×%s  →  ×%s",
			string.format("%.2f", Formulas.rebirthMultiplier(rebirths)),
			string.format("%.2f", Formulas.rebirthMultiplier(math.min(rebirths + 1, maxRebirths)))
		)
		local maxed = rebirths &gt;= maxRebirths
		if maxed then
			costText.Text = "🏆 Tu as atteint le Rebirth maximum ! Respect."
			actionButton.Text = "MAXIMUM ATTEINT"
			actionButton.BackgroundColor3 = C.PanelLight
			actionButton.TextColor3 = C.TextDim
			UILib.setBar(progressFill, 1)
			progressLabel.Text = ""
		else
			costText.Text = string.format("Coût : %s ⚡ (tu as %s)", Formulas.formatNumber(cost), Formulas.formatNumber(power))
			local ratio = math.clamp(power / cost, 0, 1)
			UILib.setBar(progressFill, ratio)
			progressLabel.Text = ratio &gt;= 1
				and string.format("Prêt ! Récompense : +%s 🪙", Formulas.formatNumber(Formulas.rebirthCoinReward(rebirths + 1)))
				or string.format("Encore %s ⚡", Formulas.formatNumber(cost - power))
			actionButton.Text = ratio &gt;= 1 and "EFFECTUER LE REBIRTH 🔄" or "PAS ASSEZ DE PUISSANCE"
			actionButton.BackgroundColor3 = ratio &gt;= 1 and C.Pink or C.PanelLight
			actionButton.TextColor3 = ratio &gt;= 1 and C.Text or C.TextDim
		end

		infoBody.Text = string.format(
			"Le Rebirth remet ta puissance à zéro mais te donne :\n• un multiplicateur PERMANENT (+%d%% par rebirth)\n• des pièces (%s + %s × rebirth)\n• l'accès aux mondes supérieurs et à de nouveaux titres\n\nTes pets et tes améliorations sont CONSERVÉS.",
			math.floor(GameConfig.Rebirth.MultPerRebirth * 100),
			Formulas.formatNumber(GameConfig.Rebirth.CoinRewardBase),
			Formulas.formatNumber(GameConfig.Rebirth.CoinRewardPerRebirth)
		)

		for _, title in ipairs(GameConfig.Titles) do
			local chip = tiersHolder:FindFirstChild("TitleChip_" .. title.Id)
			local text = chip and chip:FindFirstChild("Text")
			if chip and text then
				local unlocked = rebirths &gt;= title.Rebirth
				text.TextColor3 = unlocked and title.Color or C.TextDim
				chip.BackgroundColor3 = unlocked and C.Card or C.PanelLight
			end
		end
	end

	refresh()
	return refresh
end

return RebirthUI
</ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item><Item class="ModuleScript" referent="RBX0032">
          <Properties>
            <string name="Name">SettingsUI</string>
            <ProtectedString name="Source">--!strict
--[[
	SettingsUI  |  StarterPlayer.StarterPlayerScripts.UI.SettingsUI
	------------------------------------------------------------------
	Réglages (music, sfx, effets, particules, shake, pets visibles),
	sélection du titre, statistiques du joueur et crédits.
	Chaque réglage est envoyé au serveur (RemoteEvent SetSetting) pour
	être sauvegardé.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local Formulas = require(Modules:WaitForChild("Formulas"))
local Net = require(Modules:WaitForChild("Net"))

local UIConfig = require(script.Parent.UIConfig)
local UILib = require(script.Parent.UILib)
local ClientState = require(script.Parent.Parent.Controllers.ClientState)

local SettingsUI = {}

local C = UIConfig.Colors

local SETTINGS = {
	{ Key = "music", Label = "🎵 Musique", Desc = "Musique d'ambiance des mondes" },
	{ Key = "sfx", Label = "🔊 Effets sonores", Desc = "Sons d'absorption, boutons, événements" },
	{ Key = "effects", Label = "✨ Effets visuels", Desc = "Particules, flashs, animations d'objets" },
	{ Key = "particles", Label = "💫 Particules", Desc = "Désactive pour + de FPS sur mobile" },
	{ Key = "cameraShake", Label = "📳 Secousse caméra", Desc = "Secousses lors des grosses actions" },
	{ Key = "damageNumbers", Label = "🔢 Nombres flottants", Desc = "Affiche +puissance à chaque absorption" },
	{ Key = "petsVisible", Label = "🐾 Afficher mes pets", Desc = "Masque les pets 3D (performance)" },
}

local function buildToggle(parent: Instance, setting, layoutOrder: number)
	local row = UILib.card(parent, {
		Name = "Setting_" .. setting.Key,
		Size = UDim2.new(1, -8, 0, 60),
		Color = C.Card,
		LayoutOrder = layoutOrder,
	})

	UILib.label(row, setting.Label, {
		Size = UDim2.new(1, -180, 0, 22),
		Position = UDim2.fromOffset(14, 8),
		Font = UIConfig.FontBold,
		TextSize = 14,
		Color = C.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	local desc = UILib.label(row, setting.Desc, {
		Size = UDim2.new(1, -180, 0, 18),
		Position = UDim2.fromOffset(14, 30),
		Font = UIConfig.FontSmall,
		TextSize = 11,
		Color = C.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	desc.Name = "Desc"

	local toggle = UILib.button(row, "", {
		Size = UDim2.fromOffset(70, 34),
		Position = UDim2.new(1, -84, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Color = C.Green,
		Radius = UIConfig.Radius.Pill,
	})

	local knob = UILib.panel(toggle, {
		Size = UDim2.fromOffset(26, 26),
		Position = UDim2.new(1, -30, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Color = C.White,
		Radius = UIConfig.Radius.Pill,
		Stroke = false,
	})
	knob.Name = "Knob"

	local state = ClientState.getSetting(setting.Key)

	local function apply()
		toggle.BackgroundColor3 = state and C.Green or C.PanelLight
		knob.Position = state and UDim2.new(1, -30, 0.5, 0) or UDim2.new(0, 4, 0.5, 0)
		-- application locale immédiate (le serveur sauvegarde aussi)
		if ClientState.profile.settings then
			ClientState.profile.settings[setting.Key] = state
		end
		if setting.Key == "music" then
			ClientState.Signals.Sound:Fire("click", 0.1)
		end
	end

	toggle.MouseButton1Click:Connect(function()
		state = not state
		apply()
		Net.event("SetSetting"):FireServer(setting.Key, state)
	end)

	apply()
	return function()
		local profileState = ClientState.getSetting(setting.Key)
		if profileState ~= state then
			state = profileState
			apply()
		end
	end
end

function SettingsUI.show(ctx)
	local frame, content = UILib.showModal(ctx.screenGui, "settings", "⚙️ RÉGLAGES", { Size = UDim2.fromOffset(720, 580) })
	UILib.clearContent(content)

	local refreshers = {}

	-- Section paramètres
	local settingsSection = UILib.card(content, {
		Name = "SettingsSection",
		Size = UDim2.new(1, -8, 0, 0),
		Color = C.Panel,
		LayoutOrder = 0,
	})
	settingsSection.AutomaticSize = Enum.AutomaticSize.Y
	UILib.padding(settingsSection, 10)
	local settingsHolder = Instance.new("Frame")
	settingsHolder.Name = "Holder"
	settingsHolder.Size = UDim2.new(1, 0, 0, 0)
	settingsHolder.AutomaticSize = Enum.AutomaticSize.Y
	settingsHolder.BackgroundTransparency = 1
	settingsHolder.Parent = settingsSection
	UILib.list(settingsHolder, { Padding = UDim.new(0, 8) })

	local titleHeader = UILib.label(settingsHolder, "PARAMÈTRES", {
		Size = UDim2.new(1, 0, 0, 20),
		Font = UIConfig.FontBold,
		TextSize = 12,
		Color = C.Gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = 0,
	})

	for index, setting in ipairs(SETTINGS) do
		table.insert(refreshers, buildToggle(settingsHolder, setting, index))
	end

	-- Section titres
	local titlesSection = UILib.card(content, {
		Name = "TitlesSection",
		Size = UDim2.new(1, -8, 0, 0),
		Color = C.Panel,
		LayoutOrder = 1,
	})
	titlesSection.AutomaticSize = Enum.AutomaticSize.Y
	UILib.padding(titlesSection, 10)

	local titlesHolder = Instance.new("Frame")
	titlesHolder.Name = "Holder"
	titlesHolder.Size = UDim2.new(1, 0, 0, 0)
	titlesHolder.AutomaticSize = Enum.AutomaticSize.Y
	titlesHolder.BackgroundTransparency = 1
	titlesHolder.Parent = titlesSection
	UILib.list(titlesHolder, { Padding = UDim.new(0, 8) })

	UILib.label(titlesHolder, "TITRE AFFICHÉ AU-DESSUS DE TA TÊTE", {
		Size = UDim2.new(1, 0, 0, 20),
		Font = UIConfig.FontBold,
		TextSize = 12,
		Color = C.Gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = 0,
	})

	local titleButtons = {}
	for index, title in ipairs(GameConfig.Titles) do
		local button = UILib.button(titlesHolder, string.format("%s  (🔄 %d)", title.Name, title.Rebirth), {
			Size = UDim2.new(1, -8, 0, 40),
			Color = C.Card,
			Radius = UIConfig.Radius.Medium,
			TextSize = 13,
		})
		button.LayoutOrder = index
		button:SetAttribute("TitleId", title.Id)
		button.MouseButton1Click:Connect(function()
			Net.event("SelectTitle"):FireServer(title.Id)
		end)
		titleButtons[title.Id] = button
	end

	-- Section statistiques
	local statsSection = UILib.card(content, {
		Name = "StatsSection",
		Size = UDim2.new(1, -8, 0, 0),
		Color = C.Panel,
		LayoutOrder = 2,
	})
	statsSection.AutomaticSize = Enum.AutomaticSize.Y
	UILib.padding(statsSection, 10)
	local statsLabel = UILib.label(statsSection, "", {
		Size = UDim2.new(1, 0, 0, 0),
		Font = UIConfig.FontSmall,
		TextSize = 12,
		Color = C.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
	})
	statsLabel.Name = "Text"
	statsLabel.AutomaticSize = Enum.AutomaticSize.Y
	statsLabel.TextYAlignment = Enum.TextYAlignment.Top

	local function refresh()
		for _, refreshFn in ipairs(refreshers) do
			pcall(refreshFn)
		end

		local profile = ClientState.profile
		local rebirths = profile.rebirths or 0
		for _, title in ipairs(GameConfig.Titles) do
			local button = titleButtons[title.Id]
			if button then
				local unlocked = rebirths &gt;= title.Rebirth
				local selected = profile.titleSelected == title.Id
				button.Text = string.format("%s%s%s  (🔄 %d)", selected and "✅ " or "", unlocked and "" or "🔒 ", title.Name, title.Rebirth)
				button.TextColor3 = unlocked and title.Color or C.TextDim
				button.BackgroundColor3 = selected and C.PanelLight or C.Card
			end
		end

		statsLabel.Text = string.format(
			"📊 TES STATISTIQUES\n• Puissance actuelle : %s ⚡\n• Record de puissance : %s ⚡\n• Puissance totale cumulée : %s ⚡\n• Objets absorbés : %s\n• Œufs ouverts : %s\n• Pets possédés : %d\n• Fusions : %s\n• Rebirths : %d\n• Temps de jeu : %s\n• Multiplicateur total : ×%s",
			Formulas.formatNumber(profile.power or 0),
			Formulas.formatNumber(profile.bestPower or 0),
			Formulas.formatNumber(profile.totalPower or 0),
			Formulas.formatNumber((profile.stats and profile.stats.collected) or 0),
			Formulas.formatNumber((profile.stats and profile.stats.eggsOpened) or 0),
			#(profile.pets or {}),
			Formulas.formatNumber((profile.stats and profile.stats.fusions) or 0),
			rebirths,
			Formulas.formatTime(profile.playtime or 0),
			string.format("%.2f", ClientState.getPowerMultiplier())
		)
	end

	refresh()
	return refresh
end

return SettingsUI
</ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item><Item class="ModuleScript" referent="RBX0033">
          <Properties>
            <string name="Name">ShopUI</string>
            <ProtectedString name="Source">--!strict
--[[
	ShopUI  |  StarterPlayer.StarterPlayerScripts.UI.ShopUI
	------------------------------------------------------------------
	Boutique en 3 onglets :
	  • Améliorations (pièces)   -&gt; remotes BuyUpgrade (validés serveur)
	  • Game Passes (Robux)      -&gt; MarketplaceService:PromptGamePassPurchase
	  • Boosts (Dev Products)    -&gt; MarketplaceService:PromptProductPurchase

	Le client n'accorde JAMAIS rien : il envoie une demande ou ouvre le
	menu d'achat Roblox. Les récompenses sont données par le serveur.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local Formulas = require(Modules:WaitForChild("Formulas"))
local Net = require(Modules:WaitForChild("Net"))

local UIConfig = require(script.Parent.UIConfig)
local UILib = require(script.Parent.UILib)
local ClientState = require(script.Parent.Parent.Controllers.ClientState)

local ShopUI = {}

local C = UIConfig.Colors

local UPGRADE_ORDER = { "PowerMult", "CoinMult", "AutoCollect", "Vacuum", "WalkSpeed", "PetSlots" }

-- ============================================================
-- CARTES D'AMÉLIORATION
-- ============================================================
local function buildUpgradeCard(parent: Instance, upgradeId: string, layoutOrder: number)
	local upgrade = GameConfig.Upgrades[upgradeId]
	local card = UILib.card(parent, {
		Name = "Upgrade_" .. upgradeId,
		Size = UDim2.new(1, -8, 0, 92),
		Color = C.Card,
		LayoutOrder = layoutOrder,
	})

	local iconBox = UILib.panel(card, {
		Size = UDim2.fromOffset(62, 62),
		Position = UDim2.fromOffset(12, 15),
		Color = C.Panel,
		Radius = UIConfig.Radius.Medium,
		StrokeColor = C.Purple,
		StrokeTransparency = 0.4,
	})
	local icon = UILib.label(iconBox, upgrade.Icon, {
		Size = UDim2.fromScale(1, 1),
		Font = UIConfig.FontTitle,
		TextScaled = true,
	})
	icon.Name = "Icon"
	UILib.padding(iconBox, 8)

	local name = UILib.label(card, upgrade.Name, {
		Size = UDim2.new(1, -290, 0, 22),
		Position = UDim2.fromOffset(86, 10),
		Font = UIConfig.FontBold,
		TextSize = 15,
		Color = C.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	name.Name = "Name"

	local desc = UILib.label(card, upgrade.Desc, {
		Size = UDim2.new(1, -290, 0, 30),
		Position = UDim2.fromOffset(86, 32),
		Font = UIConfig.FontSmall,
		TextSize = 11,
		Color = C.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
	})
	desc.Name = "Desc"

	local levelLabel = UILib.label(card, "", {
		Size = UDim2.new(1, -290, 0, 18),
		Position = UDim2.fromOffset(86, 64),
		Font = UIConfig.FontBold,
		TextSize = 11,
		Color = C.Green,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	levelLabel.Name = "Level"

	local barHolder, barFill = UILib.bar(card, {
		Size = UDim2.new(0, 180, 0, 8),
		Position = UDim2.fromOffset(86, 78),
		Color = C.Green,
	})
	barHolder.Name = "LevelBar"

	local buyButton = UILib.button(card, "ACHETER", {
		Name = "Buy",
		Size = UDim2.fromOffset(190, 52),
		Position = UDim2.new(1, -204, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Color = C.Green,
		TextColor = C.TextDark,
		Radius = UIConfig.Radius.Medium,
		Gradient = { C.Green, Color3.fromRGB(70, 220, 130) },
	})

	buyButton.MouseButton1Click:Connect(function()
		Net.event("BuyUpgrade"):FireServer(upgradeId)
	end)

	local function refresh()
		local profile = ClientState.profile
		local level = (profile.upgrades and profile.upgrades[upgradeId]) or 0
		local maxed = level &gt;= upgrade.MaxLevel
		levelLabel.Text = string.format("Niveau %d / %d", level, upgrade.MaxLevel)
		UILib.setBar(barFill, level / upgrade.MaxLevel)

		if maxed then
			buyButton.Text = "MAX ✅"
			buyButton.BackgroundColor3 = C.PanelLight
			buyButton.TextColor3 = C.TextDim
			levelLabel.TextColor3 = C.Gold
		else
			local cost = Formulas.upgradeCost(upgradeId, level)
			local affordable = (profile.coins or 0) &gt;= cost
			buyButton.Text = "🪙 " .. Formulas.formatNumber(cost)
			buyButton.BackgroundColor3 = affordable and C.Green or C.PanelLight
			buyButton.TextColor3 = affordable and C.TextDark or C.TextDim
			levelLabel.TextColor3 = C.Green
		end
	end

	return refresh
end

-- ============================================================
-- AFFICHAGE
-- ============================================================
function ShopUI.show(ctx)
	local frame, content = UILib.showModal(ctx.screenGui, "shop", "🛒 BOUTIQUE", { Size = UDim2.fromOffset(760, 540) })
	UILib.clearContent(content)
	frame.Name = "ShopModal"

	local refreshers = {}

	-- Barre d'onglets
	local tabBar = Instance.new("Frame")
	tabBar.Name = "TabBar"
	tabBar.Size = UDim2.new(1, -8, 0, 46)
	tabBar.BackgroundTransparency = 1
	tabBar.LayoutOrder = 0
	tabBar.Parent = content
	UILib.list(tabBar, { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Left })

	local backButton = UILib.button(tabBar, "⟵ Retour", {
		Size = UDim2.fromOffset(110, 42),
		Color = C.PanelLight,
		Radius = UIConfig.Radius.Medium,
		TextSize = 14,
	})
	backButton.MouseButton1Click:Connect(function()
		UILib.closeModal()
	end)

	local listHolder = Instance.new("Frame")
	listHolder.Name = "ListHolder"
	listHolder.Size = UDim2.new(1, -8, 0, 0)
	listHolder.AutomaticSize = Enum.AutomaticSize.Y
	listHolder.BackgroundTransparency = 1
	listHolder.LayoutOrder = 1
	listHolder.Parent = content
	UILib.list(listHolder, { Padding = UDim.new(0, 10) })

	local tabs = {
		{ Id = "upgrades", Label = "⚡ Améliorations", Color = C.Green },
		{ Id = "passes", Label = "👑 Game Passes", Color = C.Gold },
		{ Id = "boosts", Label = "🚀 Boosts", Color = C.Orange },
	}
	local tabButtons = {}
	local currentTab = "upgrades"

	local function renderTab(tabId: string)
		currentTab = tabId
		refreshers = {}
		for _, child in ipairs(listHolder:GetChildren()) do
			if not child:IsA("UIListLayout") then
				child:Destroy()
			end
		end
		for _, tabButton in pairs(tabButtons) do
			tabButton.BackgroundColor3 = C.PanelLight
			tabButton.TextColor3 = C.TextDim
		end
		if tabButtons[tabId] then
			tabButtons[tabId].BackgroundColor3 = C.Purple
			tabButtons[tabId].TextColor3 = C.Text
		end

		if tabId == "upgrades" then
			for index, upgradeId in ipairs(UPGRADE_ORDER) do
				if GameConfig.Upgrades[upgradeId] then
					table.insert(refreshers, buildUpgradeCard(listHolder, upgradeId, index))
				end
			end
		elseif tabId == "passes" then
			for index, passId in ipairs(GameConfig.GamePassOrder) do
				local pass = GameConfig.GamePasses[passId]
				if pass then
					local card = UILib.card(listHolder, {
						Name = "Pass_" .. passId,
						Size = UDim2.new(1, -8, 0, 92),
						Color = C.Card,
						LayoutOrder = index,
					})
					local iconBox = UILib.panel(card, {
						Size = UDim2.fromOffset(62, 62),
						Position = UDim2.fromOffset(12, 15),
						Color = C.Panel,
						Radius = UIConfig.Radius.Medium,
						StrokeColor = pass.Color,
						StrokeTransparency = 0.3,
					})
					local icon = UILib.label(iconBox, pass.Icon, {
						Size = UDim2.fromScale(1, 1),
						Font = UIConfig.FontTitle,
						TextScaled = true,
					})
					icon.Name = "Icon"
					UILib.padding(iconBox, 8)

					UILib.label(card, pass.Name, {
						Size = UDim2.new(1, -300, 0, 22),
						Position = UDim2.fromOffset(86, 12),
						Font = UIConfig.FontBold,
						TextSize = 15,
						Color = C.Text,
						TextXAlignment = Enum.TextXAlignment.Left,
					})
					UILib.label(card, pass.Desc, {
						Size = UDim2.new(1, -300, 0, 40),
						Position = UDim2.fromOffset(86, 34),
						Font = UIConfig.FontSmall,
						TextSize = 11,
						Color = C.TextDim,
						TextXAlignment = Enum.TextXAlignment.Left,
						TextWrapped = true,
					})

					local buyButton = UILib.button(card, pass.Price or "R$ --", {
						Size = UDim2.fromOffset(200, 52),
						Position = UDim2.new(1, -214, 0.5, 0),
						AnchorPoint = Vector2.new(0, 0.5),
						Color = pass.Color,
						TextColor = C.TextDark,
						Gradient = { pass.Color, pass.Color:Lerp(C.White, 0.35) },
					})

					buyButton.MouseButton1Click:Connect(function()
						if (pass.Id or 0) &lt;= 0 then
							UILib.toast("Game Pass non configuré (ID à renseigner dans GameConfig).", C.Red, "⚙️")
							return
						end
						MarketplaceService:PromptGamePassPurchase(Players.LocalPlayer, pass.Id)
					end)

					local function refresh()
						local owned = ClientState.profile.gamePasses and ClientState.profile.gamePasses[passId]
						if owned then
							buyButton.Text = "POSSÉDÉ ✅"
							buyButton.BackgroundColor3 = C.PanelLight
							buyButton.TextColor3 = C.Green
						else
							buyButton.Text = pass.Price or "R$ --"
							buyButton.BackgroundColor3 = pass.Color
							buyButton.TextColor3 = C.TextDark
						end
					end
					table.insert(refreshers, refresh)
				end
			end
		elseif tabId == "boosts" then
			for index, productId in ipairs(GameConfig.DeveloperProductOrder) do
				local product = GameConfig.DeveloperProducts[productId]
				if product then
					local card = UILib.card(listHolder, {
						Name = "Product_" .. productId,
						Size = UDim2.new(1, -8, 0, 92),
						Color = C.Card,
						LayoutOrder = index,
					})
					local iconBox = UILib.panel(card, {
						Size = UDim2.fromOffset(62, 62),
						Position = UDim2.fromOffset(12, 15),
						Color = C.Panel,
						Radius = UIConfig.Radius.Medium,
						StrokeColor = C.Orange,
						StrokeTransparency = 0.3,
					})
					local icon = UILib.label(iconBox, product.Icon, {
						Size = UDim2.fromScale(1, 1),
						Font = UIConfig.FontTitle,
						TextScaled = true,
					})
					icon.Name = "Icon"
					UILib.padding(iconBox, 8)

					UILib.label(card, product.Name, {
						Size = UDim2.new(1, -300, 0, 22),
						Position = UDim2.fromOffset(86, 12),
						Font = UIConfig.FontBold,
						TextSize = 15,
						Color = C.Text,
						TextXAlignment = Enum.TextXAlignment.Left,
					})
					UILib.label(card, product.Desc, {
						Size = UDim2.new(1, -300, 0, 40),
						Position = UDim2.fromOffset(86, 34),
						Font = UIConfig.FontSmall,
						TextSize = 11,
						Color = C.TextDim,
						TextXAlignment = Enum.TextXAlignment.Left,
						TextWrapped = true,
					})

					local buyButton = UILib.button(card, product.Price or "R$ --", {
						Size = UDim2.fromOffset(200, 52),
						Position = UDim2.new(1, -214, 0.5, 0),
						AnchorPoint = Vector2.new(0, 0.5),
						Color = C.Orange,
						TextColor = C.TextDark,
					})
					buyButton.MouseButton1Click:Connect(function()
						if (product.Id or 0) &lt;= 0 then
							UILib.toast("Developer Product non configuré (ID à renseigner).", C.Red, "⚙️")
							return
						end
						MarketplaceService:PromptProductPurchase(Players.LocalPlayer, product.Id)
					end)
				end
			end
		end
	end

	for _, tab in ipairs(tabs) do
		local button = UILib.button(tabBar, tab.Label, {
			Size = UDim2.fromOffset(190, 42),
			Color = C.PanelLight,
			Radius = UIConfig.Radius.Medium,
			TextSize = 14,
		})
		tabButtons[tab.Id] = button
		button.MouseButton1Click:Connect(function()
			renderTab(tab.Id)
		end)
	end

	renderTab(currentTab)

	return function()
		for _, refresh in ipairs(refreshers) do
			pcall(refresh)
		end
	end
end

return ShopUI
</ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item><Item class="ModuleScript" referent="RBX0034">
          <Properties>
            <string name="Name">UIConfig</string>
            <ProtectedString name="Source">--!strict
--[[
	UIConfig  |  StarterPlayer.StarterPlayerScripts.UI.UIConfig
	------------------------------------------------------------------
	Thème visuel unique du jeu (couleurs, polices, tailles).
	Toute l'interface lit ce module → changer une couleur ici la change
	partout.
]]

local UIConfig = {}

-- Polices (natives Roblox : aucun asset à importer)
UIConfig.FontTitle = Enum.Font.FredokaOne
UIConfig.FontBold = Enum.Font.GothamBlack
UIConfig.FontBody = Enum.Font.GothamMedium
UIConfig.FontSmall = Enum.Font.Gotham

-- Palette
UIConfig.Colors = {
	Background = Color3.fromRGB(13, 15, 28),
	Panel = Color3.fromRGB(22, 25, 44),
	PanelLight = Color3.fromRGB(32, 36, 62),
	Card = Color3.fromRGB(38, 42, 72),
	CardHover = Color3.fromRGB(50, 56, 92),
	Stroke = Color3.fromRGB(70, 80, 130),

	Gold = Color3.fromRGB(255, 210, 74),
	Green = Color3.fromRGB(109, 255, 160),
	Blue = Color3.fromRGB(89, 198, 255),
	Purple = Color3.fromRGB(180, 123, 255),
	Pink = Color3.fromRGB(255, 109, 209),
	Red = Color3.fromRGB(255, 96, 96),
	Orange = Color3.fromRGB(255, 160, 70),
	Cyan = Color3.fromRGB(90, 255, 235),

	Text = Color3.fromRGB(240, 245, 255),
	TextDim = Color3.fromRGB(165, 175, 205),
	TextDark = Color3.fromRGB(20, 22, 40),

	Transparent = Color3.fromRGB(0, 0, 0),
	White = Color3.fromRGB(255, 255, 255),
}

-- Rayons
UIConfig.Radius = {
	Small = UDim.new(0, 8),
	Medium = UDim.new(0, 14),
	Large = UDim.new(0, 20),
	Pill = UDim.new(1, 0),
}

-- Position des éléments du HUD (ancrage)
UIConfig.Layout = {
	HudTopLeft = UDim2.new(0, 16, 0, 12),
	HudTopRight = UDim2.new(1, -16, 0, 12),
	ButtonsRight = UDim2.new(1, -14, 0, 120),
	BottomCenter = UDim2.new(0.5, 0, 1, -18),
}

-- Tailles des modales
UIConfig.ModalSize = UDim2.new(0, 720, 0, 520)
UIConfig.ModalSizeSmall = UDim2.new(0, 560, 0, 430)

-- Couleurs par rareté (remplies par UIController depuis GameConfig)
UIConfig.RarityColors = {}

-- Utilitaire : couleur → hex string (pour les remotes)
function UIConfig.toHex(color: Color3): string
	return string.format("%02x%02x%02x", math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5))
end

function UIConfig.fromHex(hex: string): Color3
	local r = tonumber(string.sub(hex, 1, 2), 16) or 255
	local g = tonumber(string.sub(hex, 3, 4), 16) or 255
	local b = tonumber(string.sub(hex, 5, 6), 16) or 255
	return Color3.fromRGB(r, g, b)
end

return UIConfig
</ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item><Item class="ModuleScript" referent="RBX0035">
          <Properties>
            <string name="Name">UIController</string>
            <ProtectedString name="Source">--!strict
--[[
	UIController  |  StarterPlayer.StarterPlayerScripts.UI.UIController
	------------------------------------------------------------------
	Chef d'orchestre de l'interface :
	  • crée le ScreenGui principal ("MainUI")
	  • construit le HUD
	  • gère la pile de modales (une seule ouverte à la fois)
	  • rafraîchit l'écran ouvert (2x/seconde) sans reconstruire le DOM
	  • écran de chargement
  • file de toasts
	  • notification centrale de résultat d'œuf (animation de révélation)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local Formulas = require(Modules:WaitForChild("Formulas"))

local UIConfig = require(script.Parent.UIConfig)
local UILib = require(script.Parent.UILib)
local ClientState = require(script.Parent.Parent.Controllers.ClientState)

local HudUI = require(script.Parent.HudUI)
local ShopUI = require(script.Parent.ShopUI)
local PetsUI = require(script.Parent.PetsUI)
local RebirthUI = require(script.Parent.RebirthUI)
local WorldsUI = require(script.Parent.WorldsUI)
local LeaderboardUI = require(script.Parent.LeaderboardUI)
local AchievementsUI = require(script.Parent.AchievementsUI)
local SettingsUI = require(script.Parent.SettingsUI)
local DailyUI = require(script.Parent.DailyUI)

local UIController = {}

local C = UIConfig.Colors

local screenGui: ScreenGui? = nil
local toastStack: Frame? = nil
local activeRefresh: (() -&gt; ())? = nil
local lastRefresh = 0
local eggRevealHolder: Frame? = nil
local eggQueue = {}
local eggRevealing = false

-- ============================================================
-- MODALES
-- ============================================================
local screens = {
	shop = function(ctx) return ShopUI.show(ctx) end,
	eggs = function(ctx) return PetsUI.show(ctx, "eggs") end,
	pets = function(ctx) return PetsUI.show(ctx, "pets") end,
	rebirth = function(ctx) return RebirthUI.show(ctx) end,
	worlds = function(ctx) return WorldsUI.show(ctx) end,
	ranks = function(ctx) return LeaderboardUI.show(ctx) end,
	achievements = function(ctx) return AchievementsUI.show(ctx) end,
	settings = function(ctx) return SettingsUI.show(ctx) end,
	daily = function(ctx) return DailyUI.show(ctx) end,
}

local function openModal(id: string)
	if not screenGui then
		return
	end
	local screen = screens[id]
	if not screen then
		return
	end
	local ctx = { screenGui = screenGui, openModal = openModal }
	local ok, refresh = pcall(screen, ctx)
	if not ok then
		warn("[UIController] erreur d'ouverture de " .. id .. " : " .. tostring(refresh))
		return
	end
	activeRefresh = type(refresh) == "function" and refresh or nil
	lastRefresh = 0
	UILib.playClick("pop")
end

-- ============================================================
-- RÉVÉLATION D'ŒUF
-- ============================================================
local function showNextEgg()
	if eggRevealing or #eggQueue == 0 or not screenGui then
		return
	end
	eggRevealing = true
	local result = table.remove(eggQueue, 1)

	local rarity = GameConfig.Rarities[result.rarity] or GameConfig.Rarities.Common
	local petInfo = GameConfig.Pets[result.petId] or { Name = result.name or "?", Emoji = "🐾", Mult = 0 }

	local holder = Instance.new("Frame")
	holder.Name = "EggReveal"
	holder.Size = UDim2.fromScale(1, 1)
	holder.BackgroundColor3 = C.Background
	holder.BackgroundTransparency = 0.35
	holder.BorderSizePixel = 0
	holder.ZIndex = 40
	holder.Parent = screenGui
	eggRevealHolder = holder

	local card = Instance.new("Frame")
	card.Size = UDim2.fromOffset(420, 320)
	card.Position = UDim2.fromScale(0.5, 0.5)
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	card.BackgroundColor3 = C.Panel
	card.BorderSizePixel = 0
	card.ZIndex = 41
	card.Parent = holder
	UILib.corner(card, UIConfig.Radius.Large)
	UILib.stroke(card, rarity.Color, 4, 0)
	UILib.gradient(card, rarity.Color:Lerp(C.Background, 0.8), C.Background, 90)

	local cardScale = Instance.new("UIScale")
	cardScale.Scale = 0.6
	cardScale.Parent = card
	UILib.tween(cardScale, { Scale = 1 }, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out))

	local title = UILib.label(card, result.isNew and "NOUVEAU PET !" or "PET OBTENU !", {
		Size = UDim2.new(1, 0, 0, 34),
		Position = UDim2.fromOffset(0, 18),
		Font = UIConfig.FontTitle,
		TextSize = 24,
		Color = rarity.Color,
		ZIndex = 42,
	})
	title.Name = "Title"

	local emoji = UILib.label(card, petInfo.Emoji or "🐾", {
		Size = UDim2.fromOffset(120, 120),
		Position = UDim2.fromOffset(150, 58),
		Font = UIConfig.FontTitle,
		TextScaled = true,
		ZIndex = 42,
	})
	emoji.Name = "Emoji"
	UILib.pulse(emoji, 1.2)

	local name = UILib.label(card, petInfo.Name, {
		Size = UDim2.new(1, -40, 0, 30),
		Position = UDim2.fromOffset(20, 182),
		Font = UIConfig.FontTitle,
		TextSize = 22,
		Color = C.Text,
		TextWrapped = true,
		ZIndex = 42,
	})
	name.Name = "Name"

	local rarityLabel = UILib.label(card, string.upper(rarity.Name), {
		Size = UDim2.new(1, -40, 0, 20),
		Position = UDim2.fromOffset(20, 212),
		Font = UIConfig.FontBold,
		TextSize = 14,
		Color = rarity.Color,
		ZIndex = 42,
	})
	rarityLabel.Name = "Rarity"

	local multLabel = UILib.label(card, string.format("Multiplicateur ×%s", string.format("%.2f", petInfo.Mult or 0)), {
		Size = UDim2.new(1, -40, 0, 22),
		Position = UDim2.fromOffset(20, 234),
		Font = UIConfig.FontBold,
		TextSize = 14,
		Color = C.Gold,
		ZIndex = 42,
	})
	multLabel.Name = "Mult"

	local closeButton = UILib.button(card, "SUPER !", {
		Size = UDim2.fromOffset(240, 46),
		Position = UDim2.fromOffset(90, 262),
		Color = rarity.Color,
		TextColor = C.TextDark,
		Radius = UIConfig.Radius.Pill,
		ZIndex = 43,
	})

	local function closeReveal()
		if not holder.Parent then
			return
		end
		UILib.tween(cardScale, { Scale = 0.7 }, TweenInfo.new(0.18))
		UILib.tween(holder, { BackgroundTransparency = 1 }, TweenInfo.new(0.18))
		task.delay(0.2, function()
			holder:Destroy()
			eggRevealing = false
			task.delay(0.1, showNextEgg)
		end)
	end

	closeButton.MouseButton1Click:Connect(closeReveal)

	-- Cliquer n'importe où ferme la révélation (texture invisible plein écran)
	local blocker = Instance.new("TextButton")
	blocker.Name = "Blocker"
	blocker.Size = UDim2.fromScale(1, 1)
	blocker.BackgroundTransparency = 1
	blocker.Text = ""
	blocker.AutoButtonColor = false
	blocker.ZIndex = 40
	blocker.Parent = holder
	blocker.MouseButton1Click:Connect(closeReveal)

	ClientState.Signals.Sound:Fire("rarity", 1)
	task.delay(4.5, function()
		if holder.Parent then
			closeReveal()
		end
	end)
end

function UIController.queueEggReveal(result)
	table.insert(eggQueue, result)
	showNextEgg()
end

-- ============================================================
-- ÉCRAN DE CHARGEMENT
-- ============================================================
local function buildLoadingScreen(): Frame
	local loading = Instance.new("Frame")
	loading.Name = "Loading"
	loading.Size = UDim2.fromScale(1, 1)
	loading.BackgroundColor3 = C.Background
	loading.BorderSizePixel = 0
	loading.ZIndex = 100
	loading.Parent = screenGui

	local logo = UILib.label(loading, "NOOB ➜ GOD", {
		Size = UDim2.new(1, 0, 0, 80),
		Position = UDim2.fromScale(0, 0.38),
		Font = UIConfig.FontTitle,
		TextScaled = true,
		Color = C.Gold,
		Stroke = true,
		ZIndex = 101,
	})
	logo.Name = "Logo"
	UILib.padding(logo, 0, 0, 60, 60)

	local sub = UILib.label(loading, "SIMULATOR", {
		Size = UDim2.new(1, 0, 0, 40),
		Position = UDim2.fromScale(0, 0.47),
		Font = UIConfig.FontTitle,
		TextScaled = true,
		Color = C.Pink,
		ZIndex = 101,
	})
	UILib.padding(sub, 0, 0, 120, 120)

	local barHolder, barFill = UILib.bar(loading, {
		Size = UDim2.new(0, 360, 0, 12),
		Position = UDim2.fromScale(0.5, 0.62),
		Color = C.Green,
	})
	barHolder.AnchorPoint = Vector2.new(0.5, 0.5)
	barHolder.ZIndex = 101
	barFill.Size = UDim2.fromScale(0.05, 1)
	UILib.tween(barFill, { Size = UDim2.fromScale(1, 1) }, TweenInfo.new(1.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))

	local status = UILib.label(loading, "Chargement de tes données…", {
		Size = UDim2.new(1, 0, 0, 24),
		Position = UDim2.fromScale(0, 0.67),
		Font = UIConfig.FontBold,
		TextSize = 14,
		Color = C.TextDim,
		ZIndex = 101,
	})
	status.Name = "Status"

	return loading
end

function UIController.hideLoading()
	local loading = screenGui and screenGui:FindFirstChild("Loading")
	if loading then
		UILib.tween(loading, { BackgroundTransparency = 1 }, TweenInfo.new(0.4))
		for _, descendant in ipairs(loading:GetDescendants()) do
			if descendant:IsA("TextLabel") then
				UILib.tween(descendant, { TextTransparency = 1 }, TweenInfo.new(0.3))
			elseif descendant:IsA("Frame") then
				UILib.tween(descendant, { BackgroundTransparency = 1 }, TweenInfo.new(0.3))
			end
		end
		task.delay(0.5, function()
			loading:Destroy()
		end)
	end
end

-- ============================================================
-- DÉMARRAGE
-- ============================================================
function UIController.start()
	local gui = Instance.new("ScreenGui")
	gui.Name = "MainUI"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 10
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	screenGui = gui

	buildLoadingScreen()

	-- Pile de toasts (haut droite sous le HUD)
	local stack = Instance.new("Frame")
	stack.Name = "ToastStack"
	stack.Size = UDim2.fromOffset(360, 280)
	stack.Position = UDim2.new(1, -16, 1, -110)
	stack.AnchorPoint = Vector2.new(1, 1)
	stack.BackgroundTransparency = 1
	stack.Parent = gui
	toastStack = stack
	UILib.setToastStack(stack)

	HudUI.start(gui, { openModal = openModal })

	-- Rafraîchit l'écran ouvert
	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		if activeRefresh and now - lastRefresh &gt; 0.5 then
			lastRefresh = now
			if UILib.getOpenModal() then
				local ok, err = pcall(activeRefresh)
				if not ok then
					warn("[UIController] refresh : " .. tostring(err))
				end
			else
				activeRefresh = nil
			end
		end
	end)

	print("[UIController] Construit")
	return gui
end

function UIController.getScreenGui()
	return screenGui
end

function UIController.toast(text: string, color: Color3?, icon: string?)
	UILib.toast(text, color, icon)
end

return UIController
</ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item><Item class="ModuleScript" referent="RBX0036">
          <Properties>
            <string name="Name">UILib</string>
            <ProtectedString name="Source">--!strict
--[[
	UILib  |  StarterPlayer.StarterPlayerScripts.UI.UILib
	------------------------------------------------------------------
	Petite bibliothèque de composants UI (aucune dépendance externe).
	Tout est construit à la main : coins arrondis, dégradés, contours,
	boutons avec survol/clic animés, barres de progression, toasts,
	modales, listes défilantes.

	Utilisation typique :
		UILib.label(parent, "Texte", { Size = UDim2.fromScale(1, 0.2) })
		local button = UILib.button(parent, "CLIQUE", { Color = ... })
		button.MouseButton1Click:Connect(fn)
]]

local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")

local UIConfig = require(script.Parent.UIConfig)

local UILib = {}

local C = UIConfig.Colors
local EASE = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local EASE_IN = TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

-- ============================================================
-- PRIMITIVES
-- ============================================================
function UILib.create(className: string, props: { [string]: any }, parent: Instance?): any
	local instance = Instance.new(className)
	for key, value in pairs(props or {}) do
		if key ~= "Parent" then
			instance[key] = value
		end
	end
	if parent then
		instance.Parent = parent
	end
	if props and props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

function UILib.corner(instance: Instance, radius: UDim?): UICorner
	local corner = Instance.new("UICorner")
	corner.CornerRadius = radius or UIConfig.Radius.Medium
	corner.Parent = instance
	return corner
end

function UILib.stroke(instance: Instance, color: Color3?, thickness: number?, transparency: number?): UIStroke
	local stroke = Instance.new("UIStroke")
	stroke.Color = color or C.Stroke
	stroke.Thickness = thickness or 1.5
	stroke.Transparency = transparency or 0
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = instance
	return stroke
end

function UILib.gradient(instance: Instance, colorA: Color3, colorB: Color3, rotation: number?): UIGradient
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new(colorA, colorB)
	gradient.Rotation = rotation or 90
	gradient.Parent = instance
	return gradient
end

function UILib.padding(instance: Instance, top: number, bottom: number?, left: number?, right: number?): UIPadding
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, top)
	padding.PaddingBottom = UDim.new(0, bottom or top)
	padding.PaddingLeft = UDim.new(0, left or top)
	padding.PaddingRight = UDim.new(0, right or left or top)
	padding.Parent = instance
	return padding
end

function UILib.tween(instance: Instance, props: { [string]: any }, info: TweenInfo?): Tween
	local tween = TweenService:Create(instance, info or EASE, props)
	tween:Play()
	return tween
end

function UILib.playClick(soundKey: string?)
	local key = soundKey or "click"
	local soundId = "rbxasset://sounds/clickfast.wav"
	if key == "pop" then
		soundId = "rbxasset://sounds/electronicpingshort.wav"
	end
	local sound = Instance.new("Sound")
	sound.SoundId = soundId
	sound.Volume = 0.25
	sound.PlaybackSpeed = key == "pop" and 1.3 or 1
	sound.Parent = SoundService
	sound:Play()
	task.delay(1, function()
		sound:Destroy()
	end)
end

-- ============================================================
-- TEXTE
-- ============================================================
function UILib.label(parent: Instance, text: string, opts: { [string]: any }?): TextLabel
	local options = opts or {}
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = options.BackgroundTransparency or 1
	label.BackgroundColor3 = options.Background or C.Panel
	label.Size = options.Size or UDim2.fromScale(1, 1)
	label.Position = options.Position or UDim2.fromScale(0, 0)
	label.AnchorPoint = options.AnchorPoint or Vector2.new(0, 0)
	label.Font = options.Font or UIConfig.FontBody
	label.Text = text
	label.TextColor3 = options.Color or C.Text
	label.TextSize = options.TextSize or 16
	label.TextScaled = options.TextScaled == true
	label.TextWrapped = options.TextWrapped == true
	label.TextXAlignment = options.TextXAlignment or Enum.TextXAlignment.Center
	label.TextYAlignment = options.TextYAlignment or Enum.TextYAlignment.Center
	label.RichText = options.RichText == true
	label.ZIndex = options.ZIndex or 1
	if options.Stroke then
		label.TextStrokeTransparency = 0.4
		label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	end
	label.Parent = parent
	return label
end

function UILib.title(parent: Instance, text: string, opts: { [string]: any }?): TextLabel
	local options = opts or {}
	options.Font = options.Font or UIConfig.FontTitle
	options.TextScaled = options.TextScaled == nil and true or options.TextScaled
	options.Color = options.Color or C.Gold
	options.Stroke = options.Stroke ~= false
	return UILib.label(parent, text, options)
end

-- ============================================================
-- BOUTONS
-- ============================================================
function UILib.button(parent: Instance, text: string, opts: { [string]: any }?): TextButton
	local options = opts or {}
	local button = Instance.new("TextButton")
	button.Name = options.Name or "Button"
	button.Size = options.Size or UDim2.fromOffset(200, 56)
	button.Position = options.Position or UDim2.fromScale(0, 0)
	button.AnchorPoint = options.AnchorPoint or Vector2.new(0, 0)
	button.BackgroundColor3 = options.Color or C.Card
	button.BackgroundTransparency = options.BackgroundTransparency or 0
	button.AutoButtonColor = false
	button.Font = options.Font or UIConfig.FontBold
	button.Text = text
	button.TextColor3 = options.TextColor or C.Text
	button.TextSize = options.TextSize or 18
	button.TextScaled = options.TextScaled == true
	button.TextWrapped = options.TextWrapped == true
	button.BorderSizePixel = 0
	button.ZIndex = options.ZIndex or 5
	button.LayoutOrder = options.LayoutOrder or 0
	button.Parent = parent

	UILib.corner(button, options.Radius or UIConfig.Radius.Medium)

	if options.Gradient then
		UILib.gradient(button, options.Gradient[1], options.Gradient[2], options.GradientRotation)
	end
	if options.StrokeColor then
		UILib.stroke(button, options.StrokeColor, options.StrokeThickness or 2)
	end

	local scale = Instance.new("UIScale")
	scale.Scale = 1
	scale.Parent = button

	local baseColor = button.BackgroundColor3

	button.MouseEnter:Connect(function()
		UILib.tween(scale, { Scale = 1.05 }, EASE_IN)
		if options.HoverColor then
			UILib.tween(button, { BackgroundColor3 = options.HoverColor })
		else
			UILib.tween(button, { BackgroundColor3 = baseColor:Lerp(Color3.fromRGB(255, 255, 255), 0.12) })
		end
	end)
	button.MouseLeave:Connect(function()
		UILib.tween(scale, { Scale = 1 }, EASE)
		UILib.tween(button, { BackgroundColor3 = baseColor }, EASE)
	end)
	button.MouseButton1Down:Connect(function()
		UILib.tween(scale, { Scale = 0.94 }, TweenInfo.new(0.08))
	end)
	button.MouseButton1Up:Connect(function()
		UILib.tween(scale, { Scale = 1.05 }, TweenInfo.new(0.1))
	end)
	if options.Silent ~= true then
		button.MouseButton1Click:Connect(function()
			UILib.playClick(options.Sound or "click")
		end)
	end

	return button
end

--- Bouton d'icône rond (barre latérale du HUD)
function UILib.iconButton(parent: Instance, emoji: string, labelText: string, opts: { [string]: any }?): TextButton
	local options = opts or {}
	local holder = Instance.new("Frame")
	holder.Name = options.Name or ("IconButton_" .. labelText)
	holder.Size = options.Size or UDim2.fromOffset(84, 84)
	holder.BackgroundTransparency = 1
	holder.Parent = parent

	local button = UILib.button(holder, "", {
		Size = UDim2.fromOffset(66, 66),
		Position = UDim2.new(0.5, 0, 0, 0),
		AnchorPoint = Vector2.new(0.5, 0),
		Color = options.Color or C.Card,
		Radius = UIConfig.Radius.Large,
		StrokeColor = options.StrokeColor or C.Stroke,
		StrokeThickness = 2,
	})
	button.Name = "ClickArea"

	local emojiLabel = UILib.label(button, emoji, {
		Size = UDim2.fromScale(1, 1),
		Font = UIConfig.FontTitle,
		TextScaled = true,
		ZIndex = 6,
	})
	emojiLabel.Name = "Emoji"
	UILib.padding(button, 12)

	local caption = UILib.label(holder, labelText, {
		Position = UDim2.new(0.5, 0, 0, 66),
		AnchorPoint = Vector2.new(0.5, 0),
		Size = UDim2.fromOffset(84, 16),
		Font = UIConfig.FontBold,
		TextScaled = true,
		Color = C.TextDim,
		ZIndex = 6,
	})
	caption.Name = "Caption"

	local scale = Instance.new("UIScale")
	scale.Parent = holder
	button.MouseEnter:Connect(function()
		UILib.tween(scale, { Scale = 1.1 }, EASE_IN)
		UILib.tween(caption, { TextColor3 = C.Gold })
	end)
	button.MouseLeave:Connect(function()
		UILib.tween(scale, { Scale = 1 }, EASE)
		UILib.tween(caption, { TextColor3 = C.TextDim })
	end)

	local badge = UILib.label(button, "", {
		Position = UDim2.new(1, -6, 0, 4),
		AnchorPoint = Vector2.new(1, 0),
		Size = UDim2.fromOffset(26, 26),
		BackgroundTransparency = 1,
		Font = UIConfig.FontTitle,
		TextScaled = true,
		Color = C.Gold,
		ZIndex = 8,
	})
	badge.Name = "Badge"

	return button
end

-- ============================================================
-- CONTENEURS
-- ============================================================
function UILib.panel(parent: Instance, opts: { [string]: any }?): Frame
	local options = opts or {}
	local frame = Instance.new("Frame")
	frame.Name = options.Name or "Panel"
	frame.Size = options.Size or UDim2.fromScale(1, 1)
	frame.Position = options.Position or UDim2.fromScale(0, 0)
	frame.AnchorPoint = options.AnchorPoint or Vector2.new(0, 0)
	frame.BackgroundColor3 = options.Color or C.Panel
	frame.BackgroundTransparency = options.Transparency or 0
	frame.BorderSizePixel = 0
	frame.ZIndex = options.ZIndex or 1
	frame.LayoutOrder = options.LayoutOrder or 0
	frame.Parent = parent
	UILib.corner(frame, options.Radius or UIConfig.Radius.Large)
	if options.Stroke ~= false then
		UILib.stroke(frame, options.StrokeColor or C.Stroke, options.StrokeThickness or 1.5, options.StrokeTransparency or 0.2)
	end
	if options.Gradient then
		UILib.gradient(frame, options.Gradient[1], options.Gradient[2], options.GradientRotation)
	end
	return frame
end

function UILib.card(parent: Instance, opts: { [string]: any }?): Frame
	local options = opts or {}
	options.Color = options.Color or C.Card
	options.Radius = options.Radius or UIConfig.Radius.Medium
	return UILib.panel(parent, options)
end

function UILib.list(parent: Instance, props: { [string]: any }?): UIListLayout
	local layout = Instance.new("UIListLayout")
	layout.Padding = (props and props.Padding) or UDim.new(0, 8)
	layout.SortOrder = (props and props.SortOrder) or Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = (props and props.HorizontalAlignment) or Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = (props and props.VerticalAlignment) or Enum.VerticalAlignment.Top
	layout.Parent = parent
	return layout
end

function UILib.grid(parent: Instance, cellSize: UDim2, padding: UDim?, fillDirection: Enum.FillDirection?): UIGridLayout
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = cellSize
	layout.CellPadding = padding or UDim2.fromOffset(8, 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.FillDirection = fillDirection or Enum.FillDirection.Horizontal
	layout.Parent = parent
	return layout
end

--- Zone défilante verticale propre
function UILib.scroll(parent: Instance, opts: { [string]: any }?): ScrollingFrame
	local options = opts or {}
	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = options.Name or "Scroll"
	scroll.Size = options.Size or UDim2.fromScale(1, 1)
	scroll.Position = options.Position or UDim2.fromScale(0, 0)
	scroll.CanvasSize = UDim2.fromOffset(0, 0)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.ScrollBarThickness = 6
	scroll.ScrollBarImageColor3 = C.Stroke
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollingDirection = Enum.ScrollingDirection.Y
	scroll.Parent = parent
	UILib.padding(scroll, options.Padding or 6)
	UILib.list(scroll, { Padding = UDim.new(0, 10), HorizontalAlignment = Enum.HorizontalAlignment.Center })
	return scroll
end

-- ============================================================
-- BARRE DE PROGRESSION
-- ============================================================
function UILib.bar(parent: Instance, opts: { [string]: any }?): (Frame, Frame)
	local options = opts or {}
	local holder = Instance.new("Frame")
	holder.Name = "Bar"
	holder.Size = options.Size or UDim2.new(1, 0, 0, 14)
	holder.Position = options.Position or UDim2.fromScale(0, 0)
	holder.BackgroundColor3 = C.Background
	holder.BorderSizePixel = 0
	holder.ClipsDescendants = true
	holder.Parent = parent
	UILib.corner(holder, UIConfig.Radius.Pill)

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(options.Value or 0.5, 1)
	fill.BackgroundColor3 = options.Color or C.Green
	fill.BorderSizePixel = 0
	fill.Parent = holder
	UILib.corner(fill, UIConfig.Radius.Pill)
	if options.Gradient then
		UILib.gradient(fill, options.Gradient[1], options.Gradient[2], 0)
	else
		UILib.gradient(fill, (options.Color or C.Green), (options.Color or C.Green):Lerp(C.White, 0.35), 0)
	end

	return holder, fill
end

function UILib.setBar(fill: Frame, value: number)
	local clamped = math.clamp(value, 0, 1)
	UILib.tween(fill, { Size = UDim2.fromScale(clamped, 1) }, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
end

-- ============================================================
-- MODALES
-- ============================================================
local openModal: Frame? = nil
local modalBackdrop: TextButton? = nil
local modalRegistry: { [string]: Frame } = {}

function UILib.closeModal()
	if modalBackdrop then
		local backdrop = modalBackdrop
		modalBackdrop = nil
		UILib.tween(backdrop, { BackgroundTransparency = 1 }, EASE)
		task.delay(0.2, function()
			backdrop:Destroy()
		end)
	end
	if openModal then
		local frame = openModal
		openModal = nil
		local scale = frame:FindFirstChildOfClass("UIScale")
		if scale then
			UILib.tween(scale, { Scale = 0.85 }, EASE)
		end
		UILib.tween(frame, { BackgroundTransparency = 1 }, EASE)
		task.delay(0.18, function()
			frame.Visible = false
		end)
	end
end

function UILib.getOpenModal(): Frame?
	return openModal
end

--- Crée (une seule fois) une modale et renvoie sa frame + son contenu.
function UILib.modal(screenGui: ScreenGui, id: string, titleText: string, opts: { [string]: any }?): (Frame, Frame)
	local existing = modalRegistry[id]
	if existing then
		return existing, existing:FindFirstChild("Content") :: Frame
	end

	local options = opts or {}

	local frame = Instance.new("Frame")
	frame.Name = "Modal_" .. id
	frame.Size = options.Size or UIConfig.ModalSize
	frame.Position = UDim2.fromScale(0.5, 0.5)
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.BackgroundColor3 = C.Panel
	frame.BorderSizePixel = 0
	frame.Visible = false
	frame.ZIndex = 20
	frame.Parent = screenGui
	UILib.corner(frame, UIConfig.Radius.Large)
	UILib.stroke(frame, C.Stroke, 2, 0)
	UILib.gradient(frame, C.Panel, C.Background, 90)

	local scale = Instance.new("UIScale")
	scale.Scale = 1
	scale.Parent = frame

	-- En-tête
	local header = Instance.new("Frame")
	header.Name = "Header"
	header.Size = UDim2.new(1, 0, 0, 62)
	header.BackgroundColor3 = C.PanelLight
	header.BorderSizePixel = 0
	header.ZIndex = 21
	header.Parent = frame
	local headerCorner = UILib.corner(header, UIConfig.Radius.Large)
	headerCorner.CornerRadius = UDim.new(0, 20)

	local headerMask = Instance.new("Frame")
	headerMask.Name = "Mask"
	headerMask.Size = UDim2.new(1, 0, 0.5, 0)
	headerMask.Position = UDim2.fromScale(0, 0.5)
	headerMask.BackgroundColor3 = C.PanelLight
	headerMask.BorderSizePixel = 0
	headerMask.ZIndex = 21
	headerMask.Parent = header

	UILib.title(header, titleText, {
		Size = UDim2.new(1, -120, 1, 0),
		Position = UDim2.fromOffset(20, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 22,
	})

	local closeButton = UILib.button(header, "✕", {
		Size = UDim2.fromOffset(40, 40),
		Position = UDim2.new(1, -50, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Color = C.Red,
		Radius = UIConfig.Radius.Pill,
		ZIndex = 23,
	})
	closeButton.MouseButton1Click:Connect(function()
		UILib.closeModal()
	end)

	-- Contenu
	local content = Instance.new("ScrollingFrame")
	content.Name = "Content"
	content.Size = UDim2.new(1, -24, 1, -80)
	content.Position = UDim2.fromOffset(12, 70)
	content.BackgroundTransparency = 1
	content.BorderSizePixel = 0
	content.ScrollBarThickness = 6
	content.ScrollBarImageColor3 = C.Stroke
	content.CanvasSize = UDim2.fromOffset(0, 0)
	content.AutomaticCanvasSize = Enum.AutomaticSize.Y
	content.ScrollingDirection = Enum.ScrollingDirection.Y
	content.ZIndex = 21
	content.Parent = frame
	UILib.list(content, { Padding = UDim.new(0, 10) })

	modalRegistry[id] = frame
	return frame, content
end

--- Ouvre une modale (ferme automatiquement la précédente).
function UILib.showModal(screenGui: ScreenGui, id: string, titleText: string, opts: { [string]: any }?): (Frame, Frame)
	local frame, content = UILib.modal(screenGui, id, titleText, opts)
	-- La modale est déjà construite mais son contenu est reconstruit par l'appelant

	if openModal and openModal ~= frame then
		local previous = openModal
		openModal = nil
		local prevScale = previous:FindFirstChildOfClass("UIScale")
		if prevScale then
			UILib.tween(prevScale, { Scale = 0.9 }, EASE)
		end
		previous.Visible = false
	end

	if not modalBackdrop then
		local backdrop = Instance.new("TextButton")
		backdrop.Name = "ModalBackdrop"
		backdrop.Size = UDim2.fromScale(1, 1)
		backdrop.BackgroundColor3 = C.Background
		backdrop.BackgroundTransparency = 0.45
		backdrop.Text = ""
		backdrop.AutoButtonColor = false
		backdrop.ZIndex = 15
		backdrop.Parent = screenGui
		backdrop.MouseButton1Click:Connect(function()
			UILib.closeModal()
		end)
		modalBackdrop = backdrop
		UILib.tween(backdrop, { BackgroundTransparency = 0.45 }, EASE)
	end

	openModal = frame
	frame.Visible = true
	local scale = frame:FindFirstChildOfClass("UIScale")
	if scale then
		scale.Scale = 0.85
		UILib.tween(scale, { Scale = 1 }, EASE_IN)
	end
	frame.BackgroundTransparency = 0
	return frame, content
end

--- Vide le contenu d'une modale avant de le reconstruire.
function UILib.clearContent(content: Frame)
	for _, child in ipairs(content:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIGridLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
end

-- ============================================================
-- TOASTS
-- ============================================================
local toastStack: Frame? = nil

function UILib.setToastStack(frame: Frame)
	toastStack = frame
	if not frame:FindFirstChildOfClass("UIListLayout") then
		UILib.list(frame, { Padding = UDim.new(0, 6) })
	end
end

function UILib.toast(text: string, color: Color3?, icon: string?)
	if not toastStack then
		return
	end
	local toast = Instance.new("Frame")
	toast.Name = "Toast"
	toast.Size = UDim2.fromOffset(340, 46)
	toast.BackgroundColor3 = C.PanelLight
	toast.BorderSizePixel = 0
	toast.BackgroundTransparency = 1
	toast.ZIndex = 30
	toast.Parent = toastStack
	UILib.corner(toast, UIConfig.Radius.Medium)
	local stroke = UILib.stroke(toast, color or C.Gold, 2, 1)

	local iconLabel = UILib.label(toast, icon or "✨", {
		Size = UDim2.fromOffset(36, 36),
		Position = UDim2.fromOffset(6, 5),
		Font = UIConfig.FontTitle,
		TextScaled = true,
		ZIndex = 31,
	})
	iconLabel.Name = "Icon"

	local textLabel = UILib.label(toast, text, {
		Size = UDim2.new(1, -50, 1, 0),
		Position = UDim2.fromOffset(46, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		Font = UIConfig.FontBold,
		TextSize = 13,
		Color = color or C.Text,
		ZIndex = 31,
	})
	textLabel.Name = "Text"

	toast.BackgroundTransparency = 1
	stroke.Transparency = 1
	textLabel.TextTransparency = 1
	iconLabel.TextTransparency = 1
	UILib.tween(toast, { BackgroundTransparency = 0.1 }, EASE)
	UILib.tween(stroke, { Transparency = 0.2 }, EASE)
	UILib.tween(textLabel, { TextTransparency = 0 }, EASE)
	UILib.tween(iconLabel, { TextTransparency = 0 }, EASE)

	task.delay(4, function()
		if not toast.Parent then
			return
		end
		UILib.tween(toast, { BackgroundTransparency = 1, Size = UDim2.fromOffset(340, 0) }, TweenInfo.new(0.3))
		if toast:FindFirstChildOfClass("UIStroke") then
			UILib.tween(toast:FindFirstChildOfClass("UIStroke") :: UIStroke, { Transparency = 1 }, TweenInfo.new(0.25))
		end
		UILib.tween(textLabel, { TextTransparency = 1 }, TweenInfo.new(0.25))
		UILib.tween(iconLabel, { TextTransparency = 1 }, TweenInfo.new(0.25))
		task.delay(0.35, function()
			toast:Destroy()
		end)
	end)
end

-- ============================================================
-- UTILITAIRES D'ANIMATION
-- ============================================================
function UILib.pulse(instance: GuiObject, scaleAmount: number?)
	local scale = instance:FindFirstChildOfClass("UIScale")
	if not scale then
		scale = Instance.new("UIScale")
		scale.Parent = instance
	end
	local target = scaleAmount or 1.15
	scale.Scale = 1
	UILib.tween(scale, { Scale = target }, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
	task.delay(0.12, function()
		if scale.Parent then
			UILib.tween(scale, { Scale = 1 }, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
		end
	end)
end

function UILib.fadeIn(instance: GuiObject, duration: number?)
	instance.BackgroundTransparency = 1
	UILib.tween(instance, { BackgroundTransparency = 0 }, TweenInfo.new(duration or 0.25))
end

--- Compteur animé (puissance qui monte en douceur)
--- NOTE : on n'utilise pas TweenService ici car il ne fonctionne que sur
--- des Instances, pas sur des tables Lua.
function UILib.animateNumber(label: TextLabel, from: number, to: number, formatter, duration: number?)
	formatter = formatter or tostring
	local lifeTime = duration or 0.45
	task.spawn(function()
		local startTime = os.clock()
		while true do
			local elapsed = os.clock() - startTime
			local alpha = math.clamp(elapsed / lifeTime, 0, 1)
			-- easing "quad out"
			local eased = 1 - (1 - alpha) * (1 - alpha)
			if not label.Parent then
				return
			end
			label.Text = formatter(from + (to - from) * eased)
			if alpha &gt;= 1 then
				label.Text = formatter(to)
				return
			end
			task.wait(0.03)
		end
	end)
end

return UILib
</ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item><Item class="ModuleScript" referent="RBX0037">
          <Properties>
            <string name="Name">WorldsUI</string>
            <ProtectedString name="Source">--!strict
--[[
	WorldsUI  |  StarterPlayer.StarterPlayerScripts.UI.WorldsUI
	------------------------------------------------------------------
	Écran des mondes : 6 mondes + retour au lobby.
	Affiche les prérequis, la valeur des objets, l'œuf du monde et un
	bouton "VOYAGER" (validé côté serveur).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local Formulas = require(Modules:WaitForChild("Formulas"))
local Net = require(Modules:WaitForChild("Net"))

local UIConfig = require(script.Parent.UIConfig)
local UILib = require(script.Parent.UILib)
local ClientState = require(script.Parent.Parent.Controllers.ClientState)

local WorldsUI = {}

local C = UIConfig.Colors

function WorldsUI.show(ctx)
	local frame, content = UILib.showModal(ctx.screenGui, "worlds", "🌍 MONDES", { Size = UDim2.fromOffset(820, 580) })
	UILib.clearContent(content)

	local refreshers = {}

	-- Carte lobby
	local lobbyCard = UILib.card(content, {
		Name = "LobbyCard",
		Size = UDim2.new(1, -8, 0, 76),
		Color = C.Card,
		LayoutOrder = 0,
		StrokeColor = C.Blue,
		StrokeTransparency = 0.4,
	})
	local lobbyIcon = UILib.label(lobbyCard, "🏠", {
		Size = UDim2.fromOffset(52, 52),
		Position = UDim2.fromOffset(12, 12),
		Font = UIConfig.FontTitle,
		TextScaled = true,
	})
	local lobbyText = UILib.label(lobbyCard, "Lobby — le hub du jeu (autel, portails, classement)", {
		Size = UDim2.new(1, -260, 1, 0),
		Position = UDim2.fromOffset(74, 0),
		Font = UIConfig.FontBody,
		TextSize = 13,
		Color = C.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
	})
	local lobbyButton = UILib.button(lobbyCard, "RETOUR AU LOBBY", {
		Size = UDim2.fromOffset(170, 46),
		Position = UDim2.new(1, -184, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Color = C.Blue,
		TextColor = C.TextDark,
		TextSize = 12,
	})
	lobbyButton.MouseButton1Click:Connect(function()
		Net.event("TravelWorld"):FireServer(0)
		UILib.closeModal()
	end)

	for index, world in ipairs(GameConfig.Worlds) do
		local card = UILib.card(content, {
			Name = "World" .. index,
			Size = UDim2.new(1, -8, 0, 96),
			Color = C.Card,
			LayoutOrder = index,
			StrokeColor = world.SkyColor,
			StrokeTransparency = 0.45,
		})

		local iconBox = UILib.panel(card, {
			Size = UDim2.fromOffset(64, 64),
			Position = UDim2.fromOffset(14, 16),
			Color = world.SkyColor:Lerp(C.Panel, 0.45),
			Radius = UIConfig.Radius.Medium,
			StrokeColor = world.SkyColor,
			StrokeThickness = 2,
		})
		UILib.label(iconBox, world.Emoji, {
			Size = UDim2.fromScale(1, 1),
			Font = UIConfig.FontTitle,
			TextScaled = true,
		})

		local name = UILib.label(card, string.format("%d. %s", index, world.Name), {
			Size = UDim2.new(1, -320, 0, 24),
			Position = UDim2.fromOffset(90, 12),
			Font = UIConfig.FontTitle,
			TextSize = 18,
			Color = world.SkyColor,
			TextXAlignment = Enum.TextXAlignment.Left,
		})
		name.Name = "Name"

		local detail = UILib.label(card, string.format(
			"Objets ×%s de valeur  •  œuf : %s %s",
			Formulas.formatNumber(world.ValueMult),
			GameConfig.Eggs[world.Egg] and GameConfig.Eggs[world.Egg].Emoji or "🥚",
			GameConfig.Eggs[world.Egg] and GameConfig.Eggs[world.Egg].Name or "—"
		), {
			Size = UDim2.new(1, -320, 0, 18),
			Position = UDim2.fromOffset(90, 36),
			Font = UIConfig.FontSmall,
			TextSize = 11,
			Color = C.TextDim,
			TextXAlignment = Enum.TextXAlignment.Left,
		})
		detail.Name = "Detail"

		local requirement = UILib.label(card, "", {
			Size = UDim2.new(1, -320, 0, 18),
			Position = UDim2.fromOffset(90, 54),
			Font = UIConfig.FontBold,
			TextSize = 11,
			Color = C.Gold,
			TextXAlignment = Enum.TextXAlignment.Left,
		})
		requirement.Name = "Requirement"

		local travelButton = UILib.button(card, "VOYAGER", {
			Size = UDim2.fromOffset(190, 50),
			Position = UDim2.new(1, -204, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			Color = C.Green,
			TextColor = C.TextDark,
		})
		travelButton.MouseButton1Click:Connect(function()
			Net.event("TravelWorld"):FireServer(index)
			UILib.closeModal()
		end)

		local function refresh()
			local profile = ClientState.profile
			local unlocked = ClientState.isWorldUnlocked(index)
			local current = ClientState.getWorld() == index
			local requirements = {}
			if world.UnlockPower &gt; 0 then
				table.insert(requirements, string.format("%s ⚡", Formulas.formatNumber(world.UnlockPower)))
			end
			if world.UnlockRebirth &gt; 0 then
				table.insert(requirements, string.format("%d 🔄", world.UnlockRebirth))
			end
			requirement.Text = unlocked and "✅ Débloqué" or ("🔒 Requiert : " .. table.concat(requirements, " + "))
			requirement.TextColor3 = unlocked and C.Green or C.Gold

			if current then
				travelButton.Text = "📍 TU ES ICI"
				travelButton.BackgroundColor3 = C.PanelLight
				travelButton.TextColor3 = C.TextDim
			elseif unlocked then
				travelButton.Text = "VOYAGER"
				travelButton.BackgroundColor3 = C.Green
				travelButton.TextColor3 = C.TextDark
			else
				travelButton.Text = "VERROUILLÉ"
				travelButton.BackgroundColor3 = C.PanelLight
				travelButton.TextColor3 = C.TextDim
			end
		end
		refresh()
		table.insert(refreshers, refresh)
	end

	return function()
		for _, refresh in ipairs(refreshers) do
			pcall(refresh)
		end
	end
end

return WorldsUI
</ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>
