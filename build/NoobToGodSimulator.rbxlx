        </Item><Item class="ModuleScript" referent="RBX0029">
          <Properties>
            <string name="Name">PetFollowController</string>
            <ProtectedString name="Source">--!strict
--[[
	PetFollowController  |  StarterPlayer.StarterPlayerScripts.Controllers.PetFollowController
	------------------------------------------------------------------
	Fait apparaître les pets équipés autour du personnage et les fait
	flotter/tourner (100% client : le serveur ne gère que les données).

	• Aucun pet en double (clé = uid)
	• Positions en cercle derrière le joueur, lissage par interpolation
	• Les pets rares brillent et laissent des particules (PetFactory)
	• Désactivable dans les paramètres (optimisation mobile)
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local ClientState = require(script.Parent.ClientState)
local PetFactory = require(script.Parent.PetFactory)

local PetFollowController = {}

local petModels: { [string]: Model } = {}
local petAngles: { [string]: number } = {}
local petBob: { [string]: number } = {}
local container: Folder? = nil
local lastSignature = ""

local function getContainer(): Folder
	if container and container.Parent then
		return container
	end
	local folder = Instance.new("Folder")
	folder.Name = "LocalPets"
	folder.Parent = Workspace
	container = folder
	return folder
end

local function clearAll()
	for uid, model in pairs(petModels) do
		if model then
			model:Destroy()
		end
		petModels[uid] = nil
	end
end

local function syncPets()
	local equipped = ClientState.getEquippedPets()
	local signature = {}
	for _, pet in ipairs(equipped) do
		table.insert(signature, pet.uid .. ":" .. tostring(pet.level))
	end
	local signatureString = table.concat(signature, ",")

	if not ClientState.getSetting("petsVisible") then
		if lastSignature ~= "hidden" then
			clearAll()
			lastSignature = "hidden"
		end
		return
	end
	if signatureString == lastSignature then
		return
	end
	lastSignature = signatureString

	-- Supprime les pets qui ne sont plus équipés
	local equippedSet = {}
	for _, pet in ipairs(equipped) do
		equippedSet[pet.uid] = true
	end
	for uid, model in pairs(petModels) do
		if not equippedSet[uid] then
			model:Destroy()
			petModels[uid] = nil
			petAngles[uid] = nil
			petBob[uid] = nil
		end
	end

	-- Crée / recrée les pets manquants ou de niveau différent
	for _, pet in ipairs(equipped) do
		local existing = petModels[pet.uid]
		local levelAttribute = existing and existing:GetAttribute("PetLevel")
		if not existing or levelAttribute ~= pet.level then
			if existing then
				existing:Destroy()
			end
			local model = PetFactory.create(pet.id, pet.level)
			model.Parent = getContainer()
			petModels[pet.uid] = model
			petAngles[pet.uid] = math.random() * math.pi * 2
			petBob[pet.uid] = math.random() * math.pi * 2
		end
	end
end

local function updatePets(deltaTime: number)
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local count = 0
	for _ in pairs(petModels) do
		count = count + 1
	end
	if count == 0 then
		return
	end

	local time = os.clock()
	local origin = (root :: BasePart).CFrame
	local index = 0
	for uid, model in pairs(petModels) do
		index = index + 1
		if not model.PrimaryPart or not model.Parent then
			petModels[uid] = nil
		else
			petAngles[uid] = (petAngles[uid] or 0) + deltaTime * 0.9
			petBob[uid] = (petBob[uid] or 0) + deltaTime * 2.2

			local angle = petAngles[uid] + (index / count) * math.pi * 2
			local radius = 3.2 + count * 0.32
			local height = 1.6 + math.sin(petBob[uid]) * 0.45

			-- Position derrière/autour du joueur (recalée par rapport à son orientation)
			local localOffset = Vector3.new(math.cos(angle) * radius, height, math.sin(angle) * radius * 0.75)
			local targetPosition = (origin + origin:VectorToWorldSpace(localOffset)).Position
			local currentPosition = model:GetPivot().Position
			local smoothed = currentPosition:Lerp(targetPosition, math.clamp(deltaTime * 7, 0, 1))

			model:PivotTo(CFrame.new(smoothed) * CFrame.Angles(0, angle + math.pi / 2, 0))
		end
	end
end

function PetFollowController.start()
	ClientState.Signals.Profile:Connect(function()
		task.defer(syncPets)
	end)
	Players.LocalPlayer.CharacterAdded:Connect(function()
		task.wait(0.5)
		syncPets()
	end)
	RunService.Heartbeat:Connect(updatePets)
	syncPets()
	print("[PetFollowController] Démarré")
end

return PetFollowController
</ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item><Item class="ModuleScript" referent="RBX002A">
          <Properties>
            <string name="Name">SoundController</string>
            <ProtectedString name="Source">--!strict
--[[
	SoundController  |  StarterPlayer.StarterPlayerScripts.Controllers.SoundController
	------------------------------------------------------------------
	Sons du jeu.

	Astuce : les sons utilisés par défaut sont des sons NATIFS de Roblox
	(rbxasset://sounds/...), donc il n'y a AUCUN asset à importer.
	Pour mettre de la vraie musique, mets un ID audio dans
	GameConfig.Worlds[i].MusicId (ex : "rbxassetid://1837879082").
]]

local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))

local ClientState = require(script.Parent.ClientState)

local SoundController = {}

-- key = { id, volume, pitch, pitchVariance }
local SOUNDS = {
	click = { id = "rbxasset://sounds/clickfast.wav", volume = 0.25, pitch = 1 },
	ui = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.2, pitch = 1.2 },
	absorb = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.16, pitch = 1.5, variance = 0.25 },
	coin = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.3, pitch = 2, variance = 0.1 },
	golden = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.35, pitch = 2.6 },
	vacuum = { id = "rbxasset://sounds/snap.mp3", volume = 0.4, pitch = 0.9 },
	auto = { id = "rbxasset://sounds/switch3.wav", volume = 0.12, pitch = 1.6 },
	teleport = { id = "rbxasset://sounds/swoosh.wav", volume = 0.4, pitch = 1 },
	unlock = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.5, pitch = 1.8 },
	transform = { id = "rbxasset://sounds/uuhhh.mp3", volume = 0.3, pitch = 1.35 },
	rebirth = { id = "rbxasset://sounds/bass.wav", volume = 0.5, pitch = 1 },
	event = { id = "rbxasset://sounds/impact_water.mp3", volume = 0.4, pitch = 1.2 },
	achievement = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.5, pitch = 1.4 },
	daily = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.45, pitch = 1.1 },
	buy = { id = "rbxasset://sounds/switch3.wav", volume = 0.35, pitch = 1.1 },
	equip = { id = "rbxasset://sounds/switch3.wav", volume = 0.3, pitch = 1.3 },
	fuse = { id = "rbxasset://sounds/bass.wav", volume = 0.35, pitch = 1.6 },
	egg = { id = "rbxasset://sounds/snap.mp3", volume = 0.35, pitch = 1.2 },
	rarity = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.5, pitch = 1.7 },
	pet = { id = "rbxasset://sounds/uuhhh.mp3", volume = 0.15, pitch = 1.8 },
}

local musicSound: Sound? = nil
local currentMusicId: string? = nil
local container: Folder? = nil

local function getContainer(): Folder
	if container and container.Parent then
		return container
	end
	local folder = Instance.new("Folder")
	folder.Name = "GameSounds"
	folder.Parent = SoundService
	container = folder
	return folder
end

function SoundController.play(key: string, volumeScale: number?)
	if not ClientState.getSetting("sfx") then
		return
	end
	local data = SOUNDS[key]
	if not data then
		return
	end
	local sound = Instance.new("Sound")
	sound.SoundId = data.id
	sound.Volume = math.clamp(data.volume * (volumeScale or 1), 0, 5)
	sound.PlaybackSpeed = data.pitch * (1 + math.random(-10, 10) * 0.01 * (data.variance or 0))
	sound.RollOffMode = Enum.RollOffMode.Inverse
	sound.Parent = getContainer()
	sound:Play()
	task.delay(4, function()
		sound:Destroy()
	end)
end

--- Joue la musique du monde (si un ID est configuré)
function SoundController.playWorldMusic(worldIndex: number)
	local world = GameConfig.Worlds[worldIndex]
	local musicId = world and world.MusicId or ""
	if not musicId or musicId == "" then
		if currentMusicId ~= "" then
			SoundController.stopMusic()
			currentMusicId = ""
		end
		return
	end
	if currentMusicId == musicId then
		return
	end
	SoundController.stopMusic()
	currentMusicId = musicId
	local sound = Instance.new("Sound")
	sound.Name = "WorldMusic"
	sound.SoundId = musicId
	sound.Volume = 0.25
	sound.Looped = true
	sound.Parent = getContainer()
	if ClientState.getSetting("music") then
		sound:Play()
	end
	musicSound = sound
end

function SoundController.stopMusic()
	if musicSound then
		musicSound:Destroy()
		musicSound = nil
	end
end

function SoundController.applySettings()
	if musicSound then
		if ClientState.getSetting("music") then
			if not musicSound.IsPlaying then
				musicSound:Play()
			end
		else
			musicSound:Stop()
		end
	end
end

function SoundController.start()
	ClientState.Signals.Sound:Connect(function(key, volume)
		SoundController.play(key, volume)
	end)
	ClientState.Signals.World:Connect(function(worldIndex)
		SoundController.playWorldMusic(worldIndex)
	end)
	ClientState.Signals.Profile:Connect(function()
		SoundController.applySettings()
	end)
end

return SoundController
</ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
      </Item><Item class="Folder" referent="RBX002B">
        <Properties>
          <string name="Name">UI</string>
        </Properties><Item class="ModuleScript" referent="RBX002C">
          <Properties>
            <string name="Name">AchievementsUI</string>
            <ProtectedString name="Source">--!strict
--[[
	AchievementsUI  |  StarterPlayer.StarterPlayerScripts.UI.AchievementsUI
	------------------------------------------------------------------
	Liste des 24 succès avec progression et récompense.
	(l'octroi est entièrement serveur, l'UI ne fait qu'afficher)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local Formulas = require(Modules:WaitForChild("Formulas"))

local UIConfig = require(script.Parent.UIConfig)
local UILib = require(script.Parent.UILib)
local ClientState = require(script.Parent.Parent.Controllers.ClientState)

local AchievementsUI = {}

local C = UIConfig.Colors

local function getStatValue(profile, statName: string): number
	if statName == "rebirths" then
		return profile.rebirths or 0
	elseif statName == "bestPower" then
		return math.max(profile.bestPower or 0, profile.power or 0)
	elseif statName == "maxWorld" then
		return profile.maxWorld or 1
	elseif statName == "streak" then
		return (profile.daily and profile.daily.streak) or 0
	end
	return (profile.stats and profile.stats[statName]) or 0
end

function AchievementsUI.show(ctx)
	local frame, content = UILib.showModal(ctx.screenGui, "achievements", "🏅 SUCCÈS", { Size = UDim2.fromOffset(780, 580) })
	UILib.clearContent(content)

	local summary = UILib.card(content, {
		Name = "Summary",
		Size = UDim2.new(1, -8, 0, 56),
		Color = C.Card,
		LayoutOrder = 0,
	})
	local summaryLabel = UILib.label(summary, "", {
		Size = UDim2.new(1, -24, 1, 0),
		Position = UDim2.fromOffset(12, 0),
		Font = UIConfig.FontBold,
		TextSize = 14,
		Color = C.Green,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	summaryLabel.Name = "Text"

	local holder = Instance.new("Frame")
	holder.Name = "Holder"
	holder.Size = UDim2.new(1, -8, 0, 0)
	holder.AutomaticSize = Enum.AutomaticSize.Y
	holder.BackgroundTransparency = 1
	holder.LayoutOrder = 1
	holder.Parent = content
	UILib.list(holder, { Padding = UDim.new(0, 6) })

	local rows = {}

	for index, achievementId in ipairs(GameConfig.AchievementOrder) do
		local achievement = GameConfig.Achievements[achievementId]
		if achievement then
			local row = UILib.card(holder, {
				Name = "Ach_" .. achievementId,
				Size = UDim2.new(1, -8, 0, 62),
				Color = C.Card,
				LayoutOrder = index,
			})

			local icon = UILib.label(row, achievement.Icon, {
				Size = UDim2.fromOffset(46, 46),
				Position = UDim2.fromOffset(10, 8),
				Font = UIConfig.FontTitle,
				TextScaled = true,
			})
			icon.Name = "Icon"

			local name = UILib.label(row, achievement.Name, {
				Size = UDim2.new(1, -300, 0, 20),
				Position = UDim2.fromOffset(64, 8),
				Font = UIConfig.FontBold,
				TextSize = 14,
				Color = C.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
			})
			name.Name = "Name"

			local desc = UILib.label(row, achievement.Desc, {
				Size = UDim2.new(1, -300, 0, 16),
				Position = UDim2.fromOffset(64, 26),
				Font = UIConfig.FontSmall,
				TextSize = 11,
				Color = C.TextDim,
				TextXAlignment = Enum.TextXAlignment.Left,
			})
			desc.Name = "Desc"

			local barHolder, barFill = UILib.bar(row, {
				Size = UDim2.new(0, 200, 0, 6),
				Position = UDim2.fromOffset(64, 46),
				Color = C.Green,
			})
			barHolder.Name = "Progress"

			local progressLabel = UILib.label(row, "", {
				Size = UDim2.new(1, -320, 0, 16),
				Position = UDim2.new(0, 274, 0, 42),
				Font = UIConfig.FontSmall,
				TextSize = 10,
				Color = C.TextDim,
				TextXAlignment = Enum.TextXAlignment.Left,
			})
			progressLabel.Name = "ProgressText"

			local reward = UILib.label(row, "🏆 +" .. Formulas.formatNumber(achievement.Reward), {
				Size = UDim2.fromOffset(160, 62),
				Position = UDim2.new(1, -170, 0, 0),
				Font = UIConfig.FontTitle,
				TextSize = 15,
				Color = C.Gold,
				TextXAlignment = Enum.TextXAlignment.Right,
			})
			reward.Name = "Reward"

			table.insert(rows, {
				Achievement = achievement,
				Row = row,
				Fill = barFill,
				ProgressLabel = progressLabel,
				Icon = icon,
				Name = name,
			})
		end
	end

	local function refresh()
		local profile = ClientState.profile
		local unlockedCount = 0
		for _, data in ipairs(rows) do
			local value = getStatValue(profile, data.Achievement.Stat)
			local unlocked = profile.achievements and profile.achievements[data.Achievement.Id]
			local progress = math.min(value, data.Achievement.Goal)
			if unlocked then
				unlockedCount = unlockedCount + 1
			end

			UILib.setBar(data.Fill, progress / data.Achievement.Goal)
			data.Fill.BackgroundColor3 = unlocked and C.Gold or C.Green
			data.ProgressLabel.Text = string.format("%s / %s", Formulas.formatNumber(progress), Formulas.formatNumber(data.Achievement.Goal))
			data.Row.BackgroundColor3 = unlocked and C.PanelLight or C.Card
			data.Name.TextColor3 = unlocked and C.Gold or C.Text
			data.Row:FindFirstChild("Reward").TextColor3 = unlocked and C.Green or C.Gold
		end
		summaryLabel.Text = string.format("🏅 %d / %d succès débloqués  •  continue comme ça !", unlockedCount, #rows)
	end

	refresh()
	return refresh
end

return AchievementsUI
</ProtectedString>
