          <ProtectedString name="Source">--!strict
--[[
	Formulas  |  ReplicatedStorage.Modules.Formulas
	------------------------------------------------------------------
	Toutes les formules d'équilibrage. Utilisé par le SERVEUR (calculs
	officiels) et par le CLIENT (affichage / prévisions uniquement).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameConfig = nil

-- require compatible avec un ModuleScript placé ailleurs
local function getConfig()
	if GameConfig then
		return GameConfig
	end
	local module = script.Parent:FindFirstChild("GameConfig")
	assert(module, "GameConfig introuvable à côté de Formulas")
	GameConfig = require(module)
	return GameConfig
end

local Formulas = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc", "Ud", "Dd", "Td", "Qad", "Qid", "Sxd", "Spd", "Ocd", "Nod", "Vg" }

--- Formate un nombre à la Roblox Simulator : 1 234 → 1.23K
function Formulas.formatNumber(value: number): string
	if value ~= value then
		return "0"
	end
	if value &lt; 0 then
		return "-" .. Formulas.formatNumber(-value)
	end
	if value &lt; 1000 then
		if value == math.floor(value) then
			return tostring(math.floor(value))
		end
		return string.format("%.1f", value)
	end
	local index = math.floor(math.log(value, 1000))
	index = math.clamp(index, 1, #SUFFIXES - 1)
	local scaled = value / (1000 ^ index)
	local text
	if scaled &lt; 10 then
		text = string.format("%.2f", scaled)
	elseif scaled &lt; 100 then
		text = string.format("%.1f", scaled)
	else
		text = string.format("%.0f", scaled)
	end
	-- retire les ".00" inutiles
	text = string.gsub(text, "(%.%d-)0+$", "%1")
	text = string.gsub(text, "%.$", "")
	return text .. SUFFIXES[index + 1]
end

--- Formate une durée en mm:ss
function Formulas.formatTime(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local m = math.floor(seconds / 60)
	local s = seconds % 60
	if m &gt;= 60 then
		local h = math.floor(m / 60)
		return string.format("%dh%02d", h, m % 60)
	end
	return string.format("%d:%02d", m, s)
end

--- Tier de transformation selon la puissance ACTUELLE
function Formulas.getTransformIndex(power: number): number
	local list = getConfig().Transformations
	local index = 1
	for i = 1, #list do
		if power &gt;= list[i].MinPower then
			index = i
		else
			break
		end
	end
	return index
end

function Formulas.getTransformation(power: number)
	local config = getConfig()
	return config.Transformations[Formulas.getTransformIndex(power)]
end

--- Puissance nécessaire pour la transformation suivante (ou nil)
function Formulas.getNextTransformation(power: number)
	local config = getConfig()
	local index = Formulas.getTransformIndex(power)
	return config.Transformations[index + 1]
end

--- Coût du prochain rebirth
function Formulas.rebirthCost(rebirths: number): number
	local config = getConfig()
	return math.floor(config.Rebirth.BaseCost * (config.Rebirth.CostGrowth ^ rebirths))
end

--- Multiplicateur de rebirth
function Formulas.rebirthMultiplier(rebirths: number): number
	return 1 + rebirths * getConfig().Rebirth.MultPerRebirth
end

--- Coût d'une amélioration
function Formulas.upgradeCost(upgradeId: string, level: number): number
	local upgrade = getConfig().Upgrades[upgradeId]
	if not upgrade then
		return math.huge
	end
	return math.floor(upgrade.BaseCost * (upgrade.CostGrowth ^ level))
end

function Formulas.upgradeMaxLevel(upgradeId: string): number
	local upgrade = getConfig().Upgrades[upgradeId]
	return upgrade and upgrade.MaxLevel or 0
end

--- Somme des multiplicateurs de pets équipés
function Formulas.petMultiplier(profile): number
	local config = getConfig()
	local total = 0
	local owned = {}
	for _, pet in ipairs(profile.pets or {}) do
		owned[pet.uid] = pet
	end
	for _, uid in ipairs(profile.equipped or {}) do
		local pet = owned[uid]
		if pet then
			local info = config.Pets[pet.id]
			if info then
				total = total + info.Mult * Formulas.petLevelMultiplier(pet.level or 1)
			end
		end
	end
	return 1 + total
end

--- Chaque niveau de pet ajoute +25% de son multiplicateur de base
function Formulas.petLevelMultiplier(level: number): number
	return 1 + (math.max(1, level) - 1) * 0.25
end

function Formulas.petPower(petId: string, level: number): number
	local info = getConfig().Pets[petId]
	if not info then
		return 0
	end
	return info.Mult * Formulas.petLevelMultiplier(level)
end

--- Multiplicateur d'amélioration de puissance
function Formulas.upgradeMultiplier(profile, upgradeId: string): number
	local upgrade = getConfig().Upgrades[upgradeId]
	local level = (profile.upgrades and profile.upgrades[upgradeId]) or 0
	if not upgrade or not upgrade.Effect then
		return 1
	end
	return 1 + level * upgrade.Effect
end

--- Multiplicateur TOTAL de puissance d'un joueur.
--- gamePasses = { DoublePower = bool, VIP = bool } (fourni par le serveur)
function Formulas.totalPowerMultiplier(profile, gamePasses, eventMult: number?, boostMult: number?): number
	local config = getConfig()
	local mult = 1
	mult = mult * Formulas.rebirthMultiplier(profile.rebirths or 0)
	mult = mult * Formulas.petMultiplier(profile)
	mult = mult * Formulas.upgradeMultiplier(profile, "PowerMult")
	mult = mult * (eventMult or 1)
	mult = mult * (boostMult or 1)
	if gamePasses then
		if gamePasses.DoublePower then
			mult = mult * 2
		end
		if gamePasses.VIP then
			mult = mult * 1.5
		end
	end
	return mult
end

function Formulas.totalCoinMultiplier(profile, gamePasses): number
	local config = getConfig()
	local mult = Formulas.upgradeMultiplier(profile, "CoinMult")
	if gamePasses and gamePasses.VIP then
		mult = mult * 1.5
	end
	return mult * config.Collect.CoinRatio
end

--- Nombre d'emplacements de pets du joueur
function Formulas.petSlots(profile, hasExtraSlots: boolean?): number
	local config = getConfig()
	local level = (profile.upgrades and profile.upgrades.PetSlots) or 0
	local slots = config.BasePetSlots + level
	if hasExtraSlots then
		slots = slots + 3
	end
	return slots
end

--- Valeur de puissance d'un objet
function Formulas.objectPower(worldIndex: number, objectId: string, golden: boolean?): number
	local config = getConfig()
	local world = config.Worlds[worldIndex]
	if not world then
		return 0
	end
	local data = config.ObjectTypes[objectId] or config.WorldObjectTypes[objectId]
	if not data then
		return 0
	end
	local value = data.Power * world.ValueMult
	if golden then
		value = value * config.EventRewards.GoldenObjectsMult
	end
	return value
end

function Formulas.getObjectData(objectId: string)
	local config = getConfig()
	return config.ObjectTypes[objectId] or config.WorldObjectTypes[objectId]
end

--- Rayon d'absorption automatique (0 = non débloqué)
function Formulas.autoCollectRadius(profile, hasGamePass: boolean?): number
	local config = getConfig()
	local level = (profile.upgrades and profile.upgrades.AutoCollect) or 0
	if level &lt;= 0 and not hasGamePass then
		return 0
	end
	level = math.max(level, 1)
	return config.Upgrades.AutoCollect.RadiusBase + (level - 1) * config.Upgrades.AutoCollect.RadiusPerLevel
end

function Formulas.autoCollectInterval(profile): number
	local config = getConfig()
	local level = math.max(1, (profile.upgrades and profile.upgrades.AutoCollect) or 1)
	local interval = config.Upgrades.AutoCollect.IntervalBase - (level - 1) * config.Upgrades.AutoCollect.IntervalPerLevel
	return math.max(0.35, interval)
end

function Formulas.vacuumRadius(profile): number
	local config = getConfig()
	local level = (profile.upgrades and profile.upgrades.Vacuum) or 0
	return config.Collect.Vacuum.BaseRadius + level * config.Collect.Vacuum.RadiusPerLevel
end

function Formulas.vacuumCooldown(profile): number
	local config = getConfig()
	local level = (profile.upgrades and profile.upgrades.Vacuum) or 0
	return math.max(2, config.Collect.Vacuum.BaseCooldown - level * config.Collect.Vacuum.CooldownReductionPerLevel)
end

function Formulas.walkSpeed(profile): number
	local config = getConfig()
	local level = (profile.upgrades and profile.upgrades.WalkSpeed) or 0
	return 16 + level * config.Upgrades.WalkSpeed.Effect
end

--- Probabilités réellement affichées pour un œuf (somme = 100)
function Formulas.eggDisplayOdds(eggId: string)
	local config = getConfig()
	local egg = config.Eggs[eggId]
	local result = {}
	if not egg then
		return result
	end
	local total = 0
	for rarity, weight in pairs(egg.Rates) do
		local pool = egg.Pool[rarity]
		if pool and #pool &gt; 0 then
			total = total + weight
		end
	end
	if total &lt;= 0 then
		return result
	end
	for _, rarity in ipairs(config.RarityOrder) do
		local weight = egg.Rates[rarity]
		local pool = egg.Pool[rarity]
		if weight and pool and #pool &gt; 0 then
			table.insert(result, {
				Rarity = rarity,
				Chance = (weight / total) * 100,
				Color = config.Rarities[rarity].Color,
				Pets = pool,
			})
		end
	end
	return result
end

--- Prix affiché du rebirth suivant (identique au serveur)
function Formulas.rebirthCoinReward(rebirths: number): number
	local config = getConfig()
	return config.Rebirth.CoinRewardBase + config.Rebirth.CoinRewardPerRebirth * rebirths
end

return Formulas
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item><Item class="ModuleScript" referent="RBX000B">
        <Properties>
          <string name="Name">GameConfig</string>
          <ProtectedString name="Source">--!strict
--[[
	GameConfig  |  ReplicatedStorage.Modules.GameConfig
	------------------------------------------------------------------
	CONFIGURATION CENTRALE DU JEU (partagée client + serveur).
	Tout l'équilibrage du jeu se règle ICI. Aucun script ne doit
	contenir de valeur magique : il doit toujours lire GameConfig.

	ATTENTION SÉCURITÉ :
	Le serveur est la seule source de vérité. Le client lit ce module
	uniquement pour AFFICHER (prix, descriptions, probabilités…).
]]

local GameConfig = {}

GameConfig.GameName = "NOOB TO GOD SIMULATOR"
GameConfig.Version = 4
GameConfig.DataStoreName = "NoobToGodSimulator"
GameConfig.DataStoreKeyPrefix = "Player_"
GameConfig.DataVersion = 4

-- ============================================================
-- 1. COLLECTE
-- ============================================================
GameConfig.Collect = {
	-- Rayon de base (studs) dans lequel un objet est cliquable / aspiré
	TouchRadius = 12,
	ClickRadius = 260, -- distance max pour cliquer un objet (anti-cheat serveur)
	-- Resspawn d'un objet après absorption
	RespawnTime = 6,
	-- Nombre maximum d'objets actifs par joueur et par monde (optimisation mobile)
	MaxActivePerWorld = 90,
	-- Coins = Power * CoinRatio
	CoinRatio = 0.12,
	-- Pouvoir "VACUUM" (aspiration de zone)
	Vacuum = {
		BaseRadius = 45,
		BaseCooldown = 12,
		RadiusPerLevel = 9,
		CooldownReductionPerLevel = 0.9,
		MaxLevel = 5,
	},
	-- Seuil de "combo" : collecter vite fait monter un compteur de satisfaction
	ComboWindow = 2.5,
	ComboMaxStacks = 20,
	-- Limite anti-flood : requêtes de collecte acceptées par seconde
	MaxRequestsPerSecond = 22,
}

-- Types d'objets du monde 1 (valeurs demandées dans le brief)
GameConfig.ObjectTypes = {
	Trash      = { Name = "Déchet",           Power = 1,    Color = Color3.fromRGB(120, 130, 120), Material = Enum.Material.Sand,      Size = Vector3.new(1.4, 1.4, 1.4),  Shape = "Block" },
	Pizza      = { Name = "Pizza",            Power = 5,    Color = Color3.fromRGB(240, 170, 60),  Material = Enum.Material.SmoothPlastic, Size = Vector3.new(2.4, 0.4, 2.4), Shape = "Cylinder" },
	TV         = { Name = "Télévision",       Power = 20,   Color = Color3.fromRGB(40, 45, 60),    Material = Enum.Material.SmoothPlastic, Size = Vector3.new(3, 2.2, 1),     Shape = "Block" },
	Car        = { Name = "Voiture",          Power = 100,  Color = Color3.fromRGB(220, 60, 60),   Material = Enum.Material.SmoothPlastic, Size = Vector3.new(5, 1.8, 2.6),   Shape = "Block" },
	House      = { Name = "Maison",           Power = 500,  Color = Color3.fromRGB(230, 210, 180), Material = Enum.Material.Brick,     Size = Vector3.new(8, 7, 8),        Shape = "Block" },
	GiantTower = { Name = "Bâtiment géant",   Power = 5000, Color = Color3.fromRGB(150, 160, 190), Material = Enum.Material.Concrete, Size = Vector3.new(11, 26, 11),     Shape = "Block" },
}

-- ============================================================
-- 2. TRANSFORMATIONS (évolution visuelle &amp; statistiques)
--    tier = index, seuil = puissance ACTUELLE nécessaire
-- ============================================================
GameConfig.Transformations = {
	{ Tier = 1,  Name = "Noob",      Emoji = "🪵", MinPower = 0,       Size = 1.00, Color = Color3.fromRGB(255, 214, 80),  Aura = Color3.fromRGB(255, 240, 160), ParticleRate = 0,  Desc = "Tu es un noob. Assumé." },
	{ Tier = 2,  Name = "Beginner",  Emoji = "🌱", MinPower = 50,      Size = 1.10, Color = Color3.fromRGB(120, 230, 120), Aura = Color3.fromRGB(180, 255, 180), ParticleRate = 6,  Desc = "Tu as compris le concept du clic." },
	{ Tier = 3,  Name = "Pro",       Emoji = "😎", MinPower = 250,     Size = 1.25, Color = Color3.fromRGB(80, 180, 255),  Aura = Color3.fromRGB(140, 220, 255), ParticleRate = 12, Desc = "Les noobs te demandent des conseils." },
	{ Tier = 4,  Name = "Hacker",    Emoji = "💻", MinPower = 1000,    Size = 1.45, Color = Color3.fromRGB(80, 255, 160),  Aura = Color3.fromRGB(0, 255, 140),   ParticleRate = 18, Desc = "Tu aspires la matrice. Illégalement." },
	{ Tier = 5,  Name = "Titan",     Emoji = "🗿", MinPower = 5000,    Size = 1.75, Color = Color3.fromRGB(200, 140, 90),  Aura = Color3.fromRGB(255, 190, 120), ParticleRate = 24, Desc = "Les bâtiments te craignent." },
	{ Tier = 6,  Name = "Monster",   Emoji = "👹", MinPower = 20000,   Size = 2.10, Color = Color3.fromRGB(200, 50, 90),   Aura = Color3.fromRGB(255, 40, 80),   ParticleRate = 30, Desc = "GrRRrR. Les pets se cachent." },
	{ Tier = 7,  Name = "God",       Emoji = "⚡", MinPower = 100000,  Size = 2.50, Color = Color3.fromRGB(255, 235, 120), Aura = Color3.fromRGB(255, 215, 0),   ParticleRate = 40, Desc = "Le serveur prie pour toi." },
	{ Tier = 8,  Name = "Cosmic",    Emoji = "🌌", MinPower = 500000,  Size = 3.00, Color = Color3.fromRGB(170, 120, 255), Aura = Color3.fromRGB(200, 160, 255), ParticleRate = 55, Desc = "Tu es fait d'étoiles maintenant." },
	{ Tier = 9,  Name = "Universal", Emoji = "🪐", MinPower = 2000000, Size = 3.60, Color = Color3.fromRGB(90, 200, 255),  Aura = Color3.fromRGB(60, 230, 255),  ParticleRate = 70, Desc = "Les planètes sont des snacks." },
	{ Tier = 10, Name = "Infinity",  Emoji = "♾️", MinPower = 10000000,Size = 4.30, Color = Color3.fromRGB(255, 255, 255), Aura = Color3.fromRGB(120, 255, 255), ParticleRate = 90, Desc = "Tu as dépassé le jeu. Bravo." },
}

-- ============================================================
-- 3. REBIRTH
-- ============================================================
GameConfig.Rebirth = {
	MaxRebirths = 40,
	-- Coût = BaseCost * CostGrowth^rebirths
	-- 1.85 est calibré pour que le rebirth 40 reste atteignable avec des
	-- pets maxés (~9700 clics) tout en gardant un début de partie rapide
	-- (~12 clics pour le rebirth 1).
	BaseCost = 2500,
	CostGrowth = 1.85,
	-- Multiplicateur permanent : 1 + (rebirths * 0.35)  (additif, lisible)
	MultPerRebirth = 0.35,
	-- Coins offerts au rebirth
	CoinRewardBase = 250,
	CoinRewardPerRebirth = 175,
	-- Titre débloqué tous les N rebirths (voir Titles)
	TitlesEvery = 5,
}

-- ============================================================
-- 4. AMÉLIORATIONS (boutique en pièces)
-- ============================================================
GameConfig.Upgrades = {
	PowerMult = {
		Name = "Multiplicateur de Puissance",
		Desc = "+25% de puissance par niveau.",
		Icon = "⚡",
		MaxLevel = 25,
		BaseCost = 120,
		CostGrowth = 1.55,
		Effect = 0.25,
	},
	CoinMult = {
		Name = "Multiplicateur de Pièces",
		Desc = "+20% de pièces par niveau.",
		Icon = "🪙",
		MaxLevel = 20,
		BaseCost = 150,
		CostGrowth = 1.6,
		Effect = 0.20,
	},
	AutoCollect = {
		Name = "Absorption Automatique",
		Desc = "Aspire automatiquement les objets proches. Niveau 1 = débloqué.",
		Icon = "🌀",
		MaxLevel = 10,
		BaseCost = 400,
		CostGrowth = 1.75,
		-- rayon = 14 + level*7, intervalle = 2.2 - level*0.13
		RadiusBase = 14,
		RadiusPerLevel = 7,
		IntervalBase = 2.2,
		IntervalPerLevel = 0.13,
	},
	Vacuum = {
		Name = "Aspirateur de Zone",
		Desc = "+9 studs de rayon et -0.9s de recharge par niveau.",
		Icon = "🌪️",
		MaxLevel = 5,
		BaseCost = 700,
		CostGrowth = 1.9,
	},
	WalkSpeed = {
		Name = "Vitesse de Course",
		Desc = "+1.5 de vitesse de déplacement par niveau.",
		Icon = "🏃",
		MaxLevel = 12,
		BaseCost = 200,
		CostGrowth = 1.5,
		Effect = 1.5,
	},
	PetSlots = {
		Name = "Emplacements de Pets",
		Desc = "Équipe un pet supplémentaire (3 de base, 8 max).",
		Icon = "🐾",
		MaxLevel = 5,
		BaseCost = 1200,
		CostGrowth = 2.2,
	},
}

GameConfig.BasePetSlots = 3

-- ============================================================
-- 5. RARETÉS DE PETS
-- ============================================================
GameConfig.Rarities = {
	Common    = { Name = "Common",    Color = Color3.fromRGB(170, 180, 195), Weight = 1,   Order = 1 },
	Uncommon  = { Name = "Uncommon",  Color = Color3.fromRGB(110, 220, 130), Weight = 2,   Order = 2 },
