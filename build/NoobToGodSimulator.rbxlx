      </Item><Item class="ModuleScript" referent="RBX000C">
        <Properties>
          <string name="Name">Net</string>
          <ProtectedString name="Source">--!strict
--[[
	Net  |  ReplicatedStorage.Modules.Net
	------------------------------------------------------------------
	Registre central des RemoteEvents / RemoteFunctions.
	Le SERVEUR crée tout (Net.init()), le CLIENT attend (Net.get).

	Utilisation :
		Serveur : local net = require(ReplicatedStorage.Modules.Net); net.init()
		          net.event("CollectRequest").OnServerEvent:Connect(...)
		Client  : local net = require(ReplicatedStorage.Modules.Net)
		          net.event("CollectRequest"):FireServer(part)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

Net.FOLDER_NAME = "Remotes"

--- Client → Serveur
Net.RemoteEvents = {
	"CollectRequest",       -- (collectible: Instance)
	"VacuumRequest",        -- ()
	"BuyUpgrade",           -- (upgradeId: string)
	"OpenEgg",              -- (eggId: string, amount: number)
	"EquipPet",             -- (uid: string)
	"UnequipPet",           -- (uid: string)
	"EquipBestPets",        -- ()
	"FusePet",              -- (petId: string)
	"RebirthRequest",       -- ()
	"TravelWorld",          -- (worldIndex: number)
	"ClaimDaily",           -- ()
	"ClaimAchievement",     -- (achievementId: string)
	"SelectTitle",          -- (titleId: string)
	"SetSetting",           -- (key: string, value: any)
	"ClientReady",          -- ()
	"PlayEmote",            -- (emote: string)

	-- Serveur → Client
	"ProfileUpdated",       -- (profile: table)
	"Notify",               -- (text, colorHex?, icon?)
	"EffectBurst",          -- (position: Vector3, colorHex: string, amount: number)
	"EffectFly",            -- (from: Vector3, colorHex: string)
	"EventUpdate",          -- (eventId: string?, endsAt: number?, message: string?)
	"EggResult",            -- (rarity, petId, name, mult, eggId, isNew)
	"LeaderboardData",      -- (global: table, server: table)
	"PlaySound",            -- (soundKey: string, volume: number?)
	"CameraShake",          -- (intensity: number)
	"ScreenFlash",          -- (colorHex: string, duration: number?)
	"SetWorld",             -- (worldIndex: number)
	"Transformation",       -- (tier: number)
	"DailyAvailable",       -- (available: boolean)
	"BoostUpdate",          -- (mult: number, endsAt: number)
	"RebirthSuccess",       -- (rebirths: number, coins: number)
}

--- Client → Serveur avec réponse
Net.RemoteFunctions = {
	"GetProfile",           -- () -&gt; profile
	"GetLeaderboards",      -- () -&gt; global, server
	"GetServerInfo",        -- () -&gt; { players = n, eventId = ..., serverTime = ... }
}

local remotesFolder: Folder? = nil

local function getFolder(): Folder
	if remotesFolder and remotesFolder.Parent then
		return remotesFolder
	end
	if RunService:IsServer() then
		local existing = ReplicatedStorage:FindFirstChild(Net.FOLDER_NAME)
		if not existing then
			existing = Instance.new("Folder")
			existing.Name = Net.FOLDER_NAME
			existing.Parent = ReplicatedStorage
		end
		remotesFolder = existing :: Folder
		return remotesFolder
	end
	local existing = ReplicatedStorage:WaitForChild(Net.FOLDER_NAME, 30)
	assert(existing, "Dossier Remotes introuvable (le serveur doit appeler Net.init())")
	remotesFolder = existing :: Folder
	return remotesFolder
end

local function getSubFolder(name: string): Folder
	local folder = getFolder()
	local existing = folder:FindFirstChild(name)
	if existing then
		return existing :: Folder
	end
	local sub = Instance.new("Folder")
	sub.Name = name
	sub.Parent = folder
	return sub
end

--- Appelé UNIQUEMENT par le serveur, au démarrage.
function Net.init()
	local events = getSubFolder("Events")
	for _, name in ipairs(Net.RemoteEvents) do
		if not events:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = events
		end
	end
	local functions = getSubFolder("Functions")
	for _, name in ipairs(Net.RemoteFunctions) do
		if not functions:FindFirstChild(name) then
			local remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = functions
		end
	end
	return true
end

--- Récupère un RemoteEvent (attend côté client)
function Net.event(name: string): RemoteEvent
	local events = getSubFolder("Events")
	local remote = events:FindFirstChild(name)
	if not remote then
		if RunService:IsServer() then
			remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = events
		else
			remote = events:WaitForChild(name, 30)
		end
	end
	assert(remote, "RemoteEvent manquant : " .. name)
	return remote :: RemoteEvent
end

--- Récupère un RemoteFunction (attend côté client)
function Net.func(name: string): RemoteFunction
	local functions = getSubFolder("Functions")
	local remote = functions:FindFirstChild(name)
	if not remote then
		if RunService:IsServer() then
			remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = functions
		else
			remote = functions:WaitForChild(name, 30)
		end
	end
	assert(remote, "RemoteFunction manquante : " .. name)
	return remote :: RemoteFunction
end

--- Raccourci serveur : envoie un event à un joueur
function Net.fire(player: Player, name: string, ...)
	Net.event(name):FireClient(player, ...)
end

--- Raccourci serveur : envoie à tous les joueurs
function Net.fireAll(name: string, ...)
	Net.event(name):FireAllClients(...)
end

return Net
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item><Item class="ModuleScript" referent="RBX000D">
        <Properties>
          <string name="Name">ProfileTemplate</string>
          <ProtectedString name="Source">--!strict
--[[
	ProfileTemplate  |  ReplicatedStorage.Modules.ProfileTemplate
	------------------------------------------------------------------
	Structure EXACTE des données d'un joueur.
	Utilisé par le serveur (DataManager) et par le client (valeurs par
	défaut en attendant la sauvegarde).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameConfig = require(script.Parent.GameConfig)

local ProfileTemplate = {}

--- Retourne un profil neuf
function ProfileTemplate.new()
	return {
		version = GameConfig.DataVersion,
		created = os.time(),
		lastSeen = os.time(),
		playtime = 0,

		-- Progression -------------------------------------------------
		power = 0,          -- puissance ACTUELLE (reset au rebirth)
		bestPower = 0,      -- record de puissance (succès)
		totalPower = 0,     -- puissance cumulée à vie
		coins = 0,
		rebirths = 0,
		totalRebirths = 0,
		world = 1,          -- monde où le joueur se trouve
		maxWorld = 1,       -- monde le plus élevé débloqué

		-- Pets --------------------------------------------------------
		pets = {},          -- { { uid = string, id = string, level = number }, ... }
		equipped = {},      -- { uid, uid, ... }

		-- Améliorations ----------------------------------------------
		upgrades = {},      -- { PowerMult = 0, CoinMult = 0, ... }

		-- Succès ------------------------------------------------------
		achievements = {},  -- { achievementId = true }

		-- Statistiques (servent aux succès) --------------------------
		stats = {
			collected = 0,
			eggsOpened = 0,
			legendaryPets = 0,
			mythicalPets = 0,
			secretPets = 0,
			fusions = 0,
			vacuums = 0,
			dailies = 0,
			events = 0,
			playerKills = 0,
		},

		-- Récompense quotidienne --------------------------------------
		daily = {
			lastClaim = 0,
			streak = 0,
			dayIndex = 1,
		},

		-- Titres ------------------------------------------------------
		titles = { "noob" },
		titleSelected = "noob",

		-- Œufs gratuits déjà utilisés ---------------------------------
		freeEggsTaken = {},

		-- Boost temporaire (developer product / daily) ----------------
		boost = {
			mult = 1,
			endsAt = 0,
		},

		-- Paramètres --------------------------------------------------
		settings = {
			music = true,
			sfx = true,
			effects = true,
			particles = true,
			cameraShake = true,
			petsVisible = true,
			damageNumbers = true,
		},

		-- Rempli par MonetizationSystem (jamais sauvegardé) -----------
		gamePasses = {
			DoublePower = false,
			AutoCollect = false,
			ExtraPetSlots = false,
			VIP = false,
			Cosmetics = false,
		},

		-- Interne -----------------------------------------------------
		__saveBlocked = false,
	}
end

--- Réparation / migration d'un profil chargé depuis le DataStore.
--- Ne lève jamais d'erreur : renvoie toujours un profil valide.
function ProfileTemplate.migrate(saved)
	local profile = ProfileTemplate.new()
	if type(saved) ~= "table" then
		return profile
	end

	local numericFields = { "power", "bestPower", "totalPower", "coins", "rebirths", "totalRebirths", "playtime", "created", "lastSeen" }
	for _, field in ipairs(numericFields) do
		local value = saved[field]
		if type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge then
			profile[field] = math.max(0, value)
		end
	end

	local worldValue = saved.world
	if type(worldValue) == "number" then
		-- 0 = lobby, 1..#Worlds = mondes jouables
		profile.world = math.clamp(math.floor(worldValue), 0, #GameConfig.Worlds)
	end
	local maxWorldValue = saved.maxWorld
	if type(maxWorldValue) == "number" then
		profile.maxWorld = math.clamp(math.floor(maxWorldValue), 1, #GameConfig.Worlds)
	end

	-- Pets : validation stricte (anti-duplication / anti-corruption)
	if type(saved.pets) == "table" then
		local seenUids = {}
		local pets = {}
		for _, pet in ipairs(saved.pets) do
			if type(pet) == "table" and type(pet.uid) == "string" and type(pet.id) == "string" and GameConfig.Pets[pet.id] then
				if not seenUids[pet.uid] and #pets &lt; GameConfig.Misc.MaxPets then
					seenUids[pet.uid] = true
					table.insert(pets, {
						uid = pet.uid,
						id = pet.id,
						level = math.clamp(math.floor(tonumber(pet.level) or 1), 1, GameConfig.Misc.MaxPetLevel),
					})
				end
			end
		end
		profile.pets = pets
	end

	if type(saved.equipped) == "table" then
		local ownedUids = {}
		for _, pet in ipairs(profile.pets) do
			ownedUids[pet.uid] = true
		end
		local equipped = {}
		for _, uid in ipairs(saved.equipped) do
			if type(uid) == "string" and ownedUids[uid] and #equipped &lt; 12 then
				table.insert(equipped, uid)
			end
		end
		profile.equipped = equipped
	end

	if type(saved.upgrades) == "table" then
		for upgradeId, info in pairs(GameConfig.Upgrades) do
			local level = saved.upgrades[upgradeId]
			if type(level) == "number" then
				profile.upgrades[upgradeId] = math.clamp(math.floor(level), 0, info.MaxLevel)
			end
		end
	end

	if type(saved.achievements) == "table" then
		for achievementId in pairs(saved.achievements) do
			if GameConfig.Achievements[achievementId] then
				profile.achievements[achievementId] = true
			end
		end
	end

	if type(saved.stats) == "table" then
		for statName in pairs(profile.stats) do
			local value = saved.stats[statName]
			if type(value) == "number" and value == value then
				profile.stats[statName] = math.max(0, math.floor(value))
			end
		end
	end

	if type(saved.daily) == "table" then
		profile.daily.lastClaim = math.max(0, tonumber(saved.daily.lastClaim) or 0)
		profile.daily.streak = math.max(0, math.floor(tonumber(saved.daily.streak) or 0))
		profile.daily.dayIndex = math.clamp(math.floor(tonumber(saved.daily.dayIndex) or 1), 1, #GameConfig.DailyRewards)
	end

	if type(saved.titles) == "table" then
		local validTitles = {}
		for _, titleId in ipairs(saved.titles) do
			for _, title in ipairs(GameConfig.Titles) do
				if title.Id == titleId then
					table.insert(validTitles, titleId)
					break
				end
			end
		end
		if #validTitles &gt; 0 then
			profile.titles = validTitles
		end
	end

	if type(saved.titleSelected) == "string" then
		for _, title in ipairs(GameConfig.Titles) do
			if title.Id == saved.titleSelected then
				profile.titleSelected = saved.titleSelected
				break
			end
		end
	end

	if type(saved.freeEggsTaken) == "table" then
		for eggId, taken in pairs(saved.freeEggsTaken) do
			if GameConfig.Eggs[eggId] and taken == true then
				profile.freeEggsTaken[eggId] = true
			end
		end
	end

	if type(saved.boost) == "table" then
		local mult = tonumber(saved.boost.mult) or 1
		local endsAt = tonumber(saved.boost.endsAt) or 0
		if mult &gt; 1 and endsAt &gt; os.time() then
			profile.boost.mult = math.clamp(mult, 1, 10)
			profile.boost.endsAt = endsAt
		end
	end

	if type(saved.settings) == "table" then
		for key in pairs(profile.settings) do
			if type(saved.settings[key]) == "boolean" then
				profile.settings[key] = saved.settings[key]
			end
		end
	end

	profile.version = GameConfig.DataVersion
	return profile
end

--- Version "publique" : ce qui est envoyé au client (pas de champs internes)
function ProfileTemplate.toPublic(profile)
	local public = {
		version = profile.version,
		power = profile.power,
		bestPower = profile.bestPower,
		totalPower = profile.totalPower,
		coins = profile.coins,
		rebirths = profile.rebirths,
		totalRebirths = profile.totalRebirths,
		world = profile.world,
		maxWorld = profile.maxWorld,
		pets = profile.pets,
		equipped = profile.equipped,
		upgrades = profile.upgrades,
		achievements = profile.achievements,
		stats = profile.stats,
		daily = profile.daily,
		titles = profile.titles,
		titleSelected = profile.titleSelected,
		freeEggsTaken = profile.freeEggsTaken,
		boost = profile.boost,
		settings = profile.settings,
		gamePasses = profile.gamePasses,
		playtime = profile.playtime,
	}
	return public
end

return ProfileTemplate
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item><Item class="ModuleScript" referent="RBX000E">
        <Properties>
          <string name="Name">Signal</string>
          <ProtectedString name="Source">--!strict
--[[
	Signal  |  ReplicatedStorage.Modules.Signal
	------------------------------------------------------------------
	Implémentation légère de signaux (comme GoodSignal) pour découpler
	les systèmes serveur sans dépendances externes.
]]

local Signal = {}
Signal.__index = Signal

local Connection = {}
Connection.__index = Connection

function Connection.new(signal, callback)
	return setmetatable({ _signal = signal, _callback = callback, Connected = true }, Connection)
end

function Connection:Disconnect()
	if not self.Connected then
		return
	end
	self.Connected = false
	local signal = self._signal
	if signal then
		for index, connection in ipairs(signal._listeners) do
			if connection == self then
				table.remove(signal._listeners, index)
				break
			end
		end
	end
	self._callback = nil
	self._signal = nil
end

function Signal.new()
	return setmetatable({ _listeners = {}, _yielding = {} }, Signal)
end

function Signal:Connect(callback)
	assert(type(callback) == "function", "Signal:Connect attend une fonction")
	local connection = Connection.new(self, callback)
	table.insert(self._listeners, connection)
	return connection
end

function Signal:Once(callback)
	local connection
	connection = self:Connect(function(...)
		connection:Disconnect()
		callback(...)
	end)
	return connection
end

function Signal:Fire(...)
	for _, connection in ipairs(self._listeners) do
		if connection.Connected then
			local ok, err = pcall(connection._callback, ...)
			if not ok then
				warn("[Signal] erreur dans un listener : " .. tostring(err))
			end
		end
	end
end

function Signal:DisconnectAll()
	for _, connection in ipairs(self._listeners) do
		connection.Connected = false
	end
	table.clear(self._listeners)
end

function Signal:Destroy()
	self:DisconnectAll()
	self._listeners = {}
end

return Signal
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item><Item class="ModuleScript" referent="RBX000F">
        <Properties>
          <string name="Name">Util</string>
          <ProtectedString name="Source">--!strict
--[[
	Util  |  ReplicatedStorage.Modules.Util
	------------------------------------------------------------------
	Petites fonctions utilitaires partagées.
]]

local Util = {}

--- Copie profonde (tables uniquement)
function Util.deepCopy(source)
	if type(source) ~= "table" then
		return source
	end
	local copy = {}
	for key, value in pairs(source) do
		if type(value) == "table" then
			copy[key] = Util.deepCopy(value)
		else
			copy[key] = value
		end
	end
	return copy
end

--- Fusionne `overrides` dans `base` de façon récursive (base est modifié)
function Util.deepMerge(base, overrides)
	for key, value in pairs(overrides) do
		if type(value) == "table" and type(base[key]) == "table" then
			Util.deepMerge(base[key], value)
		else
			base[key] = Util.deepCopy(value)
		end
	end
	return base
end

function Util.count(tbl): number
	local total = 0
	for _ in pairs(tbl) do
		total = total + 1
	end
	return total
end

function Util.sumKeys(tbl): number
	local total = 0
	for key, value in pairs(tbl) do
		if type(key) == "number" then
			total = total + value
		end
	end
	return total
end

--- Choisit une clé au hasard selon des poids { A = 5, B = 1 }
function Util.weightedChoice(weights, randomObject)
	local rng = randomObject or Random.new()
	local total = 0
	for _, weight in pairs(weights) do
		total = total + weight
	end
	if total &lt;= 0 then
		return nil
	end
	local roll = rng:NextNumber() * total
	local accumulator = 0
	for key, weight in pairs(weights) do
		accumulator = accumulator + weight
		if roll &lt;= accumulator then
			return key
		end
	end
	return nil
end

function Util.pickRandom(list, randomObject)
	local rng = randomObject or Random.new()
	if #list == 0 then
		return nil
	end
	return list[rng:NextInteger(1, #list)]
end

--- Retourne une version "safe" d'une chaîne pour un nom d'instance
function Util.sanitizeName(text: string): string
	return (string.gsub(text, "[^%w_%-]", "_"))
end

--- Arrondi "propre" pour l'affichage (jamais de décimale inutile)
function Util.round(value: number, decimals: number?): number
	local mult = 10 ^ (decimals or 0)
	return math.floor(value * mult + 0.5) / mult
end

--- Sérialise rapidement pour le debug
function Util.debugTable(tbl, depth: number?): string
	local d = depth or 0
	local indent = string.rep("  ", d)
	local out = {}
	for key, value in pairs(tbl) do
		if type(value) == "table" then
			table.insert(out, indent .. tostring(key) .. " = " .. Util.debugTable(value, d + 1))
		else
			table.insert(out, indent .. tostring(key) .. " = " .. tostring(value))
		end
	end
	return "{\n" .. table.concat(out, ",\n") .. "\n" .. string.rep("  ", math.max(0, d - 1)) .. "}"
end

--- Vérifie qu'une valeur est un nombre fini et positif (anti-exploit)
function Util.isValidNumber(value: any, allowZero: boolean?): boolean
	if type(value) ~= "number" then
		return false
	end
	if value ~= value or value == math.huge or value == -math.huge then
		return false
	end
	if allowZero then
		return value &gt;= 0
	end
	return value &gt; 0
end

--- Lerp pour Color3
function Util.lerpColor(a: Color3, b: Color3, alpha: number): Color3
	return a:Lerp(b, math.clamp(alpha, 0, 1))
end

--- Retire les éléments d'un tableau qui ne passent pas le filtre
function Util.filter(list, predicate)
	local out = {}
	for _, value in ipairs(list) do
		if predicate(value) then
			table.insert(out, value)
		end
	end
	return out
end

function Util.map(list, mapper)
	local out = {}
	for index, value in ipairs(list) do
		out[index] = mapper(value, index)
	end
	return out
end

function Util.indexOf(list, value): number
	for index, item in ipairs(list) do
		if item == value then
			return index
		end
	end
	return -1
end

function Util.removeValue(list, value): boolean
	local index = Util.indexOf(list, value)
	if index &gt; 0 then
		table.remove(list, index)
		return true
	end
	return false
end

--- Encodage base36 pour des uid de pets compacts
local BASE36 = "0123456789abcdefghijklmnopqrstuvwxyz"
function Util.base36(numberValue: number): string
	local n = math.floor(math.abs(numberValue))
	if n == 0 then
		return "0"
	end
	local out = ""
	while n &gt; 0 do
		local digit = n % 36
		out = string.sub(BASE36, digit + 1, digit + 1) .. out
		n = math.floor(n / 36)
	end
	return out
end

--- Génère un identifiant unique de pet
function Util.generateUid(randomObject: Random?): string
	local rng = randomObject or Random.new()
	return string.format("%s%s%s", Util.base36(os.time()), Util.base36(rng:NextInteger(0, 1679615)), Util.base36(rng:NextInteger(0, 1679615)))
end

return Util
</ProtectedString>
